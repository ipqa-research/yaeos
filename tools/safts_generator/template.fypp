#:mute
#:include "code/attributes.fypp"
!    - attributes(ATTRIBUTES)
!    - attributes_in_helmholtz(ATTRIBUTES)
!    - setup_signature(ATTRIBUTES)
!    - setup_body(ATTRIBUTES)
#:include "code/diameter.fypp"
!    - diameter_declaration(DIAMETER)
!    - diameter(DIAMETER)
#:include "code/zetas.fypp"
!    - zetas_declaration(ZETAS)
!    - zetas(ZETAS)
#:include "code/ar_hard_sphere.fypp"
!    - ar_hard_sphere_declaration(AR_HARD_SPHERE)
!    - ar_hard_sphere(AR_HARD_SPHERE)
#:include "code/ar_chain.fypp"
!    - ar_chain_declaration(AR_CHAIN)
!    - ar_chain(AR_CHAIN)
#:include "code/ar_dispersion.fypp"
!    - ar_dispersion_declaration(AR_DISPERSION)
!    - ar_dispersion(AR_DISPERSION)
#:endmute
module yaeos__models_ar_saft_modelnamesedme
   use yaeos__tapenade_ar_api, only: ArModelTapenade
   use yaeos__tapenade_interfaces
   use yaeos, only: R
   implicit none

   ! ---------------------------------------------------------------------------
   ! PC-SAFT UNIVERSAL CONSTANTS (Gross & Sadowski, 2001, Table A1)
   ! ---------------------------------------------------------------------------
   real(8), dimension(0:2, 0:6) :: A_COEFFS = reshape([ &
       0.9105631445_pr, -0.3084016918_pr, -0.0906148351_pr, &
       0.6361281449_pr,  0.1860531159_pr,  0.4527842806_pr, &
       2.6861347891_pr, -2.5030047259_pr,  0.5962700728_pr, &
      -26.547362491_pr,  21.419793629_pr, -1.7241829131_pr, &
       97.759208784_pr, -65.255885330_pr, -4.1302112531_pr, &
      -159.59154087_pr,  83.318680481_pr,  13.776631870_pr, &
       91.297774084_pr, -33.746922930_pr, -8.6728470368_pr], [3, 7])

   real(8), dimension(0:2, 0:6) :: B_COEFFS = reshape([ &
       0.7240946941_pr, -0.5755498075_pr,  0.0976883116_pr, &
       2.2382791861_pr,  0.6995095521_pr, -0.2557574982_pr, &
      -4.0025849485_pr,  3.8925673390_pr, -9.1558561530_pr, &
      -21.003576815_pr, -17.215471648_pr,  20.642075974_pr, &
       26.855641363_pr,  192.67226447_pr, -38.804430052_pr, &
       206.55133841_pr, -161.82646165_pr,  93.626774077_pr, &
      -355.60235612_pr, -165.20769346_pr, -29.666905585_pr], [3, 7])

   type :: ModelNameSedMe
      $:attributes(ATTRIBUTES)
   end type ModelNameSedMe

   ! Module private constants
   real(8), parameter :: PI = 3.14159265359_8
   real(8), parameter :: N_AVO = 6.02214076e23_8

   ! Conversion factor:
   ! Zeta must be dimensionless. V comes in Liters. Sigma in Angstroms.
   ! 1 L = 10^27 A^3. rho_num [1/A^3] = (n [mol] * N_AVO) / (V [L] * 10^27)
   real(8), parameter :: UNITS_FACTOR = 0.000602214086_8

contains
   subroutine ar(model, n, v, t, arval)
      type(ModelNameSedMe), intent(in) :: model
      real(8), intent(in) :: n(:), v, t
      real(8), intent(out) :: arval

      ! Auxiliars
      integer :: i, j, k
      real(8) :: x(size(n)) ! Mole fractions
      real(8) :: n_tot ! Total moles
      integer :: nc ! Number of components
      real(8) :: m_ave ! Average number of segments

      ! Internal variables declarations
      ! Diameter declarations
      $:diameter_declaration(DIAMETER)
      ! Zetas declarations
      $:zetas_declaration(ZETAS)
      ! Ar hard-sphere contribution declarations
      $:ar_hard_sphere_declaration(AR_HARD_SPHERE)
      ! Ar chain contribution declarations
      $:ar_chain_declaration(AR_CHAIN)
      ! Ar dispersion contribution declarations
      $:ar_dispersion_declaration(AR_DISPERSION)
      ! Attributes declarations as variables
      $:attributes_in_helmholtz(ATTRIBUTES)

      ! Residual Helmholtz free energy calculation
      x = n / sum(n)  ! Mole fractions
      n_tot = sum(n)  ! Total moles
      nc = size(n)    ! Number of components

      m_ave = 0.0_8
      do i = 1, nc
         m_ave = m_ave + x(i)*m(i) ! Segment average
      end do

      ! Diameter calculation
      $:diameter(DIAMETER)
      
      ! Zetas calculation
      $:zetas(ZETAS)

      ! Ar hard-sphere contribution
      $:ar_hard_sphere(AR_HARD_SPHERE)

      ! Ar chain contribution
      $:ar_chain(AR_CHAIN)

      ! Ar dispersion contribution
      $:ar_dispersion(AR_DISPERSION)

      ! Final evaluation
      arval = (R * T * n_tot) * (m_ave * ar_hs + ar_chain + ar_dispersion)
   end subroutine ar

   ! PUT setup and get_v0 here after tapenade
end module yaeos__models_ar_saft_modelnamesedme
