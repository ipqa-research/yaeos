atives. Read more… Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: ac Pure-component critical attractive parameter. real(kind=pr), intent(in) :: Tc Pure-component critical temperature [K]. real(kind=pr), intent(in) :: k Alpha-function parameter. real(kind=pr), intent(in) :: T Temperature [K]. real(kind=pr), intent(out) :: a Attractive parameter at the state. real(kind=pr), intent(out) :: dadT First temperature derivative of the attractive parameter. real(kind=pr), intent(out) :: dadT2 Second temperature derivative of the attractive parameter. public  subroutine aijTder (ntd, nc, T, aij, daijdT, daijdT2) Build pair attractive parameters and their temperature derivatives. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: ntd Flag selecting temperature-dependent derivative calculations. integer, intent(in) :: nc Number of active components. real(kind=pr), intent(in) :: T Temperature [K]. real(kind=pr), intent(out) :: aij (nc,nc) Pair attractive-parameter matrix. real(kind=pr), intent(out) :: daijdT (nc,nc) Temperature derivative of the pair attractive parameters. real(kind=pr), intent(out) :: daijdT2 (nc,nc) Second temperature derivative of the pair attractive parameters. public  subroutine ar_rkpr (z, v, t, ar, arv, artv, arv2, Arn, ArVn, ArTn, Arn2) Evaluate residual Helmholtz derivatives for the legacy RKPR model. Read more… Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: z (:) Number of moles real(kind=pr), intent(in) :: v Volume [L] real(kind=pr), intent(in) :: t Temperature [K] real(kind=pr), intent(out) :: ar Residual Helmholtz real(kind=pr), intent(out) :: arv dAr/dV real(kind=pr), intent(out) :: artv dAr2/dTV real(kind=pr), intent(out) :: arv2 dAr2/dV2 real(kind=pr), intent(out) :: Arn (size(z)) dAr/dn real(kind=pr), intent(out) :: ArVn (size(z)) dAr2/dVn real(kind=pr), intent(out) :: ArTn (size(z)) dAr2/dTn real(kind=pr), intent(out) :: Arn2 (size(z),size(z)) dAr2/dn2 public  subroutine ar_srkpr (z, v, t, ar, arv, artv, arv2, Arn, ArVn, ArTn, Arn2) Wrapper subroutine to the SRK/PR Residula Helmholtz function to\nuse the general interface Read more… Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: z (:) Number of moles real(kind=pr), intent(in) :: v Volume [L] real(kind=pr), intent(in) :: t Temperature [K] real(kind=pr), intent(out) :: ar Residual Helmholtz real(kind=pr), intent(out) :: arv dAr/dV real(kind=pr), intent(out) :: artv dAr2/dTV real(kind=pr), intent(out) :: arv2 dAr2/dV2 real(kind=pr), intent(out) :: Arn (size(z)) dAr/dn real(kind=pr), intent(out) :: ArVn (size(z)) dAr2/dVn real(kind=pr), intent(out) :: ArTn (size(z)) dAr2/dTn real(kind=pr), intent(out) :: Arn2 (size(z),size(z)) dAr2/dn2 public  subroutine get_Zc_OMa_OMb (del1, Zc, OMa, OMb) Calculate Zc, OMa and OMb from the delta_1 parameter. Read more… Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: del1 (:) delta_1 parameter real(kind=pr), intent(out) :: Zc (:) Critical compressibility factor real(kind=pr), intent(out) :: OMa (:) OMa real(kind=pr), intent(out) :: OMb (:) OMb public  subroutine setup (n, nmodel, ntdep, ncomb) Initialize the global configuration and allocate legacy model arrays. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: n Number of components integer, intent(in) :: nmodel Number of model integer, intent(in) :: ntdep Kij dependant of temperature integer, intent(in) :: ncomb Combining rule","tags":"","url":"module/legacy_ar_models.html"},{"title":"legacy_thermo_properties – yaeos","text":"Uses yaeos__constants legacy_ar_models module~~legacy_thermo_properties~~UsesGraph module~legacy_thermo_properties legacy_thermo_properties module~legacy_ar_models legacy_ar_models module~legacy_thermo_properties->module~legacy_ar_models module~yaeos__constants yaeos__constants module~legacy_thermo_properties->module~yaeos__constants module~legacy_ar_models->module~yaeos__constants module~ar_interface ar_interface module~legacy_ar_models->module~ar_interface iso_fortran_env iso_fortran_env module~yaeos__constants->iso_fortran_env module~ar_interface->module~yaeos__constants module~ar_interface->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Subroutines public  subroutine PUREFUG_CALC (nc, icomp, T, P, V, phi) Calculate pure-component fugacity data for a selected legacy component. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: nc Number of active components. integer, intent(in) :: icomp One-based component index. real(kind=pr), intent(in) :: T Temperature [K]. real(kind=pr), intent(in) :: P Pressure [bar]. real(kind=pr), intent(in) :: V Total volume [L]. real(kind=pr), intent(out) :: phi Pure-component fugacity coefficient. public  subroutine TERMO (nc, mtyp, indic, t, p, rn, v, PHILOG, DLPHIP, DLPHIT, FUGN) Evaluate legacy fugacity and pressure-derivative properties. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: nc Number of components integer, intent(in) :: mtyp Type of root desired (-1 vapor, 1 liquid, 0 lower Gr) integer, intent(in) :: indic Desired element, this should be setted with optionals real(kind=pr), intent(in) :: t Temperature [K] real(kind=pr), intent(in) :: p Pressure [bar] real(kind=pr), intent(in) :: rn (nc) Mixture mole numbers real(kind=pr), intent(out) :: v Volume [L] real(kind=pr), intent(out) :: PHILOG (nc) ln(phi*p) vector real(kind=pr), intent(out), optional :: DLPHIP (nc) ln(phi) Pressure derivative real(kind=pr), intent(out), optional :: DLPHIT (nc) ln(phi) Temp derivative real(kind=pr), intent(out), optional :: FUGN (nc,nc) ln(phi) compositional derivative public recursive subroutine VCALC (ITYP, nc, ntemp, rn, T, P, V) ROUTINE FOR CALCULATION OF VOLUME, GIVEN PRESSURE Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: ITYP TYPE OF ROOT DESIRED (-1 vapor, 1 liquid, 0 lower Gibbs energy phase) integer, intent(in) :: nc NO. OF COMPONENTS integer, intent(in) :: ntemp 1 if T-derivatives are required real(kind=pr), intent(in) :: rn (nc) FEED MOELS real(kind=pr), intent(in) :: T TEMPERATURE real(kind=pr), intent(in) :: P PRESURE real(kind=pr), intent(out) :: V VOLUME public  subroutine zTVTERMO (nc, indic, t, rn, v, p, dpv, PHILOG, DLPHIP, DLPHIT, FUGN) Evaluate legacy thermodynamic properties at fixed composition, temperature, and volume. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: nc Number of active components. integer, intent(in) :: indic Selects the requested outputs (see the INDIC table above). real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(in) :: rn (nc) Component mole amounts used in mixture rules. real(kind=pr), intent(in) :: v Total volume [L]. real(kind=pr), intent(out) :: p Pressure [bar]. real(kind=pr), intent(out) :: dpv Pressure derivative with respect to volume. real(kind=pr), intent(out) :: PHILOG (nc) vector. real(kind=pr), intent(out) :: DLPHIP (nc) Pressure derivatives of logarithmic fugacity coefficients. real(kind=pr), intent(out) :: DLPHIT (nc) Temperature derivatives of logarithmic fugacity coefficients. real(kind=pr), intent(out) :: FUGN (nc,nc) Composition derivatives of at constant .","tags":"","url":"module/legacy_thermo_properties.html"},{"title":"yaeos__tapenade_ge_api – yaeos","text":"Tapenade excess-Gibbs API Abstract interface and adapter for source-to-source differentiated GE models. Description GeModelTapenade adapts generated primal and derivative routines to the GeModel excess-Gibbs and activity-coefficient methods. Concrete models\nimplement the deferred procedures declared in this module. Examples Extend GeModelTapenade and call the inherited GE property methods on\nthe resulting model. References Tapenade documentation: https://tapenade.gitlabpages.inria.fr/ Uses yaeos__constants yaeos__models_ge module~~yaeos__tapenade_ge_api~~UsesGraph module~yaeos__tapenade_ge_api yaeos__tapenade_ge_api module~yaeos__constants yaeos__constants module~yaeos__tapenade_ge_api->module~yaeos__constants module~yaeos__models_ge yaeos__models_ge module~yaeos__tapenade_ge_api->module~yaeos__models_ge iso_fortran_env iso_fortran_env module~yaeos__constants->iso_fortran_env module~yaeos__models_ge->module~yaeos__constants module~yaeos__models_base yaeos__models_base module~yaeos__models_ge->module~yaeos__models_base module~yaeos__substance yaeos__substance module~yaeos__models_base->module~yaeos__substance module~yaeos__substance->module~yaeos__constants Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Abstract Interfaces abstract interface private  subroutine tapenade_ge(model, n, t, ge) tapenade_ge Primal excess-Gibbs callback required by GeModelTapenade . Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(out) :: ge Excess Gibbs energy. abstract interface private  subroutine tapenade_ge_b(model, n, nb, t, tb, ge, geb) tapenade_ge_b Reverse-mode adjoint callback for excess Gibbs energy. Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr) :: nb (:) Adjoint value for component mole amounts. real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr) :: tb Adjoint value for temperature. real(kind=pr) :: ge Primal excess Gibbs energy. real(kind=pr) :: geb Incoming adjoint seed on the excess Gibbs output. abstract interface private  subroutine tapenade_ge_d(model, n, nd, t, td, ge, ged) tapenade_ge_d Forward directional derivative callback for excess Gibbs energy. Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr), intent(in) :: nd (:) Tangent seed for component mole amounts (nd). real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(in) :: td Tangent seed for temperature (td). real(kind=pr), intent(out) :: ge Primal excess Gibbs energy. real(kind=pr), intent(out) :: ged Forward directional derivative of excess Gibbs energy. abstract interface private  subroutine tapenade_ge_d_b(model, n, nb, nd, ndb, t, tb, td, tdb, ge, geb, ged, gedb) tapenade_ge_d_b Mixed forward/reverse derivative callback for GE Hessian components. Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr) :: nb (:) Adjoint value for component mole amounts. real(kind=pr), intent(in) :: nd (:) Tangent seed for component mole amounts (nd). real(kind=pr) :: ndb (:) Mixed tangent-adjoint value for component mole amounts. real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr) :: tb Adjoint value for temperature. real(kind=pr), intent(in) :: td Tangent seed for temperature (td). real(kind=pr) :: tdb Mixed tangent-adjoint value for temperature. real(kind=pr) :: ge real(kind=pr) :: geb Adjoint seed for the primal output. real(kind=pr) :: ged Forward directional energy derivative. real(kind=pr) :: gedb Mixed tangent-adjoint output for GE. abstract interface private  subroutine tapenade_ge_d_d(model, n, nd, t, td0, td, ge, ged0, ged, gedd) tapenade_ge_d_d Nested forward-mode callback for second directional GE derivatives. Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr), intent(in) :: nd (:) Tangent seed for component mole amounts (nd). real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(in) :: td0 First temperature tangent seed. real(kind=pr), intent(in) :: td Tangent seed for temperature (td). real(kind=pr), intent(out) :: ge Primal excess Gibbs energy. real(kind=pr), intent(out) :: ged0 First nested tangent of excess Gibbs energy. real(kind=pr), intent(out) :: ged Forward directional derivative of excess Gibbs energy. real(kind=pr), intent(out) :: gedd Mixed second tangent of excess Gibbs energy. Derived Types type, public, abstract, extends( GeModel ) :: GeModelTapenade Base class for excess-Gibbs models with Tapenade-generated derivatives. Read more… Components Type Visibility Attributes Name Initial type( Substances ), public :: components Pure-component properties for the model’s component order. Type-Bound Procedures procedure, public :: excess_Cp procedure, public :: excess_enthalpy procedure, public :: excess_entropy procedure, public :: excess_gibbs procedure( tapenade_ge ), public, deferred :: ge procedure( tapenade_ge_b ), public, deferred :: ge_b procedure( tapenade_ge_d ), public, deferred :: ge_d procedure( tapenade_ge_d_b ), public, deferred :: ge_d_b procedure( tapenade_ge_d_d ), public, deferred :: ge_d_d procedure, public :: ln_activity_coefficient Subroutines private  subroutine excess_gibbs (self, n, t, Ge, GeT, GeT2, Gen, GeTn, Gen2) Excess Gibbs model generic interface Arguments Type Intent Optional Attributes Name class( GeModelTapenade ), intent(in) :: self Model instance. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(out), optional :: Ge Excess Gibbs energy [bar L]. real(kind=pr), intent(out), optional :: GeT [bar L/K]. real(kind=pr), intent(out), optional :: GeT2 [bar L/K&#94;2]. real(kind=pr), intent(out), optional, dimension(size(n)) :: Gen [bar L/mol]. real(kind=pr), intent(out), optional, dimension(size(n)) :: GeTn [bar L/(K mol)]. real(kind=pr), intent(out), optional :: Gen2 (size(n),size(n)) [bar L/mol&#94;2].","tags":"","url":"module/yaeos__tapenade_ge_api.html"},{"title":"yaeos__newton_solver – yaeos","text":"# Safeguarded Newton solver\n Solve nonlinear systems with Newton steps, LM regularization, and line search. # Description\n The module exposes the newton solver, configurable settings, result\n diagnostics, and status codes. It begins with Newton steps, activates\n Levenberg-Marquardt regularization for poorly conditioned Jacobians, and\n uses Armijo backtracking to globalize accepted steps. User systems are\n supplied through a residual/Jacobian callback. # Algorithm\n   Pure Newton with Levenberg-Marquardt (LM) regularization and\n   Armijo backtracking line search used as a globalization strategy.\n   The solver starts as pure Newton (lambda = 0) and promotes to LM\n   whenever the Jacobian is detected to be singular or ill-conditioned,\n   or when the line search cannot find a sufficient decrease. ## Examples\n ### Minimal call: call newton ( my_sub , x ) ### Full call: type ( newton_settings ) :: s type ( newton_result ) :: r s % atol = 1.0e-10_pr s % verbosity = 2 call newton ( my_sub , x , s , r ) if ( r % status /= NEWTON_SUCCESS ) write ( * , * ) newton_status_msg ( r % status ) # References\n Uses LAPACK dense LU factorization, solve, and condition-estimation\n routines. LM regularization and Armijo backtracking are standard\n nonlinear-solver methods. Uses iso_fortran_env module~~yaeos__newton_solver~~UsesGraph module~yaeos__newton_solver yaeos__newton_solver iso_fortran_env iso_fortran_env module~yaeos__newton_solver->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial integer, public, parameter :: NEWTON_LINE_SEARCH_FAIL = 5 Repeated line-search failures drove the LM to its ceiling. integer, public, parameter :: NEWTON_MAX_ITS = 1 Reached the Newton iteration limit. integer, public, parameter :: NEWTON_NAN_INF = 2 Non-finite residual at the initial point. integer, public, parameter :: NEWTON_SINGULAR = 3 The LM system stayed singular with lambda at its ceiling. integer, public, parameter :: NEWTON_STAGNATION = 4 Iteration stopped making measurable progress. integer, public, parameter :: NEWTON_SUCCESS = 0 Converged by the residual or step criterion. Abstract Interfaces abstract interface private  subroutine to_solve(X, F, J) to_solve Description User callback that evaluates a square nonlinear system and Jacobian. Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: X (:) Current iterate real(kind=pr), intent(out) :: F (:) Residual vector F(X) real(kind=pr), intent(out) :: J (:,:) Jacobian dF_i/dX_j Derived Types type, public :: newton_result Diagnostics produced by one nonlinear solve. Read more… Components Type Visibility Attributes Name Initial real(kind=pr), public :: cond_est = 0.0_pr Estimated condition number of J (or J&#94;T J + lambda I when LM active)\nat the final iteration, via LAPACK dgecon. Dimensionless. real(kind=pr), public :: dx_norm = 0.0_pr ||dX||_inf of the last computed Newton step at exit.\nUnits: same as x. real(kind=pr), public, allocatable :: f_history (:) ||F||_inf at iterations 0, 1, …, result%iterations.\nAllocated only when settings%save_history = .true.\nSize: (iterations + 1). real(kind=pr), public :: f_norm = 0.0_pr ||F(x)||_inf at exit. Should be < atol on NEWTON_SUCCESS.\nUnits: same as F. integer, public :: iterations = 0 Total number of Newton iterations performed (accepted + rejected). real(kind=pr), public :: lambda = 0.0_pr Value of the LM regularisation parameter at exit.\n0.0 means the final solve was a pure Newton step.\nUnits: [J]&#94;2. integer, public :: status = 0 Exit status code. Compare with NEWTON_SUCCESS, NEWTON_MAX_ITS, etc.\nUse newton_status_msg(status) for a human-readable string. type, public :: newton_settings Solver controls for convergence, damping, backtracking, and diagnostics. Read more… Components Type Visibility Attributes Name Initial real(kind=pr), public :: armijo_c = 1.0e-4_pr Sufficient decrease constant (Wolfe c1 condition).\nSmaller values accept more steps but give weaker convergence guarantees.\nMust satisfy 0 < armijo_c < 0.5. Dimensionless. Default: 1e-4. integer, public :: armijo_max_its = 50 Maximum number of backtracking halvings per Newton step.\nIf reached without satisfying Armijo, ls_failed is set .true.\nDefault: 50. real(kind=pr), public :: armijo_tau = 0.5_pr Step-length reduction factor applied each backtracking iteration.\nt_new = armijo_tau * t_old  until Armijo or t < t_min.\nMust satisfy 0 < armijo_tau < 1. Dimensionless. Default: 0.5. real(kind=pr), public :: atol = 1.0e-9_pr Absolute residual tolerance.\nConverged when  max_i |F_i(x)| < atol.\nUnits: same as F. Default: 1e-9. real(kind=pr), public :: cond_max = 1.0e10_pr Condition number threshold above which LM regularization is activated\n(or strengthened) to stabilise the linear solve.\nEstimated via LAPACK dgecon. Dimensionless. Default: 1e10. real(kind=pr), public :: lambda0 = 0.0_pr Initial value of the LM damping parameter.\n0.0 = start as pure Newton; the solver activates LM automatically\nif conditioning is poor. Set > 0 to force LM from the first iteration.\nUnits: [J]&#94;2 (scales with the Jacobian entries squared). Default: 0. real(kind=pr), public :: lambda_down = 5.0_pr Factor by which lambda is divided after a successful step with t > 0.1.\nDrives the solver back toward pure Newton as the iterate improves.\nDimensionless. Default: 5. real(kind=pr), public :: lambda_max = 1.0e8_pr Maximum lambda, expressed as a multiplier of jacobian_scale.\nIf lambda exceeds this ceiling the solver returns NEWTON_LINE_SEARCH_FAIL.\nDimensionless multiplier. Default: 1e8. real(kind=pr), public :: lambda_min = 1.0e-6_pr Minimum non-zero lambda, expressed as a multiplier of jacobian_scale.\nEffective floor = lambda_min * ||J||_F&#94;2/n.\nPrevents lambda from decaying to numerical zero after a good step.\nDimensionless multiplier. Default: 1e-6. real(kind=pr), public :: lambda_up = 10.0_pr Factor by which lambda is multiplied on a line-search failure.\nLarger values recover faster from bad Jacobians but may overshoot.\nDimensionless. Default: 10. integer, public :: max_its = 100 Maximum number of Newton iterations before returning NEWTON_MAX_ITS.\nDefault: 100. real(kind=pr), public :: rtol = 1.0e-9_pr Relative step tolerance.\nConverged when  max_i |dX_i| < rtol * (max_i |x_i| + atol).\nCatches the case where the step becomes negligible compared to x.\nDimensionless. Default: 1e-9. logical, public :: save_history = .false. If .true., allocate result%f_history(0:iterations) and store\n||F||_inf at each iteration. Slightly increases memory use.\nDefault: .false. integer, public :: stagnation_nits = 5 Number of consecutive iterations with negligible change in ||dX||\nbefore the solver exits with NEWTON_STAGNATION.\nDefault: 5. real(kind=pr), public :: stagnation_tol = 1.0e-12_pr Relative threshold for stagnation: iteration is counted as stagnant\nwhen  |||dX||_prev - ||dX||_curr| < stagnation_tol * (||dX|| + 1).\nDimensionless. Default: 1e-12. real(kind=pr), public :: t_min = 1.0e-8_pr Minimum accepted step length.\nIf t < t_min the line search declares failure instead of accepting a\nmicro-step that satisfies Armijo trivially (m changes by ~machine eps).\nDimensionless (fraction of the full Newton step). Default: 1e-8. integer, public :: verbosity = 0 Controls stdout output.\n  0 – silent\n  1 – print header + one-line summary at exit\n  2 – also print one line per accepted iteration\nDefault: 0. Functions public  function newton_status_msg (status) result(msg) Convert a NEWTON_* status constant into a human-readable message. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: status One of the NEWTON_* constants Return Value character(len=48) Human-readable description private pure function has_nan_inf (v) Return true if any vector entry is NaN or infinite. Read more… Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: v (:) Vector to check Return Value logical private pure function jacobian_scale (J) Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: J (:,:) Jacobian matrix, shape (n,n) Return Value real(kind=pr) private pure function mat1norm (A) Return the matrix 1-norm (maximum absolute column sum). Read more… Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: A (:,:) Input matrix, shape (m,n) Return Value real(kind=pr) private pure function norm_inf (v) Return the vector infinity norm, . Read more… Arguments Type Intent Optional Attributes Name real(kind=pr), intent(in) :: v (:) Input vector, any length Return Value real(kind=pr) Subroutines public  subroutine newton (sub, x, settings, result) Find a root of a dense nonlinear system. Read more… Arguments Type Intent Optional Attributes Name procedure( to_solve ) :: sub User-supplied residual/Jacobian routine (matches to_solve interface) real(kind=pr), intent(inout) :: x (:) [in]  Initial guess, length n type( newton_settings ), intent(in), optional :: settings Solver configuration; defaults are used for any absent field