! Value returned when `val` is absent. if ( present ( val )) then optval_logical = val else optval_logical = default end if end function optval_logical real ( pr ) function optval_real ( val , default ) !! # optval_real !! Return the optional real value or its fallback. !! !! # Description !! Selects `val` when present and otherwise returns `default`. real ( pr ), optional , intent ( in ) :: val !! Optional real value. real ( pr ), intent ( in ) :: default !! Value returned when `val` is absent. if ( present ( val )) then optval_real = val else optval_real = default end if end function optval_real function optval_character ( val , default ) !! # optval_character !! Return the optional character value or its fallback. !! !! # Description !! Selects `val` when present and otherwise returns `default`; the result !! is allocated to the selected string length. character ( len =* ), optional , intent ( in ) :: val !! Optional character value. character ( len =* ), intent ( in ) :: default !! Value returned when `val` is absent. character ( len = :), allocatable :: optval_character if ( present ( val )) then optval_character = val else optval_character = default end if end function optval_character subroutine sort ( array , idx ) !! # sort !! Sort a real array in ascending order in place. !! !! # Description !! Delegates the sorting operation to `stdlib_sorting`. The optional `idx` !! argument is present in the interface but is not currently populated. !! !! # Examples !! ```fortran !! call sort(values) !! ``` use stdlib_sorting , only : std => sort real ( pr ), intent ( in out ) :: array (:) !! Values to sort; overwritten in ascending order. integer , optional , intent ( out ) :: idx (:) !! Reserved optional index output; currently unchanged. call std ( array ) end subroutine sort end module yaeos__auxiliar","tags":"","url":"sourcefile/auxiliar.f90~2.html"},{"title":"math.f90 – yaeos","text":"This file depends on sourcefile~~math.f90~~EfferentGraph sourcefile~math.f90 mat