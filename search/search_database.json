: w (:) Acentric factor","tags":"","url":"type/substances.html"},{"title":"KindEnum – yaeos ","text":"type, public :: KindEnum KindEnum Named root selectors used by EOS volume calculations. Description The integer fields identify the stable, liquid, and vapor roots for\nroutines accepting a root_type selector. Examples call model % lnphi_pt ( n , P , T , root_type = \"liquid\" , lnPhi = lnphi ) Components Type Visibility Attributes Name Initial integer, public :: liquid = 1 Select the liquid volume root. integer, public :: stable = 0 Select the thermodynamically stable volume root. integer, public :: vapor = 2 Select the vapor volume root.","tags":"","url":"type/kindenum.html"},{"title":"GeModelTapenade – yaeos ","text":"type, public, abstract, extends( GeModel ) :: GeModelTapenade GeModelTapenade Base class for excess-Gibbs models with Tapenade-generated derivatives. Description A concrete extension supplies primal, tangent, adjoint, and mixed\nderivative routines. The type adapts them to the standard GeModel excess-Gibbs interface. Examples See the implementation template in tools/tapenade_diff/ge_models/ . Inherits type~~gemodeltapenade~~InheritsGraph type~gemodeltapenade GeModelTapenade type~gemodel GeModel type~gemodeltapenade->type~gemodel type~basemodel BaseModel type~gemodel->type~basemodel type~substances Substances type~basemodel->type~substances components Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial type( Substances ), public :: components Pure-component properties for the model’s component order. Type-Bound Procedures procedure, public :: excess_Cp public  subroutine excess_Cp (self, n, T, Cpe) Calculate Excess heat capacity. Read more… Arguments Type Intent Optional Attributes Name class( GeModel ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out) :: Cpe Excess heat capacity [bar L / K] procedure, public :: excess_enthalpy public  subroutine excess_enthalpy (self, n, T, He, HeT, Hen) Calculate Excess enthalpy and its derivatives. Read more… Arguments Type Intent Optional Attributes Name class( GeModel ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out), optional :: He Excess enthalpy real(kind=pr), intent(out), optional :: HeT real(kind=pr), intent(out), optional :: Hen (:) procedure, public :: excess_entropy public  subroutine excess_entropy (self, n, T, Se, SeT, Sen) Calculate Excess entropy and its derivatives. Read more… Arguments Type Intent Optional Attributes Name class( GeModel ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out), optional :: Se Excess entropy real(kind=pr), intent(out), optional :: SeT real(kind=pr), intent(out), optional :: Sen (:) procedure, public :: excess_gibbs private  subroutine excess_gibbs (self, n, t, Ge, GeT, GeT2, Gen, GeTn, Gen2) Excess Gibbs model generic interface Arguments Type Intent Optional Attributes Name class( GeModelTapenade ), intent(in) :: self Model instance. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(out), optional :: Ge Excess Gibbs energy [bar L]. real(kind=pr), intent(out), optional :: GeT [bar L/K]. real(kind=pr), intent(out), optional :: GeT2 [bar L/K&#94;2]. real(kind=pr), intent(out), optional, dimension(size(n)) :: Gen [bar L/mol]. real(kind=pr), intent(out), optional, dimension(size(n)) :: GeTn [bar L/(K mol)]. real(kind=pr), intent(out), optional :: Gen2 (size(n),size(n)) [bar L/mol&#94;2]. procedure( tapenade_ge ), public, deferred :: ge subroutine tapenade_ge(model, n, t, ge) Prototype tapenade_ge Primal excess-Gibbs callback required by GeModelTapenade . Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(out) :: ge Excess Gibbs energy. procedure( tapenade_ge_b ), public, deferred :: ge_b subroutine tapenade_ge_b(model, n, nb, t, tb, ge, geb) Prototype tapenade_ge_b Reverse-mode adjoint callback for excess Gibbs energy. Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr) :: nb (:) Adjoint value for component mole amounts. real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr) :: tb Adjoint value for temperature. real(kind=pr) :: ge Primal excess Gibbs energy. real(kind=pr) :: geb Incoming adjoint seed on the excess Gibbs output. procedure( tapenade_ge_d ), public, deferred :: ge_d subroutine tapenade_ge_d(model, n, nd, t, td, ge, ged) Prototype tapenade_ge_d Forward directional derivative callback for excess Gibbs energy. Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr), intent(in) :: nd (:) Tangent seed for component mole amounts (nd). real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(in) :: td Tangent seed for temperature (td). real(kind=pr), intent(out) :: ge Primal excess Gibbs energy. real(kind=pr), intent(out) :: ged Forward directional derivative of excess Gibbs energy. procedure( tapenade_ge_d_b ), public, deferred :: ge_d_b subroutine tapenade_ge_d_b(model, n, nb, nd, ndb, t, tb, td, tdb, ge, geb, ged, gedb) Prototype tapenade_ge_d_b Mixed forward/reverse derivative callback for GE Hessian components. Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr) :: nb (:) Adjoint value for component mole amounts. real(kind=pr), intent(in) :: nd (:) Tangent seed for component mole amounts (nd). real(kind=pr) :: ndb (:) Mixed tangent-adjoint value for component mole amounts. real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr) :: tb Adjoint value for temperature. real(kind=pr), intent(in) :: td Tangent seed for temperature (td). real(kind=pr) :: tdb Mixed tangent-adjoint value for temperature. real(kind=pr) :: ge real(kind=pr) :: geb Adjoint seed for the primal output. real(kind=pr) :: ged Forward directional energy derivative. real(kind=pr) :: gedb Mixed tangent-adjoint output for GE. procedure( tapenade_ge_d_d ), public, deferred :: ge_d_d subroutine tapenade_ge_d_d(model, n, nd, t, td0, td, ge, ged0, ged, gedd) Prototype tapenade_ge_d_d Nested forward-mode callback for second directional GE derivatives. Arguments Type Intent Optional Attributes Name class( GeModelTapenade ) :: model Concrete activity model. real(kind=pr), intent(in) :: n (:) Component mole amounts [mol]. real(kind=pr), intent(in) :: nd (:) Tangent seed for component mole amounts (nd). real(kind=pr), intent(in) :: t Temperature [K]. real(kind=pr), intent(in) :: td0 First temperature tangent seed. real(kind=pr), intent(in) :: td Tangent seed for temperature (td). real(kind=pr), intent(out) :: ge Primal excess Gibbs energy. real(kind=pr), intent(out) :: ged0 First nested tangent of excess Gibbs energy. real(kind=pr), intent(out) :: ged Forward directional derivative of excess Gibbs energy. real(kind=pr), intent(out) :: gedd Mixed second tangent of excess Gibbs energy. procedure, public :: ln_activity_coefficient public  subroutine ln_activity_coefficient (self, n, T, lngamma, dlngammadT, dlngammadn) Calculate natural logarithm of activity coefficients. Read more… Arguments Type Intent Optional Attributes Name class( GeModel ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out), optional :: lngamma (:) Natural logarithm of activity coefficients real(kind=pr), intent(out), optional :: dlngammadT (size(n)) real(kind=pr), intent(out), optional :: dlngammadn (size(n),size(n))","tags":"","url":"type/gemodeltapenade.html"},{"title":"newton_result – yaeos ","text":"type, public :: newton_result newton_result Diagnostics produced by one nonlinear solve. Description Contains the termination status, iteration count, final residual and\nstep norms, final damping and condition estimates, and optionally the\nresidual history. The final (last accepted) iterate is returned in x . Examples if ( result % status /= NEWTON_SUCCESS ) & write ( * , * ) newton_status_msg ( result % status ) Components Type Visibility Attributes Name Initial real(kind=pr), public :: cond_est = 0.0_pr Estimated condition number of J (or J&#94;T J + lambda I when LM active)\nat the final iteration, via LAPACK dgecon. Dimensionless. real(kind=pr), public :: dx_norm = 0.0_pr ||dX||_inf of the last computed Newton step at exit.\nUnits: same as x. real(kind=pr), public, allocatable :: f_history (:) ||F||_inf at iterations 0, 1, …, result%iterations.\nAllocated only when settings%save_history = .true.\nSize: (iterations + 1). real(kind=pr), public :: f_norm = 0.0_pr ||F(x)||_inf at exit. Should be < atol on NEWTON_SUCCESS.\nUnits: same as F. integer, public :: iterations = 0 Total number of Newton iterations performed (accepted + rejected). real(kind=pr), public :: lambda = 0.0_pr Value of the LM regularisation parameter at exit.\n0.0 means the final solve was a pure Newton step.\nUnits: [J]&#94;2. integer, public :: status = 0 Exit status code. Compare with NEWTON_SUCCESS, NEWTON_MAX_ITS, etc.\nUse newton_status_msg(status) for a human-readable string.","tags":"","url":"type/newton_result.html"},{"title":"newton_settings – yaeos ","text":"type, public :: newton_settings newton_settings Solver controls for convergence, damping, backtracking, and diagnostics. Description Components default to a general-purpose configuration. Change only\nfields that need tuning, and scale tolerances consistently with the\nresiduals and unknowns of the problem. Examples settings % atol = 1.0e-10_pr settings % verbosity = 1 call newton ( residual , x , settings , result ) Components Type Visibility Attributes Name Initial real(kind=pr), public :: armijo_c = 1.0e-4_pr Sufficient decrease constant (Wolfe c1 condition).\nSmaller values accept more steps but give weaker convergence guarantees.\nMust satisfy 0 < armijo_c < 0.5. Dimensionless. Default: 1e-4. integer, public :: armijo_max_its = 50 Maximum number of backtracking halvings per Newton step.\nIf reached without satisfying Armijo, ls_failed is set .true.\nDefault: 50. real(kind=pr), public :: armijo_tau = 0.5_pr Step-length reduction factor applied each backtracking iteration.\nt_new = armijo_tau * t_old  until Armijo or t < t_min.\nMust satisfy 0 < armijo_tau < 1. Dimensionless. Default: 0.5. real(kind=pr), public :: atol = 1.0e-9_pr Absolute residual tolerance.\nConverged when  max_i |F_i(x)| < atol.\nUnits: same as F. Default: 1e-9. real(kind=pr), public :: cond_max = 1.0e10_pr Condition number threshold above which LM regularization is activated\n(or strengthened) to stabilise the linear solve.\nEstimated via LAPACK dgecon. Dimensionless. Default: 1e10. real(kind=pr), public :: lambda0 = 0.0_pr Initial value of the LM damping parameter.\n0.0 = start as pure Newton; the solver activates LM automatically\nif conditioning is poor. Set > 0 to force LM from the first iteration.\nUnits: [J]&#94;2 (scales with the Jacobian entries squared). Default: 0. real(kind=pr), public :: lambda_down = 5.0_pr Factor by which lambda is divided after a successful step with t > 0.1.\nDrives the solver back toward pure Newton as the iterate improves.\nDimensionless. Default: 5. real(kind=pr), public :: lambda_max = 1.0e8_pr Maximum lambda, expressed as a multiplier of jacobian_scale.\nIf lambda exceeds this ceiling the solver returns NEWTON_LINE_SEARCH_FAIL.\nDimensionless multiplier. Default: 1e8. real(kind=pr), public :: lambda_min = 1.0e-6_pr Minimum non-zero lambda, expressed as a multiplier of jacobian_scale.\nEffective floor = lambda_min * ||J||_F&#94;2/n.\nPrevents lambda from decaying to numerical zero after a good step.\nDimensionless multiplier. Default: 1e-6. real(kind=pr), public :: lambda_up = 10.0_pr Factor by which lambda is multiplied on a line-search failure.\nLarger values recover faster from bad Jacobians but may overshoot.\nDimensionless. Default: 10. integer, public :: max_its = 100 Maximum number of Newton iterations before returning NEWTON_MAX_ITS.\nDefault: 100. real(kind=pr), public :: rtol = 1.0e-9_pr Relative step tolerance.\nConverged when  max_i |dX_i| < rtol * (max_i |x_i| + atol).\nCatches the case where the step becomes negligible compared to x.\nDimensionless. Default: 1e-9. logical, public :: save_history = .false. If .true., allocate result%f_history(0:iterations) and store\n||F||_inf at each iteration. Slightly increases memory use.\nDefault: .false. integer, public :: stagnation_nits = 5 Number of consecutive iterations with negligible change in ||dX||\nbefore the solver exits with NEWTON_STAGNATION.\nDefault: 5. real(kind=pr), public :: stagnation_tol = 1.0e-12_pr Relative threshold for stagnation: iteration is counted as stagnant\nwhen  |||dX||_prev - ||dX||_curr| < stagnation_tol * (||dX|| + 1).\nDimensionless. Default: 1e-12. real(kind=pr), public :: t_min = 1.0e-8_pr Minimum accepted step length.\nIf t < t_min the line search declares failure instead of accepting a\nmicro-step that satisfies Armijo trivially (m changes by ~machine eps).\nDimensionless (fraction of the full Newton step). Default: 1e-8. integer, public :: verbosity = 0 Controls stdout output.\n  0 – silent\n  1 – print header + one-line summary at exit\n  2 – also print one line per accepted iteration\nDefault: 0.","tags":"","url":"type/newton_settings.html"},{"title":"NRTLHV – yaeos ","text":"type, public, extends( GeModel ) :: NRTLHV NRTLHV Huron-Vidal modification of the NRTL model for excess Gibbs energy. Description Huron-Vidal modified the NRTL model, including the covolume parameter\ninto the model. This helps when running the model coupled with a cubic\nequation of state, because it can be reduced to the classical\nquadratic mixing rules when its parameters are defined accordingly. It uses the temperature function: There is no custom constructor; use the default structure\nconstructor. Energy parameters must be in the units of ( R in bar L / (mol K)). Examples ge = NRTLHV ( b = b , alpha = alpha , gji0 = gji0 , gjiT = gjiT ) References Huron, M.-J., and J. Vidal (1979). Fluid Phase Equilibria , 3, 255-271. Inherits type~~nrtlhv~~InheritsGraph type~nrtlhv NRTLHV type~gemodel GeModel type~nrtlhv->type~gemodel type~basemodel BaseModel type~gemodel->type~basemodel type~substances Substances type~basemodel->type~substances components Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Inherited by type~~nrtlhv~~InheritedByGraph type~nrtlhv NRTLHV type~hv_nrtl HV_NRTL type~hv_nrtl->type~nrtlhv ge Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial real(kind=pr), public, allocatable :: alpha (:,:) matrix real(kind=pr), public, allocatable :: b (:) Covolume parameter type( Substances ), public :: components Pure-component properties for the model’s component order. real(kind=pr), public, allocatable :: gji0 (:,:) matrix real(kind=pr), public, allocatable :: gjiT (:,:) matrix Type-Bound Procedures procedure, public :: excess_Cp public  subroutine excess_Cp (self, n, T, Cpe) Calculate Excess heat capacity. Read more… Arguments Type Intent Optional Attributes Name class( GeModel ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out) :: Cpe Excess heat capacity [bar L / K] procedure, public :: excess_enthalpy public  subroutine excess_enthalpy (self, n, T, He, HeT, Hen) Calculate Excess enthalpy and its derivatives. Read more… Arguments Type Intent Optional Attributes Name class( GeModel ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out), optional :: He Excess enthalpy real(kind=pr), intent(out), optional :: HeT real(kind=pr), intent(out), optional :: Hen (:) procedure, public :: excess_entropy public  subroutine excess_entropy (self, n, T, Se, SeT, Sen) Calculate Excess entropy and its derivatives. Read more… Arguments Type Intent Optional Attributes Name class( GeModel ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out), optional :: Se Excess entropy real(kind=pr), intent(out), optional :: SeT real(kind=pr), intent(out), optional :: Sen (:) procedure, public :: excess_gibbs public  subroutine excess_gibbs (self, n, T, Ge, GeT, GeT2, Gen, GeTn, Gen2) Calculate Excess Gibbs and its derivatives. Arguments Type Intent Optional Attributes Name class( NRTLHV ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out), optional :: Ge Excess Gibbs free energy real(kind=pr), intent(out), optional :: GeT real(kind=pr), intent(out), optional :: GeT2 real(kind=pr), intent(out), optional :: Gen (size(n)) real(kind=pr), intent(out), optional :: GeTn (size(n)) Mixed temperature-mole-number derivative. real(kind=pr), intent(out), optional :: Gen2 (size(n),size(n)) Hessian with respect to mole amounts. procedure, public :: ln_activity_coefficient public  subroutine ln_activity_coefficient (self, n, T, lngamma, dlngammadT, dlngammadn) Calculate natural logarithm of activity coefficients. Read more… Arguments Type Intent Optional Attributes Name class( GeModel ), intent(in) :: self Model real(kind=pr), intent(in) :: n (:) Moles vector real(kind=pr), intent(in) :: T Temperature [K] real(kind=pr), intent(out), optional :: lngamma (:) Natural logarithm of activity coefficients real(kind=pr), intent(out), optional :: dlngammadT (size(n)) real(kind=pr), intent(out), optional :: dlngammadn (size(n),size(n))","tags":"","url":"type/nrtlhv.html"},{"title":"Gerg2008 – yaeos ","text":"type, public, extends( ArModelAdiff ) :: Gerg2008 Gerg2008 GERG2008 multifluid equation of state. Holds the pure-fluid and\nbinary parameters of the selected components and an SRK model used\nto initialize the volume solver. Description Provides the standard residual Helmholtz properties through the\ninherited hyperdual adapter and specializes volume solving with an\nSRK initial estimate. Examples model = gerg_2008 ([ G2008Components % methane , G2008Components % nitrogen ]) call model % pressure ( n , V , T , P ) Inherits type~~gerg2008~~InheritsGraph type~gerg2008 Gerg2008 type~armodeladiff ArModelAdiff type~gerg2008->type~armodeladiff type~cubiceos CubicEoS type~gerg2008->type~cubiceos srk type~gerg2008binary Gerg2008Binary type~gerg2008->type~gerg2008binary binaries type~gerg2008pure Gerg2008Pure type~gerg2008->type~gerg2008pure pures type~armodel ArModel type~armodeladiff->type~armodel type~alphafunction AlphaFunction type~cubiceos->type~alphafunction alpha type~cubiceos->type~armodel type~cubicmixrule CubicMixRule type~cubiceos->type~cubicmixrule mixrule type~basemodel BaseModel type~armodel->type~basemodel type~substances Substances type~basemodel->type~substances components Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial type( Gerg2008Binary ), public, allocatable :: binaries (:,:) Pair interaction data indexed by component pair. type( Substances ), public :: components Pure-component properties for the model’s component order. integer, public, allocatable :: ids (:) GERG2008 identifiers, in model component order. character(len=:), public, allocatable :: name Name of the model type( Gerg2008Pure ), public, allocatable :: pures (:) Pure-fluid Helmholtz parameters, in model component order. type( CubicEoS ), public :: srk SRK helper used to initialize the volume root. Type-Bound Procedures procedure, public :: Cp_residual_pt private  subroutine Cp_residual_pt (eos, n, P, T, root_type, Cp) Calculate residual heat capacity at constant pressure given pressure\nand temperature. Read more… Arguments Type Intent Optional Attributes Name class( ArModel ), intent(in) :: eos Model real(kind=pr), intent(in) :: n (:) Moles number vector real(kind=pr), intent(in) :: P Pressure [bar] real(kind=pr), intent(in) :: T Temperature [K] character(len=*), intent(in) :: root_type Desired root-type to solve. Options are: [\"liquid\", \"vapor\", \