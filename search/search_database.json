up_dortmund(molecules) !! call model%ln_activity_coefficient(n, T, ln_gamma) !! ``` use yaeos__constants , only : pr use yaeos__models_ge_gc_td , only : QuadraticPsi use yaeos__models_ge_group_contribution_groups , only : Groups use yaeos__models_ge_group_contribution_unifac , only : UNIFAC , setup_unifac use yaeos__models_ge_group_contribution_model_parameters , only : GeGCModelParameters use yaeos__models_ge_group_contribution_dortmund_parameters , only : DortmundParameters implicit none contains type ( UNIFAC ) function setup_dortmund ( molecules , parameters ) !! Create a Dortmund UNIFAC model. !! !! Uses the Dortmund parameter set by default. An alternative parameter !! object can be supplied with `parameters`. use yaeos__models_ge_group_contribution_unifac_parameters , only : UNIFACParameters type ( Groups ), intent ( in ) :: molecules (:) !! Groups of each molecule type ( GeGCModelParameters ), optional , intent ( in ) :: parameters !! Optional parameter set type ( GeGCModelParameters ) :: params type ( QuadraticPsi ) :: psi_function real ( pr ), allocatable :: Aij (:, :) real ( pr ), allocatable :: Bij (:, :) real ( pr ), allocatable :: Cij (:, :) type ( Groups ) :: soup integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. integer :: ng if ( present ( parameters )) then params = parameters else params = DortmundParameters () end if setup_dortmund = setup_unifac ( molecules , params ) ! ======================================================================== ! Build Aij, Bij and Cij matrix (interaction of the soup's subgroups) ! ------------------------------------------------------------------------ soup = setup_dortmund % groups_stew ng = size ( soup % groups_ids ) allocate ( Aij ( ng , ng ), Bij ( ng , ng ), Cij ( ng , ng )) Aij = 0 Bij = 0 Cij = 0 do i = 1 , size ( soup % groups_ids ) do j = 1 , size ( soup % groups_ids ) Aij ( i , j ) = params % get_subgroups_aij (& soup % groups_ids ( i ), soup % groups_ids ( j ) & ) Bij ( i , j ) = params % get_subgroups_bij (& soup % groups_ids ( i ), soup % groups_ids ( j ) & ) Cij ( i , j ) = params % get_subgroups_cij (& soup % groups_ids ( i ), soup % groups_ids ( j ) & ) end do end do psi_function % Aij = Aij psi_function % Bij = Bij psi_function % Cij = Cij deallocate ( setup_dortmund % psi_function ) setup_dortmund % psi_function = psi_function ! Important, the parameter d (exponent of the r params in Flory-Huggins) setup_dortmund % d = 3.0_pr / 4.0_pr end function end module","tags":"","url":"sourcefile/dortmund.f90.html"},{"title":"linalg.f90 – yaeos","text":"This file depends on sourcefile~~linalg.f90~~EfferentGraph sourcefile~linalg.f90 linalg.f90 sourcefile~auxiliar.f90~2 auxiliar.f90 sourcefile~linalg.f90->sourcefile~auxiliar.f90~2 sourcefile~constants.f90 constants.f90 sourcefile~linalg.f90->sourcefile~constants.f90 sourcefile~auxiliar.f90~2->sourcefile~constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~linalg.f90~~AfferentGraph sourcefile~linalg.f90 linalg.f90 sourcefile~continuation.f90 continuation.f90 sourcefile~continuation.f90->sourcefile~linalg.f90 sourcefile~critical.f90 critical.f90 sourcefile~critical.f90->sourcefile~linalg.f90 sourcefile~critical.f90->sourcefile~continuation.f90 sourcefile~math.f90 math.f90 sourcefile~critical.f90->sourcefile~math.f90 sourcefile~ar_models.f90 ar_models.f90 sourcefile~critical.f90->sourcefile~ar_models.f90 sourcefile~stability.f90 stability.f90 sourcefile~critical.f90->sourcefile~stability.f90 sourcefile~generic_cubic.f90 generic_cubic.f90 sourcefile~generic_cubic.f90->sourcefile~linalg.f90 sourcefile~generic_cubic.f90->sourcefile~ar_models.f90 sourcefile~volume.f90 volume.f90 sourcefile~generic_cubic.f90->sourcefile~vol