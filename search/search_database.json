ine ArVnder (nc, nder, ntemp, z, V, T, ar, arv, artv, arv2, Arn, ArVn, ArTn, Arn2) Dispatch the configured legacy residual Helmholtz implementation. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: nc Number of active components. integer, intent(in) :: nder Get compositional derivatives integer, intent(in) :: ntemp Get temperature derivatives real(kind=pr), intent(in) :: z (nc) Component mole amounts/composition vector. real(kind=pr), intent(in) :: V Total volume [L]. real(kind=pr), intent(in) :: T Temperature [K]. real(kind=pr), intent(out) :: ar Residual Helmholtz energy. real(kind=pr), intent(out) :: arv First volume derivative of residual Helmholtz energy. real(kind=pr), intent(out) :: artv Mixed volume-temperature derivative of residual Helmholtz energy. real(kind=pr), intent(out) :: arv2 Second volume derivative of residual Helmholtz energy. real(kind=pr), intent(out), dimension(size(z)) :: Arn Composition gradient of residual Helmholtz energy. real(kind=pr), intent(out), dimension(size(z)) :: ArVn Mixed volume-composition derivatives. real(kind=pr), intent(out), dimension(size(z)) :: ArTn Mixed temperature-composition derivatives. real(kind=pr), intent(out) :: Arn2 (size(z),size(z)) Composition Hessian of residual Helmholtz energy. public  subroutine Bnder (nc, rn, Bmix, dBi, dBij) Evaluate the legacy quadratic-mixture covolume and derivatives. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: nc Number of active components. real(kind=pr), intent(in) :: rn (nc) Component mole amounts used in mixture rules. real(kind=pr), intent(out) :: Bmix Mixture covolume. real(kind=pr), intent(out) :: dBi (nc) Mole-number gradient of the mixture covolume. real(kind=pr), intent(out) :: dBij (nc,nc) Mole-number Hessian of the mixture covolume. public  subroutine DELTAnder (nc, rn, D1m, dD1i, dD1ij) Evaluate the mole-averaged cubic denominator parameter and derivatives. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: nc Number of active components. real(kind=pr), intent(in) :: rn (nc) Component mole amounts used in mixture rules. real(kind=pr), intent(out) :: D1m Mixture cubic denominator parameter. real(kind=pr), intent(out) :: dD1i (nc) Mole-number gradient of the cubic denominator parameter. real(kind=pr), intent(out) :: dD1ij (nc,nc) Mole-number Hessian of the cubic denominator parameter. public  subroutine DandTnder (ntd, nc, T, rn, D, dDi, dDiT, dDij, dDdT, dDdT2) Evaluate the legacy mixture attractive parameter and derivatives. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: ntd Flag selecting temperature-dependent derivative calculations. integer, intent(in) :: nc Number of active components. real(kind=pr), intent(in) :: T Temperature [K]. real(kind=pr), intent(in) :: rn (nc) Component mole amounts used in mixture rules. real(kind=pr), intent(out) :: D Mixture attractive parameter. real(kind=pr), intent(out) :: dDi (nc) . real(kind=pr), intent(out) :: dDiT (nc) . real(kind=pr), intent(out) :: dDij (nc,nc) . real(kind=pr), intent(out) :: dDdT . real(kind=pr), intent(out) :: dDdT2 . public  subroutine HelmRKPR (nco, NDE, NTD, rn, V, T, Ar, ArV, ArTV, ArV2, Arn, ArVn, ArTn, Arn2) Calculate the reduced residual Helmholtz Energy and it’s derivatives with the RKPR EOS Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: nco Number of components in the mixture. integer, intent(in) :: NDE Compositional derivative order; 2 also computes Arn2 . integer, intent(in) :: NTD Flag selecting temperature-dependent derivative calculations. real(kind=pr), intent(in) :: rn (nco) Component mole amounts used in mixture rules. real(kind=pr), intent(in) :: V Total volume [L]. real(kind=pr), intent(in) :: T Temperature [K]. real(kind=pr), intent(out) :: Ar Residual Helmholtz energy. real(kind=pr), intent(out) :: ArV First volume derivative of residual Helmholtz energy. real(kind=pr), intent(out) :: 