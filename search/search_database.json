, 0.011] !!  z = [0.03_pr, 1-0.13_pr, 0.1_pr] !!  P = 45.6_pr !!  T = 190._pr !!  mpfr = pt_mp_flash(model, z, P, T) !!  print *, \"Number of phases:\", mpfr%np !!  print *, \"Phase compositions:\" !!  do i=1, mpfr%np !!     print *, \"Phase\", i, \"composition:\", mpfr%x_l(i, :) !!  end do !!  print *, \"Reference phase composition:\", mpfr%w(:) !! ``` !! !! # References !! use yaeos__constants , only : pr , R use yaeos__models_ar , only : ArModel use yaeos__equilibria_equilibrium_state , only : MPEquilibriumState implicit none contains type ( MPEquilibriumState ) function pt_mp_flash ( model , z , P , T ) !! # pt_mp_flash !! Perform a multiphase flash at fixed feed composition, pressure, and temperature. !! !! # Description !! This method will do stability analysis to detect the possibility of !! new phases. For each new phase detected it will calculate a multiphase !! flash and repeat stability analysis until no new phases are detected. !! !! # Examples !! !! ```fortran !! result = pt_mp_flash(model, z, P, T) !! print *, result%np, result%x_l !! ``` use yaeos__equilibria_stability , only : min_tpd class ( ArModel ), intent ( in ) :: model !! Residual Helmholtz EOS. real ( pr ), intent ( in ) :: z (:) !! Overall feed mole fractions. real ( pr ), intent ( in ) :: P !! Pressure [bar]. real ( pr ), intent ( in ) :: T !! Temperature [K]. integer , parameter :: max_phases = 4 integer :: np !! Number of phases. real ( pr ) :: mintpd real ( pr ) :: all_minima ( size ( z ), size ( z )) real ( pr ) :: w ( size ( z )) !! Reference/trial phase composition. real ( pr ) :: w_stab ( size ( z )) real ( pr ) :: mintpd_xl1 real ( pr ) :: mintpd_w real ( pr ) :: x_l ( max_phases , size ( z )) !! Main-phase compositions. real ( pr ) :: K ( max_phases , size ( z )) character ( len = 14 ) :: kinds_x ( max_phases ) character ( len = 14 ) :: kind_w logical :: less_phases integer :: beta_0_index integer :: iters integer :: ns1 integer :: ns2 integer :: nc !! Number of components. real ( pr ) :: S1 real ( pr ) :: S2 integer :: max_iters real ( pr ), allocatable :: X (:) real ( pr ), allocatable :: F (:) real ( pr ), allocatable :: betas (:) !! Phase fractions for the main phases. real ( pr ) :: beta0 max_iters = 1000 kinds_x = \"liquid\" kind_w = \"vapor\" nc = size ( z ) np = 0 S1 = log ( P ) S2 = log ( T ) call min_tpd ( model , z , P , T , mintpd , w_stab ) if ( mintpd < - 0.001 ) then np = np + 1 ns1 = np * nc + np + 1 + 1 ns2 = np * nc + np + 1 + 2 x_l ( 1 , :) = z K ( 1 , :) = x_l ( 1 , :) / w_stab beta0 = z ( maxloc ( w_stab , dim = 1 )) beta0 = 1e-5 betas = [ 1 - beta0 , beta0 ] X = [ log ( K ( 1 , :)), log ( betas ), log ( P ), log ( T )] F = X call solve_mp_flash_point (& model , z , np , kinds_x , kind_w , X , ns1 , S1 , ns2 , S2 , max_iters , F , & less_phases , beta_0_index , iters & ) K ( 1 , :) = exp ( X (: nc )) betas = exp ( X ( np * nc + 1 : np * nc + np + 1 )) w = z / ( matmul ( betas (: np ), K (: np , :)) + betas ( np + 1 )) x_l ( 1 , :) = K ( 1 , :) * w call min_tpd ( model , w , P , T , mintpd_w , w_stab ) call min_tpd ( model , x_l ( 1 , :), P , T , mintpd_xl1 , w_stab ) if ( mintpd_w < - 0.001 ) then np = np + 1 ns1 = np * nc + np + 1 + 1 ns2 = np * nc + np + 1 + 2 x_l ( 2 , :) = w w = w_stab K ( 1 , :) = x_l ( 1 , :) / w K ( 2 , :) = x_l ( 2 , :) / w betas = [ betas , 0.5_pr ] X = [ log ( K ( 1 , :)), log ( K ( 2 , :)), log ( betas ), log ( P ), log ( T )] F = X call solve_mp_flash_point (& model , z , np , kinds_x (: 2 ), kind_w , X , ns1 , S1 , ns2 , S2 , max_iters , F , & less_phases , beta_0_index , iters & ) K ( 1 , :) = exp ( X (: nc )) K ( 2 , :) = exp ( X ( nc + 1 : 2 * nc )) betas = exp ( X ( np * nc + 1 : np * nc + np + 1 )) w = z / ( matmul ( betas (: np ), K (: np , :)) + betas ( np + 1 )) x_l ( 1 , :) = K ( 1 , :) * w x_l ( 2 , :) = K ( 2 , :) * w end if end if pt_mp_flash % z = z pt_mp_flash % P = P pt_mp_flash % T = T pt_mp_flash % np = np pt_mp_flash % x_l = x_l ( 1 : np , :) pt_mp_flash % w = w pt_mp_flash 