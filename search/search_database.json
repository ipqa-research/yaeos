a second/injection !! composition. !! !! # Examples !! ```fortran !! fluid = oil_gao() !! print *, fluid%reference, fluid%z0 !! ``` integer :: nc !! Number of components character ( len = :), allocatable :: reference !! Reference of where the fluid was taken from real ( pr ), allocatable :: z0 (:) !! Original composition real ( pr ), allocatable :: zi (:) !! Injection composition (if exists) class ( ArModel ), allocatable :: ar_model !! Equation-of-state model associated with this fixture fluid. end type FixtureFluid contains type ( FixtureFluid ) function oil_gao () !! # oil_gao !! Construct the six-component bitumen/n-butane/water fixture from Gao et al. !! !! # Description !! Builds a Peng-Robinson 1978 model with the reported binary interactions !! and stores the experimental reference composition. !! !! # Examples !! ```fortran !! fluid = oil_gao() !! ``` !! J. Gao, R. Okuno, and H. A. Li, !! “An Experimental Study of Multiphase Behavior for n-Butane/Bitumen/Water Mixtures,” !! SPE Journal, 2016, doi: 10.2118/180736-pa. integer , parameter :: nc = 6 !! Number of components. type ( CubicEoS ) :: ar_model real ( pr ) :: tc ( nc ) real ( pr ) :: pc ( nc ) real ( pr ) :: w ( nc ) !! Acentric factors. type ( QMR ) :: mixrule real ( pr ) :: kij ( nc , nc ) real ( pr ) :: lij ( nc , nc ) tc = [ 64 7.05_pr , 42 5.15_pr , 70 8.15_pr , 76 8.25_pr , 99 8.15_pr , 134 6.05_pr ] pc = [ 22 0.64_pr , 3 7.96_pr , 2 1.46_pr , 1 5.07_pr , 1 3.64_pr , 1 0.45_pr ] w = [ 0.3433_pr , 0.2014_pr , 0.8423_pr , 0.9429_pr , 1.0225_pr , 1.1486_pr ] ar_model = PengRobinson78 ( tc , pc , w ) kij ( 1 , :) = [ 0.0_pr , 0.636_pr , 0.2006_pr , 0.1694_pr , 0.1694_pr , 0.1694_pr ] kij ( 2 , :) = [ 0.636_pr , 0.0_pr , - 0.0005_pr , - 0.0011_pr , - 0.0018_pr , - 0.0031_pr ] kij ( 3 , :) = [ 0.2006_pr , - 0.0005_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] kij ( 4 , :) = [ 0.1694_pr , - 0.0011_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] kij ( 5 , :) = [ 0.1694_pr , - 0.0018_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] kij ( 6 , :) = [ 0.1694_pr , - 0.0031_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] lij ( 1 , :) = [ 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] lij ( 2 , :) = [ 0.0_pr , 0.0_pr , - 0.0_pr , - 0.0_pr , - 0.0_pr , - 0.0_pr ] lij ( 3 , :) = [ 0.0_pr , - 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] lij ( 4 , :) = [ 0.0_pr , - 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] lij ( 5 , :) = [ 0.0_pr , - 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] lij ( 6 , :) = [ 0.0_pr , - 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ] mixrule = QMR ( k = kij , l = lij ) call ar_model % set_mixrule ( mixrule ) oil_gao % nc = nc oil_gao % reference = \"doi: 10.2118/180736-pa\" oil_gao % ar_model = ar_model oil_gao % z0 = [ 0.6202_pr , 0.3702_pr , 0.0051_pr , 0.0023_pr , 0.0014_pr , 0.0008_pr ] end function oil_gao type ( FixtureFluid ) function co2_h2o_isop () result ( fluid ) !! # co2_h2o_isop !! Construct the CO2-water-isopropanol three-component fixture. !! !! # Description !! Returns a Soave-Redlich-Kwong model with binary interaction parameters, !! a reference composition, and a second composition for comparison. !! !! # Examples !! ```fortran !! fluid = co2_h2o_isop() !! ``` use yaeos__models , only : CubicEoS , SoaveRedlichKwong integer , parameter :: nc = 3 !! Number of components. real ( pr ) :: Tc ( nc ) real ( pr ) :: Pc ( nc ) real ( pr ) :: w ( nc ) !! Acentric factors. real ( pr ) :: kij ( nc , nc ) Tc = [ 30 4.21 , 64 7.13 , 50 8.3 ] Pc = [ 7 3.3 , 22 0.55 , 4 7.64 ] w = [ 0.2236 , 0.3449 , 0.6669 ] kij ( 1 , :) = [ 0._pr , 0.19_pr , 0.1215_pr ] kij ( 2 , :) = [ 0.19_pr , 0._pr , - 0.1727_pr ] kij ( 3 , :) = [ 0.1215_pr , - 0.1727_pr , 0._pr ] fluid % nc = nc fluid % ar_model = SoaveRedlichKwong ( Tc , Pc , w , kij = kij ) fluid % z0 = [ 0.997493267163008 , 0.000567120831996 , 0.00193961200499 ] fluid % zi = [ 0.122878702720943 , 0.376116603168507 , 0.50100469411055 ] end function co2_h2o_isop type ( FixtureFluid ) function oil_b71 () result ( fluid ) !! # oil_b71 