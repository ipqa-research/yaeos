mp1 = eta ** 4 temp0 = m_ave / temp1 zetasb ( 3 ) = zetasb ( 3 ) + ( 3 * zetas ( 3 ) ** 2 * 1 2.0_pr - 4 * zetas ( 3 ) ** 3 * & & 2.0_pr - 2 * zetas ( 3 ) * 2 7.0_pr + 2 0.0_pr ) * tempb - ( 2 * ( 1.0_pr - zetas ( 3 )) * & & ( 2.0_pr - zetas ( 3 )) ** 2 + 2 * ( 2.0_pr - zetas ( 3 )) * ( 1.0_pr - zetas ( 3 )) ** 2 ) * & & tempb1 + ( 8.0_pr - 2 * zetas ( 3 ) * 2.0_pr ) * temp0 * c1b tempb0 = ( 8.0_pr * zetas ( 3 ) - 2.0_pr * zetas ( 3 ) ** 2 ) * c1b / temp1 m_aveb = m_aveb + tempb0 etab = - ( 4 * eta ** 3 * temp0 * tempb0 ) DO k = 6 , 0 , - 1 b_kb = zetas ( 3 ) ** k * i2b IF (. NOT . ( zetas ( 3 ) . LE . 0.0 . AND . k . EQ . 0.0 )) zetasb ( 3 ) = & & zetasb ( 3 ) + k * zetas ( 3 ) ** ( k - 1 ) * b_k * i2b a_kb = zetas ( 3 ) ** k * i1b IF (. NOT . ( zetas ( 3 ) . LE . 0.0 . AND . k . EQ . 0.0 )) zetasb ( 3 ) = & & zetasb ( 3 ) + k * zetas ( 3 ) ** ( k - 1 ) * a_k * i1b CALL POPREAL8 ( b_k ) tempb1 = b_coeffs ( 1 , k ) * b_kb / m_ave tempb0 = b_coeffs ( 2 , k ) * b_kb / m_ave ** 2 m_aveb = m_aveb + ( 2 * m_ave - 2 * ( m_ave - 1.0_pr ) * ( m_ave - 2.0_pr ) / m_ave & & - 3.0 ) * tempb0 + ( 1.0 - ( m_ave - 1.0_pr ) / m_ave ) * tempb1 CALL POPREAL8 ( a_k ) tempb1 = a_coeffs ( 1 , k ) * a_kb / m_ave tempb0 = a_coeffs ( 2 , k ) * a_kb / m_ave ** 2 m_aveb = m_aveb + ( 2 * m_ave - 2 * ( m_ave - 1.0_pr ) * ( m_ave - 2.0_pr ) / m_ave & & - 3.0 ) * tempb0 + ( 1.0 - ( m_ave - 1.0_pr ) / m_ave ) * tempb1 END DO xb = 0.0_pr DO i = nc , 1 , - 1 DO j = nc , 1 , - 1 sig_ij = 0.5_pr * ( sigma ( i ) + sigma ( j )) term_disp = x ( i ) * x ( j ) * m ( i ) * m ( j ) * sig_ij ** 3 tempb1 = eps_ij ** 2 * m2_e2s3b / t ** 2 term_dispb = tempb1 tb = tb - 2 * term_disp * tempb1 / t tempb1 = eps_ij * m2_es3b / t term_dispb = term_dispb + tempb1 tb = tb - term_disp * tempb1 / t tempb1 = m ( i ) * m ( j ) * sig_ij ** 3 * term_dispb xb ( i ) = xb ( i ) + x ( j ) * tempb1 xb ( j ) = xb ( j ) + x ( i ) * tempb1 CALL POPREAL8 ( eps_ij ) END DO END DO tempb1 = n_avo * rho_dispb / ( 1.0e27_pr * v ) n_totb = n_totb + tempb1 vb = - ( n_tot * tempb1 / v ) ELSE vb = 0.0_pr xb = 0.0_pr zetasb = 0.0_pr etab = 0.0_pr END IF db = 0.0_pr CALL POPINTEGER4 ( ad_to0 ) DO i = ad_to0 , 1 , - 1 tempb1 = - (( m ( i ) - 1.0_pr ) * ar_chainb ) xb ( i ) = xb ( i ) + LOG ( g_ii ) * tempb1 g_iib = x ( i ) * tempb1 / g_ii di_2 = d ( i ) / 2.0_pr CALL POPREAL8 ( g_ii ) temp = eta * eta * eta tempb0 = 3.0_pr * g_iib / eta ** 2 tempb1 = 2.0_pr * g_iib / temp etab = etab - g_iib / eta ** 2 - 3 * eta ** 2 * di_2 ** 2 * zetas ( 2 ) ** 2 * tempb1 / & & temp - 2 * di_2 * zetas ( 2 ) * tempb0 / eta di_2b = 2 * di_2 * zetas ( 2 ) ** 2 * tempb1 + zetas ( 2 ) * tempb0 zetasb ( 2 ) = zetasb ( 2 ) + 2 * zetas ( 2 ) * di_2 ** 2 * tempb1 + di_2 * tempb0 db ( i ) = db ( i ) + di_2b / 2.0_pr END DO temp = zetas ( 3 ) * ( eta * eta ) tempb0 = ar_hsb / zetas ( 0 ) term1_hsb = tempb0 term2_hsb = tempb0 term3_hsb = tempb0 temp0 = zetas ( 2 ) * zetas ( 2 ) * zetas ( 2 ) / ( zetas ( 3 ) * zetas ( 3 )) tempb = LOG ( eta ) * term3_hsb zetasb ( 0 ) = zetasb ( 0 ) - ( term1_hs + term2_hs + term3_hs ) * tempb0 / zetas ( 0 )& & - tempb tempb0 = tempb / zetas ( 3 ) ** 2 zetasb ( 2 ) = zetasb ( 2 ) + 3 * zetas ( 2 ) ** 2 * tempb0 + 3 * zetas ( 2 ) ** 2 * & & term2_hsb / temp tempb = - ( zetas ( 2 ) ** 3 * term2_hsb / temp ** 2 ) etab = etab + ( temp0 - zetas ( 0 )) * term3_hsb / eta + 2 * eta * zetas ( 3 ) * tempb zetasb ( 3 ) = zetasb ( 3 ) + eta ** 2 * tempb - 2 * zetas ( 3 ) * temp0 * tempb0 temp = zetas ( 1 ) / eta tempb = zetas ( 2 ) * 3.0_pr * term1_hsb / eta zetasb ( 2 ) = zetasb ( 2 ) + temp * 3.0_pr * term1_hsb zetasb ( 1 ) = zetasb ( 1 ) + tempb etab = etab - temp * tempb zetasb ( 3 ) = zetasb ( 3 ) - etab rhob = 0.0_pr DO k = 3 , 0 , - 1 arg10 = x * m * d ** k arg10b = 0.0_pr rhob = rhob + SUM ( arg10 ) * pi * zetasb ( k ) / 6.0_pr arg10b = rho * pi * zetasb ( k ) / 6.0_pr zetasb ( k ) = 0.0_pr xb = xb + d ** k * m * arg10b WHERE (. NOT . ( d . LE . 0.0 . AND . k . EQ . 0.0 )) db = db + k * d ** ( k - 1 ) * x * & & m * arg10b END DO nb = 0.0_pr tempb = n_avo * rhob / ( 1.0e27_pr * v ) nb = tempb vb = vb - SUM ( n ) * tempb / v CALL POPINTEGER4 ( ad_to ) DO i = ad_to , 1 , - 1 arg1 = - ( 3.0_pr * epsilon_k ( i ) / t ) arg1b = - ( EXP ( arg1 ) * 0.12_pr * sigma ( i ) * db ( i )) db ( i ) = 0.0_pr tb = tb + 3.0_pr * epsilon_k ( i ) * arg1b / t ** 2 END DO DO i = nc , 1 , - 1 xb ( i ) = xb ( i ) + m ( i ) * m_aveb END DO temp = SUM ( n ) nb = nb + n_totb + xb / temp - SUM ( n * xb ) / temp ** 2 arvalb = 0.0_pr end subroutine AR_B SUBROUTINE AR ( model , n , v , t , arval ) !! # AR !! Evaluate the primal PC-SAFT residual Helmholtz energy. !! !! # Description !! Computes the dimensionless hard-sphere, chain, and dispersion !! contributions and returns their total in the library energy units. !! The routine is also the primal entry point differentiated by Tapenade. !! !! # Examples !! Use `model%pressure` or `model%residual_helmholtz` in client code; !! direct calls to this low-level routine are mainly for derivative tests. IMPLICIT NONE class ( PCSAFT ), INTENT ( IN ) :: model !! Model supplying segment parameters. REAL ( pr ), INTENT ( IN ) :: n (:) !! Component mole amounts [mol]. REAL ( pr ), INTENT ( IN ) :: v !! Total volume [L]. REAL ( pr ), INTENT ( IN ) :: t !! Temperature [K]. REAL ( pr ), INTENT ( OUT ) :: arval !! Residual Helmholtz energy in library units. ! Auxiliars INTEGER :: i INTEGER :: j INTEGER :: k ! Mole fractions REAL ( pr ) :: x ( SIZE ( n )) ! Total moles REAL ( pr ) :: n_tot ! Number of components INTEGER :: nc ! Average number of segments REAL ( pr ) :: m_ave ! Internal variables declarations ! Diameter declarations REAL ( pr ) :: d ( SIZE ( n )) ! Zetas declarations REAL ( pr ) :: zetas ( 0 : 3 ) REAL ( pr ) :: rho !! Number density [1/Angstrom&#94;3]. REAL ( pr ) :: eta ! Ar hard-sphere contribution declarations REAL ( pr ) :: term1_hs REAL ( pr ) :: term2_hs REAL ( pr ) :: term3_hs REAL ( pr ) :: ar_hs ! Ar chain contribution declarations REAL ( pr ) :: g_ii REAL ( pr ) :: di_2 REAL ( pr ) :: ar_chain ! Ar dispersion contribution declarations REAL ( pr ) :: rho_disp REAL ( pr ) :: m2_es3 REAL ( pr ) :: m2_e2s3 REAL ( pr ) :: i1 REAL ( pr ) :: i2 REAL ( pr ) :: c1 REAL ( pr ) :: term_disp REAL ( pr ) :: a_k REAL ( pr ) :: b_k REAL ( pr ) :: a1_term_disp REAL ( pr ) :: a2_term_disp REAL ( pr ) :: eps_ij REAL ( pr ) :: sig_ij REAL ( pr ) :: kij_val REAL ( pr ) :: ar_dispersion ! Attributes declarations as variables REAL ( pr ) :: m ( SIZE ( n )) REAL ( pr ) :: sigma ( SIZE ( n )) REAL ( pr ) :: epsilon_k ( SIZE ( n )) REAL ( pr ) :: kij ( SIZE ( n ), SIZE ( n )) INTRINSIC SUM INTRINSIC EXP INTRINSIC LOG INTRINSIC ALLOCATED INTRINSIC SQRT REAL ( pr ) :: arg1 INTRINSIC SIZE REAL ( pr ), DIMENSION ( SIZE ( n )) :: arg10 REAL ( pr ) :: result1 m = model % m sigma = model % sigma epsilon_k = model % epsilon_k kij = model % kij ! Residual Helmholtz free energy calculation ! Mole fractions x = n / SUM ( n ) ! Total moles n_tot = SUM ( n ) ! Number of components nc = SIZE ( n ) m_ave = 0.0_pr DO i = 1 , nc ! Segment average m_ave = m_ave + x ( i ) * m ( i ) END DO ! Diameter calculation DO i = 1 , SIZE ( n ) arg1 = - ( 3.0_pr * epsilon_k ( i ) / t ) d ( i ) = sigma ( i ) * ( 1.0_pr - 0.12_8 * EXP ( arg1 )) END DO ! Zetas calculation ! Number density [1/A&#94;3] rho = SUM ( n ) * n_avo / ( v * 1.0e27_pr ) zetas = 0.0_pr DO k = 0 , 3 arg10 = x * m * d ** k zetas ( k ) = rho * ( pi / 6.0_pr ) * SUM ( arg10 ) END DO eta = 1.0_pr - zetas ( 3 ) ! Ar hard-sphere contribution term1_hs = 3.0_pr * zetas ( 1 ) * zetas ( 2 ) / eta term2_hs = zetas ( 2 ) ** 3 / ( zetas ( 3 ) * eta ** 2 ) term3_hs = ( zetas ( 2 ) ** 3 / zetas ( 3 ) ** 2 - zetas ( 0 )) * LOG ( eta ) ! A_hs/RT ar_hs = 1.0_pr / zetas ( 0 ) * ( term1_hs + term2_hs + term3_hs ) ! Ar chain contribution ar_chain = 0.0_pr DO i = 1 , SIZE ( x ) di_2 = d ( i ) / 2.0_pr g_ii = 1.0_pr / eta + 3.0_8 * di_2 * zetas ( 2 ) / eta ** 2 + 2.0_8 * di_2 ** 2 * & & zetas ( 2 ) ** 2 / eta ** 3 ! Summation ar_chain = ar_chain - x ( i ) * ( m ( i ) - 1.0_pr ) * LOG ( g_ii ) END DO ! Ar dispersion contribution IF ( ALLOCATED ( model % kij )) THEN ! Number density [1/A&#94;3] rho_disp = n_tot * n_avo / ( v * 1.0e27_pr ) ! 1. Mixture Averages (Same as before) m2_es3 = 0.0_pr m2_e2s3 = 0.0_pr DO i = 1 , nc DO j = 1 , nc sig_ij = 0.5_pr * ( sigma ( i ) + sigma ( j )) kij_val = kij ( i , j ) arg1 = epsilon_k ( i ) * epsilon_k ( j ) result1 = SQRT ( arg1 ) eps_ij = result1 * ( 1.0_pr - kij_val ) term_disp = x ( i ) * x ( j ) * m ( i ) * m ( j ) * sig_ij ** 3 m2_es3 = m2_es3 + term_disp * ( eps_ij / t ) m2_e2s3 = m2_e2s3 + term_disp * ( eps_ij / t ) ** 2 END DO END DO ! 2. Integrals I1 and I2 (Same as before) i1 = 0.0_pr i2 = 0.0_pr DO k = 0 , 6 a_k = a_coeffs ( 0 , k ) + ( m_ave - 1.0_pr ) / m_ave * a_coeffs ( 1 , k ) + (& & m_ave - 1.0_pr ) / m_ave * ( m_ave - 2.0_pr ) / m_ave * a_coeffs ( 2 , k ) b_k = b_coeffs ( 0 , k ) + ( m_ave - 1.0_pr ) / m_ave * b_coeffs ( 1 , k ) + (& & m_ave - 1.0_pr ) / m_ave * ( m_ave - 2.0_pr ) / m_ave * b_coeffs ( 2 , k ) i1 = i1 + a_k * zetas ( 3 ) ** k i2 = i2 + b_k * zetas ( 3 ) ** k END DO ! 3. Compressibility C1 (Same as before) c1 = 1.0_pr + m_ave * ( 8.0_pr * zetas ( 3 ) - 2.0_pr * zetas ( 3 ) ** 2 ) / eta ** 4 c1 = c1 + ( 1.0_pr - m_ave ) * ( 2 0.0_pr * zetas ( 3 ) - 2 7.0_pr * zetas ( 3 ) ** 2 + & & 1 2.0_pr * zetas ( 3 ) ** 3 - 2.0_pr * zetas ( 3 ) ** 4 ) / (( 1.0_pr - zetas ( 3 )) * (& & 2.0_pr - zetas ( 3 ))) ** 2 c1 = 1._pr / c1 ! Eq. A.11 Gross & Sadowski (2001) ! 1st order term (Takes 2 * PI) a1_term_disp = - ( 2.0_pr * pi * rho_disp * i1 * m2_es3 ) ! 2nd order term (Takes 1 * PI and multiplies by m_ave) a2_term_disp = - ( 1.0_pr * pi * rho_disp * m_ave * c1 * i2 * m2_e2s3 ) ! Sum and make extensive ar_dispersion = a1_term_disp + a2_term_disp ELSE ar_dispersion = 0.0_pr END IF ! Final evaluation arval = r * t * n_tot * ( m_ave * ar_hs + ar_chain + ar_dispersion ) end subroutine AR type ( PCSAFT ) function init_pcsaft ( m , sigma , epsilon_k , kij ) result ( model ) !! # init_pcsaft !! !! # Description !! Create a PC-SAFT model. !! !! Computes the pure-component critical constants and acentric factors !! from the PC-SAFT parameters, so that the model can be used with the !! standard [[ArModel]] property and phase-equilibrium routines. use yaeos__equilibria_critical , only : get_critical_constants use yaeos__critical_pure_point_solver , only : find_critical_points_all_components real ( 8 ), intent ( in ) :: m (:) !! Number of segments real ( 8 ), intent ( in ) :: sigma (:) !! Segment diameter [Angstrom] real ( 8 ), intent ( in ) :: epsilon_k (:) !! Energy / k_B [K] real ( 8 ), intent ( in ), optional :: kij (:, :) !! Binary interaction parameters (optional) real ( pr ) :: Vc ( size ( m )) real ( pr ) :: Pc ( size ( m )) real ( pr ) :: Tc ( size ( m )) real ( pr ) :: w ( size ( m )) !! Acentric factors (not used; values are stored in `model%components%w`). logical :: converged ( size ( m )) !! Convergence flags of the pure-component critical-point solver. real ( pr ) :: P_sat_i real ( pr ) :: Vl real ( pr ) :: Vv integer :: i !! Loop/index variable. integer :: nc !! Number of components. nc = size ( m ) model % m = m model % sigma = sigma model % epsilon_k = epsilon_k if ( present ( kij )) then model % kij = kij else allocate ( model % kij ( nc , nc )) model % kij = 0 end if allocate ( model % components % Tc ( nc )) allocate ( model % components % Pc ( nc )) allocate ( model % components % w ( nc )) ! call get_critical_constants(model) call find_critical_points_all_components ( model , nc , Vc , Tc , Pc , converged ) model % components % Pc = Pc model % components % Tc = Tc do i = 1 , nc P_sat_i = model % Psat_pure ( i , 0.7 * Tc ( i ), Vl = Vl , Vv = Vv ) model % components % w ( i ) = ( - 1 - log10 ( P_sat_i / Pc ( i ))) end do end function init_pcsaft ! --------------------------------------------------------- ! Method get_v0: Volume lower limit (Covolume) ! Represents the physical volume occupied by the segments ! --------------------------------------------------------- function get_v0 ( self , n , P , T ) result ( v0 ) !! # get_v0 !! Return the close-packed segment volume used to initialize a volume solve. !! !! # Description !! Computes the volume at which the segment packing fraction would reach !! unity, V_0=(\\pi/6)N_A 10&#94;{-27}\\sum_i n_i m_i\\sigma_i&#94;3. This !! provides a composition-dependent lower-volume estimate for the liquid !! root; `P` and `T` are accepted to satisfy the `ArModel` initializer !! interface but are not used in this expression. !! !! # Examples !! The initializer is called internally by the inherited volume solver. class ( PCSAFT ), intent ( in ) :: self !! PC-SAFT model and segment data. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol]. real ( pr ), intent ( in ) :: P !! Pressure [bar]; unused in the close-packed initializer. real ( pr ), intent ( in ) :: T !! Temperature [K]; unused in the close-packed initializer. real ( pr ) :: v0 integer :: i !! Loop/index variable. real ( pr ) :: sum_seg_vol ! v0 = (Pi/6) * Sum(n_i * m_i * sigma_i&#94;3) * Factor_Conversion ! This makes zeta_3 = 1 if V = v0. sum_seg_vol = 0.0_pr do i = 1 , size ( n ) sum_seg_vol = sum_seg_vol + n ( i ) * self % m ( i ) * ( self % sigma ( i ) ** 3 ) end do ! Note: UNITS_FACTOR must be approx 0.000602214 to convert ! (mol * Ang&#94;3) to Liters. ! Make sure it matches the one used in 'calculate_zetas'. v0 = ( PI / 6.0_pr ) * UNITS_FACTOR * sum_seg_vol end function get_v0 subroutine volume ( eos , n , P , T , V , root_type ) !! # volume !! Find a PC-SAFT volume root at specified pressure and temperature. !! !! # Description !! Delegates to Michelsen's volume algorithm specialized for PC-SAFT. !! `root_type` selects the liquid, vapor, or stable root. !! !! # Examples !! ```fortran !! call model%volume(n, P, T, V, root_type=\"liquid\") !! ``` !! # References !! !! - [1] \"Thermodynamic Models: Fundamental and Computational Aspects\", !!  Michael L. Michelsen, Jørgen M. Mollerup. !!  Tie-Line Publications, Denmark (2004) !! [doi](http://dx.doi.org/10.1016/j.fluid.2005.11.032) use yaeos__constants , only : R use yaeos__math_linalg , only : cubic_roots , cubic_roots_rosendo use yaeos__models_solvers , only : volume_michelsen class ( PCSAFT ), intent ( in ) :: eos !! PC-SAFT equation-of-state model. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol]. real ( pr ), intent ( in ) :: P !! Pressure [bar]. real ( pr ), intent ( in ) :: T !! Temperature [K]. real ( pr ), intent ( out ) :: V !! Selected total volume [L]. character ( len =* ), intent ( in ) :: root_type !! Root selector: `liquid`, `vapor`, or `stable`. call volume_michelsen ( eos , n = n , P = P , T = T , V = V , root_type = root_type ) end subroutine volume end module YAEOS__MODELS_AR_SAFT_PCSAFT","tags":"","url":"sourcefile/pc_saft.f90.html"},{"title":"unifac.f90 – yaeos","text":"This file depends on sourcefile~~unifac.f90~~EfferentGraph sourcefile~unifac.f90 unifac.f90 sourcefile~constants.f90 constants.f90 sourcefile~unifac.f90->sourcefile~constants.f90 sourcefile~ge_models.f90 ge_models.f90 sourcefile~unifac.f90->sourcefile~ge_models.f90 sourcefile~groups.f90 groups.f90 sourcefile~unifac.f90->sourcefile~groups.f90 sourcefile~model_parameters.f90 model_parameters.f90 sourcefile~unifac.f90->sourcefile~model_parameters.f90 sourcefile~temperature_dependence.f90 temperature_dependence.f90 sourcefile~unifac.f90->sourcefile~temperature_dependence.f90 sourcefile~unifac_parameters.f90 unifac_parameters.f90 sourcefile~unifac.f90->sourcefile~unifac_parameters.f90 sourcefile~ge_models.f90->sourcefile~constants.f90 sourcefile~base.f90 base.f90 sourcefile~ge_models.f90->sourcefile~base.f90 sourcefile~groups.f90->sourcefile~constants.f90 sourcefile~model_parameters.f90->sourcefile~constants.f90 sourcefile~temperature_dependence.f90->sourcefile~constants.f90 sourcefile~temperature_dependence.f90->sourcefile~groups.f90 sourcefile~unifac_parameters.f90->sourcefile~constants.f90 sourcefile~unifac_parameters.f90->sourcefile~model_parameters.f90 sourcefile~substance.f90 substance.f90 sourcefile~base.f90->sourcefile~substance.f90 sourcefile~substance.f90->sourcefile~constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~unifac.f90~~AfferentGraph sourcefile~unifac.f90 unifac.f90 sourcefile~dortmund.f90 dortmund.f90 sourcefile~dortmund.f90->sourcefile~unifac.f90 sourcefile~implementations.f90 implementations.f90 sourcefile~implementations.f90->sourcefile~unifac.f90 sourcefile~implementations.f90->sourcefile~dortmund.f90 sourcefile~psrk.f90 psrk.f90 sourcefile~implementations.f90->sourcefile~psrk.f90 sourcefile~psrk.f90->sourcefile~unifac.f90 sourcefile~implementations.f90~2 implementations.f90 sourcefile~implementations.f90~2->sourcefile~implementations.f90 sourcefile~models.f90 models.f90 sourcefile~models.f90->sourcefile~implementations.f90 sourcefile~models.f90->sourcefile~implementations.f90~2 sourcefile~gerg2008.f90 gerg2008.f90 sourcefile~models.f90->sourcefile~gerg2008.f90 sourcefile~fluids.f90 fluids.f90 sourcefile~fluids.f90->sourcefile~models.f90 sourcefile~gerg2008.f90->sourcefile~implementations.f90~2 sourcefile~yaeos.f90 yaeos.f90 sourcefile~yaeos.f90->sourcefile~models.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module yaeos__models_ge_group_contribution_unifac !! # UNIFAC module !! Classic liquid-vapor UNIFAC model implementation module. !! !! # Description !! Classic liquid-vapor UNIFAC model implementation module. The !! implementation is based on the Thermopack library (SINTEF) implementation. !! !! # Examples !! !! ```fortran !!  ! Instantiate an UNIFAC model with ethanol-water mix and calculate gammas !!  use yaeos, only: pr, Groups, setup_unifac, UNIFAC !! !!  type(UNIFAC) :: model !!  type(Groups) :: molecules(2) !!  real(pr) :: ln_gammas(2) !! !!  ! Ethanol definition [CH3, CH2, OH] !!  molecules(1)%groups_ids = [1, 2, 14] ! Subgroups ids !!  molecules(1)%number_of_groups = [1, 1, 1] ! Subgroups occurrences !! !!  ! Water definition [H2O] !!  molecules(2)%groups_ids = [16] !!  molecules(2)%number_of_groups = [1] !! !!  ! Model setup !!  model = setup_unifac(molecules) !! !!  ! Calculate ln_gammas !!  call model%ln_activity_coefficient([0.5_pr, 0.5_pr], 298.0_pr, ln_gammas) !! !!  print *, ln_gammas ! result: 0.18534142000449058    0.40331395945417559 !! ``` !! !! # References !! 1. [Dortmund Data Bank Software & Separation Technology](https://www.ddbst.com/published-parameters-unifac.html) !! 2. Fredenslund, A., Jones, R. L., & Prausnitz, J. M. (1975). !! Group‐contribution estimation of activity coefficients in nonideal liquid !! mixtures. AIChE Journal, 21(6), 1086–1099. !! [https://doi.org/10.1002/aic.690210607](https://doi.org/10.1002/aic.690210607) !! 3. Skjold-Jorgensen, S., Kolbe, B., Gmehling, J., & Rasmussen, P. (1979). !! Vapor-Liquid Equilibria by UNIFAC Group Contribution. Revision and !! Extension. Industrial & Engineering Chemistry Process Design and !! Development, 18(4), 714–722. !! [https://doi.org/10.1021/i260072a024](https://doi.org/10.1021/i260072a024) !! 4. Gmehling, J., Rasmussen, P., & Fredenslund, A. (1982). Vapor-liquid !! equilibriums by UNIFAC group contribution. Revision and extension. 2. !! Industrial & Engineering Chemistry Process Design and Development, 21(1), !! 118–127. !! [https://doi.org/10.1021/i200016a021](https://doi.org/10.1021/i200016a021) !! 5. Macedo, E. A., Weidlich, U., Gmehling, J., & Rasmussen, P. (1983). !! Vapor-liquid equilibriums by UNIFAC group contribution. Revision and !! extension. 3. Industrial & Engineering Chemistry Process Design and !! Development, 22(4), 676–678. !! [https://doi.org/10.1021/i200023a023](https://doi.org/10.1021/i200023a023) !! 6. Tiegs, D., Rasmussen, P., Gmehling, J., & Fredenslund, A. (1987). !! Vapor-liquid equilibria by UNIFAC group contribution. 4. Revision and !! extension. Industrial & Engineering Chemistry Research, 26(1), 159–161. !! [https://doi.org/10.1021/ie00061a030](https://doi.org/10.1021/ie00061a030) !! 7. Hansen, H. K., Rasmussen, P., Fredenslund, A., Schiller, M., & !! Gmehling, J. (1991). Vapor-liquid equilibria by UNIFAC group !! contribution. 5. Revision and extension. Industrial & Engineering !! Chemistry Research, 30 (10), 2352–2355. !! [https://doi.org/10.1021/ie00058a017](https://doi.org/10.1021/ie00058a017) !! 8. Wittig, R., Lohmann, J., & Gmehling, J. (2003). Vapor−Liquid Equilibria !! by UNIFAC Group Contribution. 6. Revision and Extension. Industrial & !! Engineering Chemistry Research, 42(1), 183–188. !! [https://doi.org/10.1021/ie020506l](https://doi.org/10.1021/ie020506l) !! 9. [SINTEF - Thermopack](https://github.com/thermotools/thermopack) !! use yaeos__constants , only : pr , R use yaeos__models_ge , only : GeModel use yaeos__models_ge_group_contribution_model_parameters , only : GeGCModelParameters use yaeos__models_ge_group_contribution_unifac_parameters , only : UNIFACParameters use yaeos__models_ge_gc_td , only : PsiFunction , UNIFACPsi use yaeos__models_ge_group_contribution_groups , only : Groups implicit none type , extends ( GeModel ) :: UNIFAC !! # UNIFAC model !! Classic liquid-vapor UNIFAC model derived type !! !! # Description !! This type holds the needed parameters for using a UNIFAC G&#94;E model !! mainly group areas, volumes and what temperature dependence function !! \\psi(T) to use. !! !! It also holds the individual molecules of a particular system and !! the set of all groups in the system as a \"stew\" of groups instead of !! being them included in particular molecules. !! !! # Examples !! !! ```fortran !!  ! UNIFAC model with ethanol-formic acid mix and calculate gammas !!  use yaeos, only: pr, Groups, setup_unifac, UNIFAC !! !!  type(UNIFAC) :: model !!  type(Groups) :: molecules(2) !!  real(pr) :: ln_gammas(2) !! !!  ! Ethanol definition [CH3, CH2, OH] !!  molecules(1)%groups_ids = [1, 2, 14] ! Subgroups ids !!  molecules(1)%number_of_groups = [1, 1, 1] ! Subgroups occurrences !! !!  ! formic acid definition [HCOOH] !!  molecules(2)%groups_ids = [43] !!  molecules(2)%number_of_groups = [1] !! !!  ! Model setup !!  model = setup_unifac(molecules) !! !!  ! Calculate ln_gammas !!  call model%ln_activity_coefficient([0.5_pr, 0.5_pr], 298.0_pr, ln_gammas) !! !!  print *, ln_gammas ! result: 0.10505475697637946   0.28073129552766890 !! ``` !! !! # References !! 1. [Dortmund Data Bank Software & Separation Technology](https://www.ddbst.com/published-parameters-unifac.html) !! 2. Fredenslund, A., Jones, R. L., & Prausnitz, J. M. (1975). !! Group‐contribution estimation of activity coefficients in nonideal liquid !! mixtures. AIChE Journal, 21(6), 1086–1099. !! [https://doi.org/10.1002/aic.690210607](https://doi.org/10.1002/aic.690210607) !! 3. Skjold-Jorgensen, S., Kolbe, B., Gmehling, J., & Rasmussen, P. (1979). !! Vapor-Liquid Equilibria by UNIFAC Group Contribution. Revision and !! Extension. Industrial & Engineering Chemistry Process Design and !! Development, 18(4), 714–722. !! [https://doi.org/10.1021/i260072a024](https://doi.org/10.1021/i260072a024) !! 4. Gmehling, J., Rasmussen, P., & Fredenslund, A. (1982). Vapor-liquid !! equilibriums by UNIFAC group contribution. Revision and extension. 2. !! Industrial & Engineering Chemistry Process Design and Development, 21(1), !! 118–127. !! [https://doi.org/10.1021/i200016a021](https://doi.org/10.1021/i200016a021) !! 5. Macedo, E. A., Weidlich, U., Gmehling, J., & Rasmussen, P. (1983). !! Vapor-liquid equilibriums by UNIFAC group contribution. Revision and !! extension. 3. Industrial & Engineering Chemistry Process Design and !! Development, 22(4), 676–678. !! [https://doi.org/10.1021/i200023a023](https://doi.org/10.1021/i200023a023) !! 6. Tiegs, D., Rasmussen, P., Gmehling, J., & Fredenslund, A. (1987). !! Vapor-liquid equilibria by UNIFAC group contribution. 4. Revision and !! extension. Industrial & Engineering Chemistry Research, 26(1), 159–161. !! [https://doi.org/10.1021/ie00061a030](https://doi.org/10.1021/ie00061a030) !! 7. Hansen, H. K., Rasmussen, P., Fredenslund, A., Schiller, M., & !! Gmehling, J. (1991). Vapor-liquid equilibria by UNIFAC group !! contribution. 5. Revision and extension. Industrial & Engineering !! Chemistry Research, 30 (10), 2352–2355. !! [https://doi.org/10.1021/ie00058a017](https://doi.org/10.1021/ie00058a017) !! 8. Wittig, R., Lohmann, J., & Gmehling, J. (2003). Vapor−Liquid Equilibria !! by UNIFAC Group Contribution. 6. Revision and Extension. Industrial & !! Engineering Chemistry Research, 42(1), 183–188. !! [https://doi.org/10.1021/ie020506l](https://doi.org/10.1021/ie020506l) !! 9. [SINTEF - Thermopack](https://github.com/thermotools/thermopack) !! integer :: ngroups !! Total number of individual groups in the mixture integer :: nmolecules !! Total number of molecules in the mixture real ( pr ) :: z = 1 0.0_pr !! Model constant z real ( pr ) :: d = 1.0_pr !! Model constant d, exponent of the group volume in Flory-Huggins real ( pr ), allocatable :: group_area (:) !! Group areas Q_k real ( pr ), allocatable :: group_volume (:) !! Group volumes R_k real ( pr ), allocatable :: thetas_ij (:, :) !! Area fractions of the groups j on molecules i real ( pr ), allocatable :: vij (:,:) !! Ocurrences of each group j on each molecule i real ( pr ), allocatable :: qk (:) !! Area of each group k class ( PsiFunction ), allocatable :: psi_function !! Temperature dependance function of the model type ( Groups ), allocatable :: molecules (:) !! Substances present in the system type ( Groups ) :: groups_stew !! All the groups present in the system contains procedure :: excess_gibbs procedure :: Ge_combinatorial procedure :: Ge_residual end type UNIFAC contains subroutine excess_gibbs ( self , n , T , Ge , GeT , GeT2 , Gen , GeTn , Gen2 ) !! # Excess Gibbs energy !! Calculate the Gibbs excess energy of the UNIFAC model !! !! # Description !! Calculate the Gibbs excess energy of the UNIFAC model and its !! derivatives. !! !! # Examples !! !! ```fortran !!  ! Gibbs excess of ethane-ethanol-methyl amine mixture. !!  use yaeos, only: R, pr, Groups, setup_unifac, UNIFAC !! !!  type(UNIFAC) :: model !! !!  integer, parameter :: nc = 3 !! !!  type(Groups) :: molecules(nc) !! !!  real(pr) :: Ge !!  real(pr) :: Gen(nc) !!  real(pr) :: GeT !!  real(pr) :: GeT2 !!  real(pr) :: GeTn(nc) !!  real(pr) :: Gen2(nc, nc) !! !!  real(pr) :: n(nc) !!  real(pr) :: ln_gammas(nc) !!  real(pr) :: T !! !!  T = 150.0_pr !!  n = [2.0_pr, 7.0_pr, 1.0_pr] !! !!  ! Ethane [CH3] !!  molecules(1)%groups_ids = [1] !!  molecules(1)%number_of_groups = [2] !! !!  ! Ethanol [CH3, CH2, OH] !!  molecules(2)%groups_ids = [1, 2, 14] !!  molecules(2)%number_of_groups = [1, 1, 1] !! !!  ! Methylamine [H3C-NH2] !!  molecules(3)%groups_ids = [28] !!  molecules(3)%number_of_groups = [1] !! !!  ! setup UNIFAC model !!  model = setup_unifac(molecules) !! !!  ! Call all Ge and derivatives !!  call model%excess_gibbs(n, T, Ge, GeT, GeT2, Gen, GeTn, Gen2) !! !!  print *, \"Ge: \", Ge !!  print *, \"GeT: \", GeT !!  print *, \"GeT2: \", GeT2 !!  print *, \"Gen: \", Gen !!  print *, \"GeTn: \", GeTn !!  print *, \"Gen2:\" !!  print *, Gen2(1,:) !!  print *, Gen2(2,:) !!  print *, Gen2(3,:) !! !!  ! If you want the ln_gammas from \"Gen\" derivative: !!  print *, \"ln_gammas: \", Gen / R / T !! !!  ! Or !!  call model%ln_activity_coefficient(n, T, ln_gammas) !!  print *, \"ln_gammas: \", ln_gammas !! ``` !! class ( UNIFAC ), intent ( in ) :: self !! UNIFAC model real ( pr ), intent ( in ) :: n (:) !! Moles vector [mol] real ( pr ), intent ( in ) :: T !! Temperature [K] real ( pr ), optional , intent ( out ) :: Ge !! Excess Gibbs energy real ( pr ), optional , intent ( out ) :: GeT !! \\frac{dG&#94;E}{dT} real ( pr ), optional , intent ( out ) :: GeT2 !! \\frac{d&#94;2G&#94;E}{dT&#94;2} real ( pr ), optional , intent ( out ) :: Gen ( size ( n )) !! \\frac{dG&#94;E}{dn} real ( pr ), optional , intent ( out ) :: GeTn ( size ( n )) !! \\frac{d&#94;2G&#94;E}{dTdn} real ( pr ), optional , intent ( out ) :: Gen2 ( size ( n ), size ( n )) !! \\frac{d&#94;2G&#94;E}{dn&#94;2} ! Combinatorial real ( pr ) :: Ge_c real ( pr ) :: dGe_c_dn ( self % nmolecules ) real ( pr ) :: dGe_c_dn2 ( self % nmolecules , self % nmolecules ) ! logical logical :: pge logical :: dn logical :: dn2 ! Residual calling call self % Ge_residual ( n , T , Ge , Gen , Gen2 , GeT , GeT2 , GeTn ) ! Individual combinatorial calling pge = present ( Ge ) dn = present ( Gen ) dn2 = present ( Gen2 ) if ( dn . and . . not . dn2 ) then call self % Ge_combinatorial ( n , T , Ge = Ge_c , dGe_dn = dGe_c_dn ) elseif ( dn2 . and . . not . dn ) then call self % Ge_combinatorial ( n , T , Ge = Ge_c , dGe_dn2 = dGe_c_dn2 ) else call self % Ge_combinatorial (& n , T , Ge = Ge_c , dGe_dn = dGe_c_dn , dGe_dn2 = dGe_c_dn2 & ) end if if ( present ( Ge )) Ge = Ge_c + Ge if ( present ( Gen )) Gen = dGe_c_dn + Gen if ( present ( Gen2 )) Gen2 = dGe_c_dn2 + Gen2 if ( present ( GeT )) GeT = Ge_c / T + GeT if ( present ( GeT2 )) GeT2 = GeT2 if ( present ( GeTn )) GeTn = dGe_c_dn / T + GeTn end subroutine excess_gibbs subroutine Ge_combinatorial ( self , n , T , Ge , dGe_dn , dGe_dn2 ) !! # UNIFAC combinatorial term !! Calculate the UNIFAC combinatorial term of Gibbs excess energy !! !! # Description !! Calculate the UNIFAC combinatorial term of reduced Gibbs excess !! energy. The subroutine uses the Flory-Huggins and !! Staverman-Guggenheim terms. !! !! # References !! 1. [SINTEF - Thermopack](https://github.com/thermotools/thermopack) class ( UNIFAC ) :: self real ( pr ), intent ( in ) :: n ( self % nmolecules ) !! Moles vector [mol] real ( pr ), intent ( in ) :: T !! Temperature [K] real ( pr ), optional , intent ( out ) :: Ge !! Combinatorial Gibbs excess energy real ( pr ), optional , intent ( out ) :: dGe_dn ( self % nmolecules ) !! \\frac{dGe}{dn} real ( pr ), optional , intent ( out ) :: dGe_dn2 ( self % nmolecules , self % nmolecules ) !! \\frac{d&#94;2Ge}{dn&#94;2} ! Flory-Huggins variables real ( pr ) :: Ge_fh real ( pr ) :: dGe_fh_dn ( self % nmolecules ) real ( pr ) :: dGe_fh_dn2 ( self % nmolecules , self % nmolecules ) ! Staverman-Guggenheim variables real ( pr ) :: Ge_sg real ( pr ) :: dGe_sg_dn ( self % nmolecules ) real ( pr ) :: dGe_sg_dn2 ( self % nmolecules , self % nmolecules ) ! utility real ( pr ) :: nq real ( pr ) :: nr real ( pr ) :: nrp real ( pr ) :: n_t integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. associate (& q => self % molecules % surface_area ,& r => self % molecules % volume ,& z => self % z , & d => self % d & ) nr = dot_product ( n , r ) nrp = dot_product ( n , r ** d ) nq = dot_product ( n , q ) n_t = sum ( n ) if ( present ( Ge )) then Ge_fh = sum ( n * log ( r ** d )) - n_t * log ( nrp ) + n_t * log ( n_t ) Ge_sg = z / 2 * sum ( n * q * ( log ( q / r ) - log ( nq ) + log ( nr ))) end if if ( present ( dGe_dn )) then dGe_fh_dn = log ( r ** d ) - log ( nrp ) + log ( n_t ) + 1.0_pr - n_t * r ** d / nrp dGe_sg_dn = z / 2 * q * ( - log (( r * nq ) / ( q * nr )) - 1.0_pr + ( r * nq ) / ( q * nr )) end if if ( present ( dGe_dn2 )) then dGe_fh_dn2 = 0.0_pr dGe_sg_dn2 = 0.0_pr do concurrent ( i = 1 : size ( n ), j = 1 : size ( n )) dGe_fh_dn2 ( i , j ) = - ( r ( i ) ** d + r ( j ) ** d ) / nrp + 1.0_pr / n_t + n_t * r ( i ) ** d * r ( j ) ** d / nrp ** 2 dGe_sg_dn2 ( i , j ) = z / 2.0_pr * ( - q ( i ) * q ( j ) / nq + ( q ( i ) * r ( j ) + q ( j ) * r ( i )) / nr - r ( i ) * r ( j ) * nq / nr ** 2 ) end do end if end associate if ( present ( Ge )) Ge = ( Ge_fh + Ge_sg ) * R * T if ( present ( dGe_dn )) dGe_dn = ( dGe_fh_dn + dGe_sg_dn ) * R * T if ( present ( dGe_dn2 )) dGe_dn2 = ( dGe_fh_dn2 + dGe_sg_dn2 ) * R * T end subroutine Ge_combinatorial subroutine Ge_residual ( self , n , T , Ge , dGe_dn , dGe_dn2 , dGe_dT , dGe_dT2 , dGe_dTn ) !! # UNIFAC residual term !! Evaluate the UNIFAC residual term !! !! # References !! 1. [SINTEF - Thermopack](https://github.com/thermotools/thermopack) class ( UNIFAC ) :: self real ( pr ), intent ( in ) :: n ( self % nmolecules ) !! Moles vector real ( pr ), intent ( in ) :: T !! Temperature [K] real ( pr ), optional , intent ( out ) :: Ge !! Residual Gibbs excess energy real ( pr ), optional , intent ( out ) :: dGe_dn ( self % nmolecules ) !! \\frac{\\partial G&#94;{E,R}}{\\partial n}  real ( pr ), optional , intent ( out ) :: dGe_dn2 ( self % nmolecules , self % nmolecules ) !! \\frac{\\partial&#94;2 G&#94;{E,R}}{\\partial n&#94;2}  real ( pr ), optional , intent ( out ) :: dGe_dT !! \\frac{\\partial G&#94;{E,R}}{\\partial T}  real ( pr ), optional , intent ( out ) :: dGe_dT2 !! \\frac{\\partial&#94;2 G&#94;{E,R}}{\\partial T&#94;2}  real ( pr ), optional , intent ( out ) :: dGe_dTn ( self % nmolecules ) !! \\frac{\\partial&#94;2 G&#94;{E,R}}{\\partial n \\partial T}  ! Thetas variables real ( pr ) :: theta_j ( self % ngroups ) ! Ejk variables real ( pr ) :: Ejk ( self % ngroups , self % ngroups ) real ( pr ) :: dEjk_dt ( self % ngroups , self % ngroups ) real ( pr ) :: dEjk_dt2 ( self % ngroups , self % ngroups ) ! Lambdas variables real ( pr ) :: lambda_k ( self % ngroups ) real ( pr ) :: dlambda_k_dT ( self % ngroups ) real ( pr ) :: dlambda_k_dT2 ( self % ngroups ) real ( pr ) :: dlambda_k_dn ( self % nmolecules , self % ngroups ) real ( pr ) :: dlambda_k_dn2 ( self % nmolecules , self % nmolecules , self % ngroups ) real ( pr ) :: dlambda_k_dndT ( self % nmolecules , self % ngroups ) real ( pr ) :: lambda_ik ( self % nmolecules , self % ngroups ) real ( pr ) :: dlambda_ik_dT ( self % nmolecules , self % ngroups ) real ( pr ) :: dlambda_ik_dT2 ( self % nmolecules , self % ngroups ) ! Auxiliars real ( pr ) :: Ge_aux real ( pr ) :: dGe_dT_aux real ( pr ) :: dGe_dn_aux ( self % nmolecules ) real ( pr ) :: sum_vij_Qj_Ejk ( self % nmolecules , self % ngroups ) real ( pr ) :: sum_ni_vij_Qj_Ejk ( self % ngroups ) real ( pr ) :: sum_vik_Qk ( self % nmolecules ) real ( pr ) :: sum_vQ_Lambda ( self % nmolecules ) real ( pr ) :: sum_nl_vlj ( self % ngroups ) real ( pr ) :: sum_ni_vik_Qk real ( pr ) :: aux_sum ( self % nmolecules ) real ( pr ) :: sum_Q_v_dlambda_k_dn ( self % nmolecules , self % nmolecules ) real ( pr ) :: aux_sum2 real ( pr ) :: sum_vij_Qj_dEjk_dT ( self % nmolecules , self % ngroups ) real ( pr ) :: sum_vij_Qj_dEjk_dT2 ( self % nmolecules , self % ngroups ) real ( pr ) :: sum_ni_vij_Qj_dEjk_dT ( self % ngroups ) real ( pr ) :: sum_vij_Qj_dlambdas_dT ( self % nmolecules ) real ( pr ) :: sum_vij_Qj_dlambdas_dT2 ( self % nmolecules ) ! Indexes used for groups integer :: j !! Group index. integer :: k !! Group index. ! Indexes used for components integer :: i !! Component index. integer :: l !! Component index. ! logicals logical :: pge logical :: dn logical :: dn2 logical :: dt logical :: dt2 logical :: dtn pge = present ( Ge ) dn = present ( dGe_dn ) dn2 = present ( dGe_dn2 ) dt = present ( dGe_dT ) dt2 = present ( dGe_dT2 ) dtn = present ( dGe_dTn ) ! ======================================================================== ! Ejk ! ------------------------------------------------------------------------ ! if ((dt .or. dtn) .and. .not. dt2) then !    call self%psi_function%psi(& !       self%groups_stew, T, psi=Ejk, dpsi_dt=dEjk_dt & !       ) ! elseif (dt2 .and. .not. (dt .or. dtn)) then !    call self%psi_function%psi(& !       self%groups_stew, T, psi=Ejk, dpsi_dt2=dEjk_dt2 & !       ) ! else !    call self%psi_function%psi(& !       self%groups_stew, T, psi=Ejk, dpsi_dt=dEjk_dt, dpsi_dt2=dEjk_dt2 & !       ) ! end if call self % psi_function % psi (& self % groups_stew , T , psi = Ejk , dpsi_dt = dEjk_dt , dpsi_dt2 = dEjk_dt2 & ) ! ======================================================================== ! Auxiliars ! ------------------------------------------------------------------------ do i = 1 , self % nmolecules sum_vik_Qk ( i ) = sum ( self % vij ( i ,:) * self % qk ) end do sum_ni_vik_Qk = sum ( n * sum_vik_Qk ) if ( dtn . or . dt2 . or . dt ) then do concurrent ( i = 1 : self % nmolecules , k = 1 : self % ngroups ) sum_vij_Qj_dEjk_dT ( i , k ) = sum ( self % vij ( i ,:) * self % qk * dEjk_dT (:, k )) sum_vij_Qj_dEjk_dT2 ( i , k ) = sum ( self % vij ( i ,:) * self % qk * dEjk_dT2 (:, k )) end do end if ! ======================================================================== ! Thetas ! ------------------------------------------------------------------------ do j = 1 , self % ngroups sum_nl_vlj ( j ) = sum ( n * self % vij (:, j )) theta_j ( j ) = sum_nl_vlj ( j ) * self % qk ( j ) / sum_ni_vik_Qk end do ! ======================================================================== ! Lambda_k ! ------------------------------------------------------------------------ ! Lambda_k if ( pge . or . dn . or . dt . or . dtn ) then do k = 1 , self % ngroups lambda_k ( k ) = log ( sum ( theta_j * Ejk (:, k ))) end do end if ! Lambda_k first compositional derivatives if ( dn . or . dt . or . dt2 . or . dtn . or . dn2 ) then do concurrent ( i = 1 : self % nmolecules , k = 1 : self % ngroups ) sum_vij_Qj_Ejk ( i , k ) = sum ( self % vij ( i ,:) * self % qk * Ejk (:, k )) end do do k = 1 , self % ngroups sum_ni_vij_Qj_Ejk ( k ) = sum ( n * sum_vij_Qj_Ejk (:, k )) end do do i = 1 , self % nmolecules dlambda_k_dn ( i ,:) = sum_vij_Qj_Ejk ( i ,:) / sum_ni_vij_Qj_Ejk - sum_vik_Qk ( i ) / sum_ni_vik_Qk end do end if ! Lambda_k second compositional derivatives if ( dn2 ) then do concurrent ( i = 1 : self % nmolecules , l = 1 : self % nmolecules ) sum_Q_v_dlambda_k_dn ( i , l ) = sum ( self % qk * self % vij ( l ,:) * dlambda_k_dn ( i ,:)) dlambda_k_dn2 ( i , l ,:) = (& - sum_vij_Qj_Ejk ( i ,:) * sum_vij_Qj_Ejk ( l ,:) / sum_ni_vij_Qj_Ejk ** 2 & + sum_vik_Qk ( i ) * sum_vik_Qk ( l ) / sum_ni_vik_Qk ** 2 & ) end do end if ! Temperature derivatives if ( dt . or . dtn . or . dt2 ) then do k = 1 , self % ngroups sum_ni_vij_Qj_dEjk_dT ( k ) = sum ( n * sum_vij_Qj_dEjk_dT (:, k )) dlambda_k_dT ( k ) = sum ( theta_j * dEjk_dt (:, k )) / sum ( theta_j * Ejk (:, k )) dlambda_k_dT2 ( k ) = sum ( n * sum_vij_Qj_dEjk_dT2 (:, k )) / sum_ni_vij_Qj_Ejk ( k ) - dlambda_k_dT ( k ) ** 2 end do end if if ( dtn ) then do i = 1 , self % nmolecules dlambda_k_dndT ( i ,:) = (& sum_vij_Qj_dEjk_dT ( i ,:) / sum_ni_vij_Qj_Ejk & - sum_vij_Qj_Ejk ( i ,:) * sum_ni_vij_Qj_dEjk_dT / sum_ni_vij_Qj_Ejk ** 2 & ) end do end if ! ======================================================================== ! Lambda_ik ! ------------------------------------------------------------------------ if ( pge . or . dn . or . dt . or . dtn ) then lambda_ik = 0.0_pr do concurrent ( i = 1 : self % nmolecules , k = 1 : self % ngroups ) if ( self % vij ( i , k ) /= 0 ) then lambda_ik ( i , k ) = log ( sum ( self % thetas_ij ( i , :) * Ejk (:, k ))) end if end do end if ! Temperature derivatives if ( dt . or . dt2 . or . dtn ) then dlambda_ik_dT = 0.0_pr do concurrent ( i = 1 : self % nmolecules , k = 1 : self % ngroups ) if ( self % vij ( i , k ) /= 0 ) then dlambda_ik_dT ( i , k ) = sum ( self % thetas_ij ( i ,:) * dEjk_dt (:, k )) / sum ( self % thetas_ij ( i ,:) * Ejk (:, k )) end if end do if ( dt2 ) dlambda_ik_dT2 = sum_vij_Qj_dEjk_dT2 / sum_vij_Qj_Ejk - dlambda_ik_dT * dlambda_ik_dT end if ! ======================================================================== ! Ge ! ------------------------------------------------------------------------ if ( pge . or . dn . or . dt . or . dtn ) then do i = 1 , self % nmolecules sum_vQ_Lambda ( i ) = sum ( self % vij ( i ,:) * self % qk * ( lambda_k - lambda_ik ( i ,:))) end do Ge_aux = - sum ( n * sum_vQ_Lambda ) end if ! ======================================================================== ! dGe_dn ! ------------------------------------------------------------------------ if ( dn . or . dtn ) then do i = 1 , self % nmolecules aux_sum ( i ) = sum ( sum_nl_vlj * self % qk * dlambda_k_dn ( i ,:)) end do dGe_dn_aux = - sum_vQ_Lambda - aux_sum end if ! ======================================================================== ! dGe_dn2 ! ------------------------------------------------------------------------ if ( dn2 ) then do concurrent ( i = 1 : self % nmolecules , l = 1 : self % nmolecules ) aux_sum2 = sum ( sum_nl_vlj * dlambda_k_dn2 ( i , l ,:) * self % qk ) dGe_dn2 ( i , l ) = - ( sum_Q_v_dlambda_k_dn ( i , l ) + sum_Q_v_dlambda_k_dn ( l , i )) - aux_sum2 end do end if ! ======================================================================== ! dGe_dT, dGe_dT2, dGE_dnT ! ------------------------------------------------------------------------ if ( dt . or . dt2 . or . dtn ) then do i = 1 , self % nmolecules sum_vij_Qj_dlambdas_dT ( i ) = sum ( self % vij ( i ,:) * self % qk * ( dlambda_k_dT - dlambda_ik_dT ( i ,:))) end do dGe_dT_aux = - sum ( n * sum_vij_Qj_dlambdas_dT ) end if if ( dt2 ) then do i = 1 , self % nmolecules sum_vij_Qj_dlambdas_dT2 ( i ) = sum ( self % vij ( i ,:) * self % qk * ( dlambda_k_dT2 - dlambda_ik_dT2 ( i ,:))) end do dGe_dT2 = - sum ( n * sum_vij_Qj_dlambdas_dT2 ) end if if ( dtn ) then do i = 1 , self % nmolecules aux_sum ( i ) = sum ( sum_nl_vlj * self % qk * dlambda_k_dndT ( i ,:)) end do dGe_dTn = - sum_vij_Qj_dLambdas_dT - aux_sum end if ! ======================================================================== ! From reduced Ge to Ge ! ------------------------------------------------------------------------ if ( present ( Ge )) then Ge = Ge_aux * R * T end if if ( present ( dGe_dT )) then dGe_dT = R * ( Ge_aux + dGe_dT_aux * T ) end if if ( present ( dGe_dT2 )) then dGe_dT2 = R * ( 2.0 * dGe_dT_aux + T * dGe_dT2 ) end if if ( present ( dGe_dTn )) then dGe_dTn = R * ( dGe_dn_aux + dGe_dTn * T ) end if if ( present ( dGe_dn )) then dGe_dn = dGe_dn_aux * R * T end if if ( present ( dGe_dn2 )) then dGe_dn2 = dGe_dn2 * R * T end if end subroutine Ge_residual function thetas_i ( nm , ng , parameters , stew , molecules ) result ( thetas_ij ) !! # \\Theta_i  calculation !! Calculate the area fraction of each group on each molecule. !! !! # Description !! Calculate the area fraction of each group on each molecule. The values !! are obtained on the setup_unifac function and stored on the UNIFAC !! type, since the values can be reused (no compositional or temperature !! dependence) !! !! # References !! 1. [SINTEF - Thermopack](https://github.com/thermotools/thermopack) integer , intent ( in ) :: nm !! Number of molecules integer , intent ( in ) :: ng !! Number of groups type ( GeGCModelParameters ), intent ( in ) :: parameters !! UNIFAC parameters type ( Groups ), intent ( in ) :: stew !! All the groups present in the system type ( Groups ), intent ( in ) :: molecules (:) !! Molecules real ( pr ) :: thetas_ij ( nm , ng ) !! Group j area fraction on molecule i real ( pr ) :: total_area_i ( nm ) real ( pr ) :: qki_contribution integer :: gi integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. integer :: k !! Loop index `k`. thetas_ij = 0.0_pr total_area_i = 0.0_pr ! Obtain the total area of each molecule do i = 1 , size ( molecules ) do k = 1 , size ( molecules ( i )% number_of_groups ) gi = molecules ( i )% groups_ids ( k ) ! Contribution of the group k to the molecule i area. qki_contribution = (& parameters % get_subgroup_Q ( gi ) * molecules ( i )% number_of_groups ( k )& ) ! Adding to the total area of each molecule total_area_i ( i ) = total_area_i ( i ) + qki_contribution end do end do ! Calculate the fraction of each group on each molecule thetas_ij = 0.0_pr do i = 1 , size ( molecules ) do k = 1 , size ( molecules ( i )% number_of_groups ) gi = molecules ( i )% groups_ids ( k ) j = findloc ( stew % groups_ids , gi , dim = 1 ) thetas_ij ( i , j ) = (& parameters % get_subgroup_Q ( gi ) & * molecules ( i )% number_of_groups ( k ) & / total_area_i ( i ) & ) end do end do end function thetas_i type ( UNIFAC ) function setup_unifac ( molecules , parameters ) !! # Setup UNIFAC !! Instantiate a UNIFAC model !! !! # Description !! Subroutine used to instantiate a UNIFAC model. !! !! # Examples !! !! ```fortran !!  ! Instantiate an UNIFAC model with ethanol-water mix and calculate gammas !!  use yaeos, only: pr, Groups, setup_unifac, UNIFAC !! !!  type(UNIFAC) :: model !!  type(Groups) :: molecules(2) !!  real(pr) :: ln_gammas(2) !! !!  ! Ethanol definition [CH3, CH2, OH] !!  molecules(1)%groups_ids = [1, 2, 14] ! Subgroups ids !!  molecules(1)%number_of_groups = [1, 1, 1] ! Subgroups occurrences !! !!  ! Water definition [H2O] !!  molecules(2)%groups_ids = [16] !!  molecules(2)%number_of_groups = [1] !! !!  ! Model setup !!  model = setup_unifac(molecules) !! !!  ! Calculate ln_gammas !!  call model%ln_activity_coefficient([0.5_pr, 0.5_pr], 298.0_pr, ln_gammas) !! !!  print *, ln_gammas ! result: 0.18534142000449058    0.40331395945417559 !! ``` !! !! # References !! 1. [Dortmund Data Bank Software & Separation Technology](https://www.ddbst.com/published-parameters-unifac.html) !! type ( Groups ), intent ( in ) :: molecules (:) !! Molecules (Group type) objects type ( GeGCModelParameters ), optional , intent ( in ) :: parameters !! UNIFAC parameters type ( Groups ) :: soup type ( UNIFACPsi ) :: psi_function ! UNIFAC parameters type ( GeGCModelParameters ) :: params ! Usefull matrixes to store integer , allocatable :: vij (:, :) real ( pr ), allocatable :: qks (:) real ( pr ), allocatable :: Aij (:, :) integer :: gi integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. integer :: k !! Loop index `k`. setup_unifac % molecules = molecules allocate ( soup % groups_ids ( 0 )) allocate ( soup % number_of_groups ( 0 )) ! ======================================================================== ! Load default UNIFAC parameters if not provided ! ------------------------------------------------------------------------ if (. not . present ( parameters )) then params = UNIFACParameters () else params = parameters end if call params % check_consistency ! ======================================================================== ! Count all the individual groups and each molecule volume and area ! ------------------------------------------------------------------------ associate (& r => setup_unifac % molecules % volume , & q => setup_unifac % molecules % surface_area & ) ! Get all the groups indexes and counts into a single stew of groups. do i = 1 , size ( molecules ) r ( i ) = 0 q ( i ) = 0 do j = 1 , size ( molecules ( i )% groups_ids ) gi = molecules ( i )% groups_ids ( j ) ! Calculate molecule i volume and area r ( i ) = r ( i ) + molecules ( i )% number_of_groups ( j ) * params % get_subgroup_R ( gi ) q ( i ) = q ( i ) + molecules ( i )% number_of_groups ( j ) * params % get_subgroup_Q ( gi ) if ( all ( soup % groups_ids - gi /= 0 )) then ! Add group if it wasn't included yet soup % groups_ids = [ soup % groups_ids , gi ] soup % number_of_groups = [ soup % number_of_groups , 0 ] end if ! Find where is the group located in the main soup of ! groups. gi = findloc ( soup % groups_ids - gi , 0 , dim = 1 ) soup % number_of_groups ( gi ) = soup % number_of_groups ( gi ) & + molecules ( i )% number_of_groups ( j ) end do end do end associate ! ======================================================================== ! Build vij matrix (occurrence of each group of the soup on each molecule) ! ------------------------------------------------------------------------ allocate ( vij ( size ( molecules ), size ( soup % number_of_groups ))) vij = 0 do i = 1 , size ( molecules ) do k = 1 , size ( molecules ( i )% number_of_groups ) gi = molecules ( i )% groups_ids ( k ) ! Index of group for Area j = findloc ( soup % groups_ids , gi , dim = 1 ) vij ( i , j ) = molecules ( i )% number_of_groups ( k ) end do end do ! ======================================================================== ! Build qk vector (area of each group in the soup) ! ------------------------------------------------------------------------ allocate ( qks ( size ( soup % number_of_groups ))) qks = 0.0_pr do k = 1 , size ( soup % groups_ids ) qks ( k ) = params % get_subgroup_Q ( soup % groups_ids ( k )) end do ! ======================================================================== ! Build Aij matrix (interaction of the soup's subgroups) ! ------------------------------------------------------------------------ allocate ( Aij ( size ( soup % groups_ids ), size ( soup % groups_ids ))) Aij = 0.0_pr do i = 1 , size ( soup % groups_ids ) do j = 1 , size ( soup % groups_ids ) Aij ( i , j ) = params % get_subgroups_aij (& soup % groups_ids ( i ), soup % groups_ids ( j ) & ) end do end do ! ======================================================================== psi_function % Aij = Aij setup_unifac % groups_stew = soup setup_unifac % ngroups = size ( soup % number_of_groups ) setup_unifac % nmolecules = size ( molecules ) setup_unifac % psi_function = psi_function setup_unifac % group_area = params % subgroups_Qs setup_unifac % group_volume = params % subgroups_Rs setup_unifac % thetas_ij = thetas_i (& size ( molecules ), size ( soup % number_of_groups ), params , soup , molecules ) setup_unifac % vij = vij setup_unifac % qk = qks end function setup_unifac end module yaeos__models_ge_group_contribution_unifac","tags":"","url":"sourcefile/unifac.f90.html"},{"title":"auxiliar.f90 – yaeos","text":"This file depends on sourcefile~~auxiliar.f90~3~~EfferentGraph sourcefile~auxiliar.f90~3 auxiliar.f90 sourcefile~ar_models.f90 ar_models.f90 sourcefile~auxiliar.f90~3->sourcefile~ar_models.f90 sourcefile~base.f90 base.f90 sourcefile~auxiliar.f90~3->sourcefile~base.f90 sourcefile~constants.f90 constants.f90 sourcefile~auxiliar.f90~3->sourcefile~constants.f90 sourcefile~ar_models.f90->sourcefile~base.f90 sourcefile~ar_models.f90->sourcefile~constants.f90 sourcefile~math.f90 math.f90 sourcefile~ar_models.f90->sourcefile~math.f90 sourcefile~substance.f90 substance.f90 sourcefile~base.f90->sourcefile~substance.f90 sourcefile~math.f90->sourcefile~constants.f90 sourcefile~auxiliar.f90~2 auxiliar.f90 sourcefile~math.f90->sourcefile~auxiliar.f90~2 sourcefile~continuation.f90 continuation.f90 sourcefile~math.f90->sourcefile~continuation.f90 sourcefile~linalg.f90 linalg.f90 sourcefile~math.f90->sourcefile~linalg.f90 sourcefile~substance.f90->sourcefile~constants.f90 sourcefile~auxiliar.f90~2->sourcefile~constants.f90 sourcefile~continuation.f90->sourcefile~constants.f90 sourcefile~continuation.f90->sourcefile~auxiliar.f90~2 sourcefile~continuation.f90->sourcefile~linalg.f90 sourcefile~linalg.f90->sourcefile~constants.f90 sourcefile~linalg.f90->sourcefile~auxiliar.f90~2 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~auxiliar.f90~3~~AfferentGraph sourcefile~auxiliar.f90~3 auxiliar.f90 sourcefile~equilibria.f90 equilibria.f90 sourcefile~equilibria.f90->sourcefile~auxiliar.f90~3 sourcefile~flash.f90 flash.f90 sourcefile~equilibria.f90->sourcefile~flash.f90 sourcefile~flash_second_order.f90 flash_second_order.f90 sourcefile~equilibria.f90->sourcefile~flash_second_order.f90 sourcefile~phase_envelopes_pt.f90 phase_envelopes_pt.f90 sourcefile~equilibria.f90->sourcefile~phase_envelopes_pt.f90 sourcefile~saturations_points.f90 saturations_points.f90 sourcefile~equilibria.f90->sourcefile~saturations_points.f90 sourcefile~flash.f90->sourcefile~auxiliar.f90~3 sourcefile~flash_second_order.f90->sourcefile~auxiliar.f90~3 sourcefile~phase_envelopes_pt.f90->sourcefile~auxiliar.f90~3 sourcefile~saturations_points.f90->sourcefile~auxiliar.f90~3 sourcefile~yaeos.f90 yaeos.f90 sourcefile~yaeos.f90->sourcefile~equilibria.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module yaeos__equilibria_auxiliar !! # Phase-equilibrium initialization utilities !! Wilson correlations for initial K-factors and pressure estimates. !! !! # Description !! `k_wilson` provides component volatility ratios for initializing flash !! calculations; `p_wilson` estimates the pressure from a composition and !! temperature. These are empirical initial estimates, not equilibrium !! solutions. !! !! # Examples !! ```fortran !! K0 = k_wilson(model, T, P) !! P0 = p_wilson(model, z, T) !! ``` use yaeos__constants , only : pr use yaeos__models_base , only : BaseModel use yaeos__models_ar , only : ArModel implicit none contains function k_wilson ( model , T , P ) result ( K ) !! # K_wilson !! !! ## Description !! K-factors regression done by Wilson, used for initialization. !! !! # Examples !! ```fortran !! K0 = k_wilson(model, T, P) !! ``` class ( BaseModel ), intent ( in ) :: model !! Model supplying component critical constants. real ( pr ), intent ( in ) :: T !! Temperature [K]. real ( pr ), intent ( in ) :: P !! Pressure [bar]. real ( pr ) :: K ( size ( model % components % pc )) K = ( model % components % Pc / P ) & * exp ( 5.373_pr * ( 1 + model % components % w )& * ( 1 - model % components % Tc / T )) end function k_wilson real ( pr ) function P_wilson ( model , z , T ) result ( P ) !! # P_wilson !! !! ## Description !! Calculate the pressure at a given T of a mixture using the Wilson !! equation. class ( BaseModel ), intent ( in ) :: model !! Model of the mixture. real ( pr ), intent ( in ) :: z (:) !! Overall composition (mole fractions). real ( pr ), intent ( in ) :: T !! Temperature [K]. P = 1.0_pr / sum (& z * model % components % Pc & * exp ( 5.373_pr & * ( 1 + model % components % w ) * ( 1 - model % components % Tc / T ))) end function P_wilson end module yaeos__equilibria_auxiliar","tags":"","url":"sourcefile/auxiliar.f90~3.html"},{"title":"User documentation – yaeos","text":"Learn to use yaeos yaeos is a Fortran library for calculating fluid properties and phase\nequilibria. It includes equations of state (EOS) for gases and liquids, and\nactivity-coefficient models for non-ideal liquid mixtures. You can use it to answer questions such as “What pressure does this mixture\nhave?”, “When does the first liquid drop appear?”, or “How much liquid and\nvapor coexist at this temperature and pressure?” These are different\ncalculations, and this guide helps you choose the right one. Start with a working example Your first calculation Thermodynamics essentials Choose an EOS Liquid activity models Phase equilibrium Python users Become a developer The getting-started tutorial builds a small program,\npredicts a mixture’s pressure, solves for volume, and explains how to check\nthe result. If terms such as mole fraction , fugacity , or volume root are\nunfamiliar, keep thermodynamics essentials alongside\nthe tutorial. You do not need to derive an EOS before running it. A suggested learning path Step Read What you will be able to do 1 Getting started Install the library and run a complete Fortran calculation 2 Thermodynamics essentials Distinguish amounts, compositions, phases, units, and energy references 3 EOS guides or activity models Choose a model family and assemble its input data 4 Property reference Evaluate properties and understand optional derivatives 5 Phase equilibrium Select saturation, flash, stability, or envelope calculations 6 Adding models Extend the library and check a new model’s derivatives 7 Developer handbook Navigate the codebase and contribute across Fortran, C-facing wrappers, and Python Choose a guide by the question you have I know the state and want a property. Start with the property guide . EOS models share the ArModel interface, so property calls stay similar when you switch between models. I have a non-ideal liquid mixture. Start with excess-Gibbs models . Their GeModel interface supplies activity coefficients and excess properties, not a\n  general pressure–volume relationship. I want to know which phases exist. Start with phase equilibrium . A single-phase\n  property call is not a phase-split calculation. I use Python rather than Fortran. Follow the Python tutorials and API . The physical model and\n  units are shared, but Python method names and result containers can differ. I am extending or contributing to the project. Read the developer handbook , adding models , and the contributor guide . How to read the examples Complete programs can be copied into a project’s app/main.f90 . A block\nexplicitly described as a snippet or an insertable block depends on the setup\nshown before it; do not compile it as a standalone program. Routine names\nlinked into the generated API lead to argument-level documentation. Most Fortran examples use pr , the library’s real-number precision, and the\ndefault unit system: pressure in bar, volume in litres, temperature in kelvin,\nand amount in moles. Check model parameter units separately. Component arrays\nmust always have the same ordering as the model’s construction data. The guides introduce the physical idea first, then a practical calculation,\nthen the equations or advanced options. It is fine to postpone the detailed\nderivations until you need them. No model or convergence status can replace\nchecking units, parameters, material balances, and comparison with measured\ndata. This library and its documentation are evolving. Please report problems or\nmissing explanations through the issue tracker , including your\nlibrary version and a small reproducing example when possible.","tags":"","url":"page/index.html"},{"title":"Getting started – yaeos","text":"Your first calculation with yaeos 1. Prepare a project 2. Understand the inputs 3. Run a complete pressure calculation 4. Solve the inverse problem: volume from pressure 5. Generate a pressure–volume isotherm 6. Request derivatives only when you need them Units and amount basis If something goes wrong Where to go next Your first calculation with yaeos This tutorial goes from an empty Fortran project to a pressure calculation,\nthen shows how to solve for volume and generate a pressure–volume curve.\nYou need basic familiarity with variables and arrays, but not with the\nderivation of an equation of state (EOS). The example uses a methane–ethane mixture. We will choose a model, supply\ncomponent data in a consistent order, and ask it to predict a homogeneous\nfluid’s pressure. Finding how much liquid and vapor coexist is a different\ntask, introduced in the phase-equilibrium guide . 1. Prepare a project yaeos is a modern Fortran library distributed as an fpm package. Install a Fortran compiler, fpm , Git, and the BLAS/LAPACK numerical libraries. Building the bundled\nautomatic-differentiation support also requires a C compiler. On Debian or\nUbuntu the compiler and system-library packages can be installed with: sudo apt install gfortran gcc git libblas-dev liblapack-dev Install fpm separately following its installation guide , then create\na project: fpm new first_yaeos --app cd first_yaeos Add the following dependency to fpm.toml . If a [dependencies] section\nalready exists, add the yaeos line there rather than creating a second section. [dependencies] yaeos = { git = \"https://github.com/ipqa-research/yaeos\" } The first build downloads dependencies and can take longer than later builds.\nFor reproducible work, select a tested release tag or commit using fpm ’s tag or rev dependency options. Examples in these pages describe the API in\nthis documentation’s source revision; an older release may expose different\narguments. If Fortran itself is new to you, the Fortran-lang learning resources explain\nprograms, arrays, derived types, and procedure calls. 2. Understand the inputs An EOS relates pressure, volume, temperature, and composition. The\nPeng–Robinson 1976 model used here needs each component’s critical temperature tc , critical pressure pc , and acentric factor omega . A critical temperature and critical pressure locate the pure fluid’s\ncritical point, where its liquid and vapor become indistinguishable. The acentric factor is a dimensionless descriptor of its vapor-pressure\nbehavior. These are component data, not the temperature and pressure of the\nmixture you are about to calculate. Array position Component tc [K] pc [bar] omega [–] 1 Methane 190.564 45.99 0.01142 2 Ethane 305.32 48.72 0.0995 These rounded values are suitable for a tutorial, not a substitute for\nselecting consistent data for a validated application. All arrays use this\nsame component order. We use 0.3 mol methane and 0.7 mol ethane, a total of 1 mol. At 320 K in a\n1 L vessel, the ideal-gas equation would give bar. The EOS accounts for molecular\ninteractions and will give a different pressure. The ideal-gas value is a\nuseful scale check, not the expected EOS answer. 3. Run a complete pressure calculation Replace app/main.f90 with this complete program: program first_yaeos use yaeos , only : pr , ArModel , PengRobinson76 implicit none class ( ArModel ), allocatable :: model real ( pr ) :: tc ( 2 ) real ( pr ) :: pc ( 2 ) real ( pr ) :: omega ( 2 ) real ( pr ) :: n ( 2 ) real ( pr ) :: temperature real ( pr ) :: volume real ( pr ) :: pressure tc = [ 19 0.564_pr , 30 5.32_pr ] pc = [ 4 5.99_pr , 4 8.72_pr ] omega = [ 0.01142_pr , 0.0995_pr ] n = [ 0.3_pr , 0.7_pr ] temperature = 32 0.0_pr volume = 1.0_pr model = PengRobinson76 ( tc , pc , omega ) call model % pressure ( n , volume , temperature , pressure ) write ( * , '(A,F10.4)' ) \"Pressure [bar]: \" , pressure end program first_yaeos Run it from the project directory: fpm run Here is what the important lines do: use yaeos, only: ... imports the names needed for this calculation. pr selects the library’s floating-point precision. The _pr suffix keeps\n  literal constants in that precision. class(ArModel), allocatable declares a variable that can hold different\n  residual-Helmholtz EOS model types. You do not have to implement that class. PengRobinson76(...) constructs and stores the component parameters. It\n  does not calculate equilibrium at a particular temperature or pressure. model%pressure(...) evaluates this model at the supplied state and writes\n  the answer into the last argument. For the rounded inputs above, the pressure is approximately 23.4215 bar ,\nbelow the ideal-gas estimate of 26.61 bar. At this particular state, the net\nnon-ideal correction lowers the pressure; this is not a rule that holds at\nevery density. Small differences in component data or compiler arithmetic can\nchange the last displayed digits. This example has not fitted binary\ninteraction parameters: the constructor’s default mixing rule uses zero\nbinary interactions. That is a useful starting point, not evidence that those\nparameters are suitable for every mixture. 4. Solve the inverse problem: volume from pressure In an experiment you often know pressure and temperature, not volume. The\nfollowing insertable block goes before end program first_yaeos in the\nprevious program; it reuses model and n : volume_example : block real ( pr ) :: specified_pressure real ( pr ) :: solved_volume real ( pr ) :: checked_pressure real ( pr ) :: temperature specified_pressure = 1 0.0_pr temperature = 32 0.0_pr call model % volume ( n , specified_pressure , temperature , solved_volume , & root_type = \"stable\" ) if ( solved_volume <= 0.0_pr ) error stop \"Volume calculation failed\" call model % pressure ( n , solved_volume , temperature , checked_pressure ) write ( * , '(A,F10.5)' ) \"Total volume [L]: \" , solved_volume write ( * , '(A,ES12.4)' ) \"Pressure mismatch [bar]: \" , & checked_pressure - specified_pressure end block volume_example Re-evaluating pressure at the solved volume should reproduce the specified\npressure to the solver’s numerical accuracy. This checks the inverse\ncalculation, not the model’s agreement with experimental data.\nThe example gives approximately 2.52678 L; in a local run the pressure mismatch\nwas about bar, rather than exactly zero. The root_type argument controls the volume branch. \"liquid\" requests the\ndense branch, \"vapor\" the dilute branch, and \"stable\" the preferred\nhomogeneous root. These roots need not be different at every state. In\nparticular, a stable volume root does not by itself test whether a mixture\nwould separate into phases with different compositions. See thermodynamics essentials . 5. Generate a pressure–volume isotherm An isotherm is a curve at constant temperature. Insert this block before\nthe end of the first program to evaluate twelve volumes at 320 K: pv_isotherm : block real ( pr ) :: volume real ( pr ) :: pressure real ( pr ) :: first_volume real ( pr ) :: last_volume real ( pr ) :: step integer :: i integer , parameter :: n_points = 12 first_volume = 0.1_pr last_volume = 1 0.0_pr step = ( last_volume - first_volume ) / real ( n_points - 1 , pr ) write ( * , '(A)' ) \"Volume [L],Pressure [bar]\" do i = 0 , n_points - 1 volume = first_volume + real ( i , pr ) * step call model % pressure ( n , volume , 32 0.0_pr , pressure ) write ( * , '(F9.4,\",\",F12.6)' ) volume , pressure end do end block pv_isotherm Plot the two columns in your preferred plotting tool. The volume range is\ndeliberately broad: at large volumes the pressure approaches the ideal-gas\nbehavior, whereas small volumes magnify intermolecular effects. An arbitrary\nsmall volume may be outside a model’s physical domain; check before extending\nthe sweep toward zero. Some rows of the calculated table are: Total volume [L] Pressure [bar] 0.1 137.063211 1.0 23.421450 3.7 6.940690 10.0 2.625777 The markers are the twelve states evaluated by the program; connecting lines\nare a guide to the eye. The dashed curve compares the ideal-gas pressure at\nthose same volumes and temperature. This is an EOS curve for proposed homogeneous states, not a phase-equilibrium\nenvelope. At other temperatures, a model curve can pass through unstable\nstates; those points do not describe a physically stable, uniform sample. 6. Request derivatives only when you need them A derivative tells you how a property changes when an input changes. For\nexample, dPdV is the slope of pressure with respect to total volume while\ntemperature and mole amounts stay fixed. This insertable block requests that\nslope as well as pressure: derivative_example : block real ( pr ) :: pressure real ( pr ) :: slope call model % pressure ( n , 1.0_pr , 32 0.0_pr , pressure , dPdV = slope ) write ( * , '(A,ES12.4)' ) \"dP/dV [bar/L]: \" , slope end block derivative_example Optional keyword outputs let you ask for the quantities you need without\nimplementing numerical differentiation yourself. For normal stable fluid\nstates this slope is negative: expansion lowers the pressure. Derivatives near\nsingularities or critical states require more care. Units and amount basis Use bar, litres, kelvin, and moles unless a model-specific parameter is\ndocumented otherwise. The library uses .\nExtensive energies are in bar·L, and . Here the amounts sum to one mole, so the numerical total volume equals the\nnumerical molar volume. If you multiply every amount by ten, multiply total\nvolume by ten to describe the same density and pressure. Do not assume this\none-mole coincidence holds for arbitrary input amounts. See the units and composition guide for examples and conversion\nchecks. If something goes wrong Symptom First things to check fpm cannot fetch a dependency Network access, Git availability, and the dependency revision Linker reports missing blas or lapack Installed development libraries and library-search configuration Compiler does not recognize a keyword argument Installed yaeos version versus this documentation’s API Implausible pressure or density K versus °C, bar versus Pa, total versus molar volume, and component ordering A volume calculation fails or returns a nonphysical value Input domain, requested root, parameter validity, and solver diagnostics Do not fix a unit or parameter error by changing solver tolerances. Numerical\nconvergence and physical accuracy are separate questions. Where to go next Thermodynamics essentials : amounts, phases, energy\n  references, fugacity, and the questions each solver answers. EOS model guides : select a model and understand its\n  parameters, alpha function, and mixing rule. Thermodynamic properties : practical calls followed by\n  detailed equations and derivatives. Liquid activity models : describe non-ideal liquid\n  mixtures using excess Gibbs energy. Phase equilibrium : move from a property\n  calculation to saturation, flash, stability, and envelopes. Adding a model : implement a new energy model when\n  configuration of an existing one is not sufficient.","tags":"","url":"page/usage/index.html"},{"title":"Thermodynamics essentials – yaeos","text":"Thermodynamics essentials for using yaeos A component is not a phase Amount, composition, and volume: three common sources of mistakes Mole amounts versus mole fractions Total volume versus molar volume Component order must never change silently Units are part of the input What an equation of state does—and does not do Which model family should I read about first? Why the library talks about energy Fugacity and activity: how models compare phases A volume root is not a phase split Match the calculation to the question A checklist before using a prediction Thermodynamics essentials for using yaeos You do not need to derive an equation of state to use yaeos . You do need to\nknow what you are specifying, what the model returns, and what checks make a\nresult believable. This page introduces those ideas before the more detailed\nmodel and calculation guides. If you have not run a calculation yet, start with the getting-started example . You can return here whenever a guide\nuses an unfamiliar term. A component is not a phase A component is one chemical species in the model, such as methane or\nethane. A phase is a physically distinct region, such as a liquid or a\nvapor. A liquid mixture can contain several components, and a pure component\ncan coexist as both liquid and vapor. Two different liquids can also coexist. For example, a methane–ethane feed has two components whether it is entirely\nvapor or has separated into a liquid and a vapor. In the separated state, both\nphases generally contain both components, but in different proportions. This distinction matters when sizing arrays: a two-component composition has\ntwo entries, not one entry per phase. Amount, composition, and volume: three common sources of mistakes Mole amounts versus mole fractions Let be the amount of component , in moles. The vector of amounts\nis , and the total amount is a scalar: The mole fraction is the fraction of that total contributed by a component: For n = [3.0_pr, 7.0_pr] , the total is 10 mol and the composition is z = [0.3_pr, 0.7_pr] . This is the same composition as n = [0.3_pr, 0.7_pr] , but not the same amount of material. Property routines such as pressure(n, V, T, ...) use amounts. Many equilibrium\nentry points instead request a normalized feed composition z . Follow the\nindividual routine’s convention rather than assuming all arrays are normalized\nautomatically. A feed must have a positive total amount and nonnegative entries;\nlogarithmic formulations may additionally require strictly positive entries. Total volume versus molar volume The symbol denotes total volume, in litres. The molar volume is , in litres per mole. A property call with 10 mol and\n1 L describes a much denser state than a call with 1 mol and 1 L. To keep the same temperature, pressure, and composition when scaling a system,\nmultiply every mole amount and the total volume by the same factor: That is a useful consistency check. When you pass a normalized composition as\nthe amount vector, its total is 1 mol, so the numerical total volume is also\nthe numerical molar volume. This convenient one-mole basis does not mean the\ntwo quantities are interchangeable for other amounts. Component order must never change silently If the first constructor entry describes methane and the second ethane, every\ncomposition, parameter vector, and row/column of an interaction matrix must\nuse that same order. Array sizes alone cannot catch a reversed composition or\nan incorrectly transposed interaction matrix. Units are part of the input The default gas constant is . Consequently: Quantity Default unit Frequent mistake Temperature K Passing a Celsius value without adding 273.15 Pressure bar Passing pascals, MPa, or atmospheres as if they were bar Total volume L Passing cubic metres or a molar volume for a multi-mole input Amount mol Treating mass fractions as mole fractions Extensive energy bar·L Reading the numerical value directly as joules Extensive entropy or heat capacity bar·L/K Reading the result directly as J/(mol·K) One bar·litre is 100 J. For an extensive energy energy and an amount vector n , the molar energy in J/mol is 100.0_pr * energy / sum(n) . Some equilibrium\nresult fields are already molar quantities; check their documentation before\ndividing again. SAFT segment diameters and model-specific interaction parameters\nhave their own units, described on their respective model pages. What an equation of state does—and does not do An equation of state (EOS) models how a fluid’s pressure, temperature,\nvolume, and composition are related. The ideal-gas equation is the simplest: Real molecules occupy space and interact. An EOS adds a description of those\neffects, making it possible to estimate liquid densities and non-ideal gas\nbehavior. Different model families make different approximations; adding more\nparameters does not automatically make a model better for your mixture. yaeos separates two jobs. A model evaluates properties for a proposed\nstate. An equilibrium solver searches for the phases and compositions that\ncan coexist. Calling pressure at an arbitrary volume evaluates the EOS; it\ndoes not ask whether the material would actually stay in a single phase. Which model family should I read about first? Your starting problem Starting point What to check before trusting it Gas/hydrocarbon properties and vapor–liquid calculations with critical-property data Cubic EOS Suitable component data and binary interactions Natural-gas mixtures using components in the supported set GERG2008 Supported species and the model’s validated state range Fluids with available segment parameters PC-SAFT Parameter units and which physical contributions are implemented Non-ideal liquid mixtures with fitted pair parameters NRTL or UNIQUAC Parameter convention, temperature range, and reference state Liquid-mixture estimates from molecular functional groups UNIFAC-like models Group decomposition and available interaction pairs These are starting points, not guarantees of suitability. A liquid activity\nmodel by itself does not supply gas pressure or density. For a particular\nmixture, compare predictions with reliable measurements whenever possible. Why the library talks about energy The Helmholtz energy , , is a thermodynamic potential with natural\nvariables amount, volume, and temperature. Its derivatives connect several\nproperties consistently. yaeos EOS models use the residual Helmholtz\nenergy : the difference from an ideal gas at the same . For example, You can use model%pressure without calculating that derivative yourself.\nThe energy formulation is why different EOS types can share the same property\nand equilibrium interfaces. Residual does not mean an error in a numerical calculation. It means a\ndeparture from an ideal-gas reference. A residual enthalpy is not the total\nenthalpy: the matching ideal-gas contribution is needed too. The reference held\nfixed—volume or pressure—also matters for some departure properties. The property reference explains those distinctions in detail. An excess Gibbs energy , , uses a different reference: ideal mixing\nof components in specified pure-component reference states. It measures\nnon-ideal mixing rather than departure from an ideal gas. Do not substitute an\nexcess quantity for a residual one merely because both describe non-ideality. Fugacity and activity: how models compare phases Think of fugacity as a pressure-like measure of a component’s tendency to\nleave a phase. More precisely, it expresses chemical potential on a chosen\nreference scale. At equilibrium a component has the same chemical potential,\nand therefore the same fugacity, in all phases in which it is present. For an EOS phase with composition , pressure , and fugacity\ncoefficient , The coefficient is dimensionless and approaches one in the ideal-gas limit. lnPhi contains , not ; use exp(lnPhi) when\nyou want the coefficient itself. Logarithms are convenient for comparing\nfugacities that can span many orders of magnitude. For liquid activity models, the analogous correction is the activity\ncoefficient . Under a chosen liquid reference convention, is the component’s activity. A value of one means ideal\nmixing relative to that reference, not necessarily ideal-gas behavior. A volume root is not a phase split At a specified pressure and temperature, an EOS can have several mathematical\nvolume solutions. A small-volume root is liquid-like; a large-volume root is\nvapor-like. Depending on the state there may be only one physically admissible\nroot. The requested names \"liquid\" and \"vapor\" select root branches; they\ndo not guarantee that two different phases exist. The \"stable\" root requests the model’s preferred homogeneous root. A mixture\nat that composition may still lower its Gibbs energy by separating into phases\nwith different compositions. That is the question answered by stability analysis and flash calculations , not by a volume call alone. Match the calculation to the question Question Calculation Main result What is the pressure of this proposed homogeneous state? Property evaluation Pressure at the supplied amount, volume, and temperature At what pressure does the first bubble or drop appear? Saturation point A phase boundary and an incipient phase composition How much liquid and vapor form at this pressure and temperature? Flash Phase compositions and fractions How does that boundary change as conditions change? Phase envelope A sequence of boundary points Could this homogeneous mixture lower its energy by separating? Stability analysis Candidate phases and a stability criterion Where do two phases become indistinguishable? Critical calculation A critical state or line The phase-equilibrium overview connects these\ncalculations into a workflow. In a two-phase split the feed composition , liquid composition , vapor composition , and vapor\nmole fraction satisfy This is a material balance, not a thermodynamic model, and it is one of the\nmost useful checks on a calculated split. The K-factor convention in the\nuser-facing explanations is . A checklist before using a prediction Check units, component ordering, and parameter provenance. Check whether the routine expects amounts or normalized compositions. Check its termination/status information before reading result arrays. Check compositions, phase fractions, and material balances. Check that a root or branch corresponds to the problem you intended to solve. Compare with limiting behavior or independent experimental data. A converged solver has solved its equations to a numerical tolerance. It has\nnot established that the parameters are appropriate, that a global search found\nevery possible phase, or that the model is accurate outside its fitted range.","tags":"","url":"page/usage/fundamentals.html"},{"title":"Equations of State – yaeos","text":"Equations of State Start here Units and amount basis Why Helmholtz energy? A complete first calculation Thermodynamic properties Pressure and volume Pressure: P(\\mathbf{n}, V, T) Volume: V(\\mathbf{n}, P, T) Residual properties at (n, V, T) Fugacity coefficients (V,T): \\ln \\phi_i (V,T) Fugacity (V,T): \\ln f_i (V,T) Residual entropy (V,T): S&#94;r(\\mathbf{n},V,T) Residual enthalpy (V,T): H&#94;r(\\mathbf{n},V,T) Residual Gibbs free energy (V,T): G&#94;r(\\mathbf{n},V,T) Residual internal energy (V,T): U&#94;r(\\mathbf{n},V,T) Residual constant volume heat capacity (V,T): C_V&#94;r(\\mathbf{n},V,T) Residual constant pressure heat capacity (V,T): C_P&#94;r(\\mathbf{n},V,T) Residual properties at (n, P, T) Fugacity coefficients (P,T): \\ln \\phi_i (P,T) Residual Helmholtz free energy (P, T): A&#94;r(\\mathbf{n}, P, T) Residual entropy (P, T): S&#94;r(\\mathbf{n}, P, T) Residual Enthalpy (P, T): H&#94;r(\\mathbf{n}, P, T) Residual Gibbs free energy (P, T): G&#94;r(\\mathbf{n}, P, T) Residual internal energy (P, T): U&#94;r(\\mathbf{n}, P, T) Residual constant volume heat capacity (P,T): C_V&#94;r(\\mathbf{n},P,T) Residual constant pressure heat capacity (P,T): C_P&#94;r(\\mathbf{n},P,T) Excess properties (n, P, T) Activity coefficients (P, T): ln \\gamma_i(\\mathbf{n}, P, T) Excess Gibbs free energy (P, T): G&#94;E(\\mathbf{n}, P, T) Excess Enthalpy (P, T): H&#94;E(\\mathbf{n}, P, T) Excess volume (P, T): V&#94;E(\\mathbf{n}, P, T) Excess entropy (P, T): S&#94;E(\\mathbf{n}, P, T) Excess Helmholtz free energy (P, T): A&#94;E(\\mathbf{n}, P, T) Excess Internal Energy (P, T): U&#94;E(\\mathbf{n}, P, T) References Equations of State Start here An EOS answers questions such as “what pressure does this amount of fluid exert\nin this volume?” and “how far is this fluid from ideal-gas behavior?”. These\nare single homogeneous-phase calculations; evaluating an EOS at an overall\nmixture composition does not automatically split it into equilibrium phases.\nSee thermodynamic fundamentals for the broader workflow. For practical use: read the units below, run the complete example, then\nlook up the property you need in the table of contents. The detailed equations\nare an optional reference, not a prerequisite for calling the routines. What you know / need Routine or section Amounts, total volume, temperature → pressure pressure Amounts, pressure, temperature → volume of a chosen root volume Nonideality for phase-equilibrium calculations lnphi_pt or lnphi_vt Energy or heat-capacity correction to an ideal gas *_residual_pt or *_residual_vt Deviation from ideal-solution mixing Excess properties Units and amount basis The default unit system uses mol, L, K, and bar, with .\nDo not pass Pa or m³ without converting them. The Fortran array n(:) contains component amounts , ,\n  in mol; the scalar total is . Mole fractions are . They sum to one and specify composition,\n  not the amount of material. Passing n=z selects a one-mole basis. V is total volume in L; molar volume is in L/mol.\n  If you multiply every amount by ten, also multiply V by ten to keep\n  the same density and pressure. Ar , Hr , Gr , and Ur are total energies in bar L, not molar energies;\n  divide by sum(n) for bar L/mol. One bar L is 100 J.\n  Entropy and heat capacities are in bar L/K. Derivative units follow from\n  division by the differentiated variable, e.g. dPdV in bar/L. lnPhi and lngamma are dimensionless vectors, one entry per component.\n  Composition-derivative matrices have entry (i,j) equal to the derivative\n  of output i with respect to amount n(j) , not mole fraction z(j) . Choose a model and parameters appropriate to your fluid and range; a successful\ncalculation is not evidence that the model is accurate there. See cubic models , GERG-2008 , and PC-SAFT for model-specific inputs and limitations. Why Helmholtz energy? yaeos is a library based on Equation-of-State calculations. An Equation of\nState (EOS) is a mathematical model that describes the relationship between\nthermodynamic properties of a system, typically pressure (P), volume (V), and\ntemperature (T). These equations are fundamental in physics, chemistry, and\nengineering, especially in thermodynamics and fluid mechanics. EOS models are used to predict phase behavior, thermodynamic properties, and\nequilibrium conditions of gases, liquids, solids, and mixtures. They are widely\napplied in areas such as chemical engineering, petroleum engineering, and\nmaterial science. From the ideal gas law, to cubic equations of state and SAFT,\nto more complex models, EOS are essential tools for the study and design of\nprocesses. The classic way of defining an EOS is though a mathematical equation that\nexpress the pressure as a function of the volume and temperature. For example,\nthe Van der Waals EOS is defined as: Where is the pressure, is the molar volume, is the\ntemperature, is the gas constant, and and are parameters that\ndepend on the substance. For mixtures, the and parameters are\ncalculated from the pure components parameters using a mixing rule. The modern way of defining an EOS is through a mathematical model that express\nthe residual Helmholtz free energy as a function of the mole number, volume and\ntemperature. This approach is more general and allows for a more flexible\ndefinition of the EOS in the context of implementing it in code. All\nresidual thermodynamic properties can be calculated from the residual Helmholtz\nfree energy and its derivatives. Total caloric properties also require an\nideal-gas contribution and a consistent reference state. yaeos is based on\nthis approach. This section of the documentation will guide you through the thermodynamic\nproperties that can be calculated with yaeos using Helmholtz free energy\nmodels. Additionally, this page serves as a summary of how all these properties\ncan be derived from the Helmholtz free energy and its derivatives. First, you might be used to the classic way of defining an\nEOS. This is normal since it is the most common way of explaining them in\nundergraduate thermodynamics courses. So, a very reasonable question is: “how\ncan I obtain the expression for the residual Helmholtz free energy from the expression?”. The answer\nis the following: The integral holds at fixed amounts and temperature, with the residual tending\nto zero in the dilute ideal-gas limit. A complete first calculation This standalone program constructs a Peng–Robinson model and evaluates a vapor\nroot. The critical constants below are illustrative inputs, not a validated\nparameter set for named substances. program main use yaeos , only : pr , R , ArModel , PengRobinson76 use , intrinsic :: ieee_arithmetic , only : ieee_is_finite implicit none ! We will instantiate a Peng-Robinson EOS model with two components ! Set the variable `model` as a generic `ArModel` class ( ArModel ), allocatable :: model real ( pr ) :: tc ( 2 ) real ( pr ) :: pc ( 2 ) real ( pr ) :: w ( 2 ) real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: V real ( pr ) :: Pcheck real ( pr ) :: Z real ( pr ) :: lnPhi ( 2 ) real ( pr ) :: Hr tc = [ 19 0.0_pr , 31 0.0_pr ] ! Critical temperatures [K] pc = [ 1 4.0_pr , 3 0.0_pr ] ! Critical pressures [bar] w = [ 0.001_pr , 0.03_pr ] ! Acentric factors [-] ! Now we set our model as the PengRobinson76 equation of state. model = PengRobinson76 ( tc , pc , w ) n = [ 0.3_pr , 0.7_pr ] ! One mole, composition z = [0.3, 0.7] T = 30 0.0_pr P = 1.0_pr call model % volume ( n , P , T , V = V , root_type = \"vapor\" ) if (. not . ieee_is_finite ( V )) error stop \"Nonfinite volume\" if ( V <= 0.0_pr ) error stop \"Volume solve failed\" call model % pressure ( n , V , T , P = Pcheck ) if (. not . ieee_is_finite ( Pcheck )) error stop \"Nonfinite pressure\" if ( abs ( Pcheck - P ) > 1.0e-6_pr ) error stop \"Pressure mismatch\" call model % lnphi_vt ( n , V , T , lnPhi = lnPhi ) call model % enthalpy_residual_vt ( n , V , T , Hr = Hr ) Z = Pcheck * V / ( sum ( n ) * R * T ) print * , \"Total volume [L]: \" , V print * , \"Molar volume [L/mol]: \" , V / sum ( n ) print * , \"Compressibility factor [-]: \" , Z print * , \"ln(phi_i) [-]: \" , lnPhi print * , \"Residual molar enthalpy [J/mol]: \" , 10 0.0_pr * Hr / sum ( n ) end program main Here Z=1 is ideal-gas behavior; deviations show how the pressure–volume\nrelation differs from an ideal gas. lnPhi=0 means a unit fugacity coefficient,\nnot zero fugacity. A negative Hr means an enthalpy below the ideal-gas value\nat the same temperature and composition; it is not an absolute enthalpy. All subsequent code blocks are snippets : insert them after model\nconstruction and before end program main , not as separate programs. Their block constructs give local variables their own scope. Optional derivative\noutputs may be omitted when only the property itself is needed. Thermodynamic properties The reference used for the equations of each property is “Thermodynamic Models:\nFundamentals and Computational Aspects” by Michael L. Michelsen and Jørgen M.\nMollerup - 2nd edition (abbreviated as: MM). For each property, we are going to\nrefer to the chapter and equation for a rapid search. The MM book sometimes express the equations in terms of (reduced\nresidual Helmholtz free energy): On this documentation section we are going to express all the properties in\nterms of so a little algebraic work is required. Finally, we are going to use the MM notation, for that: is the total number of moles, and is the number of moles of\ncomponent . Therefore: The moles number vector is denoted as . On partial derivatives, the subscript indicates the variables that are kept constant. For example: means the partial derivative of pressure with respect to volume keeping\ntemperature and moles vector constant. With a partial derivative respect to the\nmole number of component we have: With a rigorous notation, the partial derivative of pressure with respect to\nthe mole number of component keeping volume and temperature constant\nshould be: On the notation the subscript means that all the mole numbers\nof the other components are kept constant. This is omitted for simplicity. Pressure and volume Pressure: MM - Chapter 2 - Equations 7, 9, 10, and 11 Pressure can be calculated from the residual Helmholtz free energy as follows: pressure : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: P real ( pr ) :: dPdV real ( pr ) :: dPdT real ( pr ) :: dPdn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) ! Calculate pressure and its derivatives call model % pressure ( n , V , T , P = P , dPdV = dPdV , dPdT = dPdT , dPdn = dPdn ) print * , \"Pressure: \" , P print * , \"dPdV: \" , dPdV print * , \"dPdT: \" , dPdT print * , \"dPdn: \" , dPdn end block pressure Volume: At fixed amounts, pressure, and temperature, an EOS may have more than one\nvolume root. A conventional cubic EOS has one or three real algebraic roots\n(counting multiplicity); not every root is physically admissible. Three\ndistinct physical phases are not implied by three roots. Other model families\nneed not follow this root count. yaeos uses numerical volume solvers; this is\nan implementation choice, not a consequence of nonuniqueness alone. root_type=\"liquid\" seeks the dense root and \"vapor\" the dilute root.\nThey may return the same volume when only one root exists. \"stable\" selects\nthe lower-Gibbs-energy candidate at the specified composition ; it does not\ntest stability against separation into phases of different compositions.\nFor equilibrium phase amounts and compositions, use the phase-equilibrium routines . Check that a returned volume is finite and positive, and re-evaluate pressure\nto check the solve, as in the first example. Root solvers can fail, especially\nnear limiting states. A mechanically stable homogeneous branch normally has ; this is necessary, not sufficient,\nfor full mixture stability. To learn more about volume initialization, please refer to the book\n“Thermodynamic Models: Fundamentals and Computational Aspects” by Michael L.\nMichelsen and Jørgen M. Mollerup. Volume derivatives can be calculated in terms\nof pressure derivatives, this will appear later on this documentation. volume : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: V n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar ! Calculate different volume roots call model % volume ( n , P , T , V = V , root_type = \"liquid\" ) print * , \"Liquid volume: \" , V call model % volume ( n , P , T , V = V , root_type = \"vapor\" ) print * , \"Vapor volume: \" , V call model % volume ( n , P , T , V = V , root_type = \"stable\" ) print * , \"Stable volume root: \" , V end block volume Residual properties at (n, V, T) As you may know, residual properties are the difference between the actual\nproperty and the ideal gas property at the same temperature and volume (in this\ncase). For that, for a generic residual property , we have: Notice that the ideal gas property is\ncalculated at the same volume of the real fluid. If the ideal gas is at the\nsame temperature and volume of the real fluid, the ideal gas is not at the same\npressure as the real fluid. For that, two different residual properties can be\ncalculated: Here we call the same- difference a residual and the same- difference a departure ; the API uses residual in both routine names.\nThe sections below retain that API terminology. The difference is the ideal-gas\nreference, not a different real-fluid state: when comparing the two, is\nthe EOS pressure at . These energy, entropy, and heat-capacity corrections are extensive: scaling and together by a factor scales them by that factor.\nFugacity coefficients are intensive and are not differences between total\nproperties. Their conventional ideal-gas reference is at the same ,\neven when the routine takes as inputs. Fugacity coefficients (V,T): MM - Chapter 2 - Equations 13, 14, 15, and 16 Fugacity is an effective pressure for chemical equilibrium. For a phase of\ncomposition , ; corrects\nthe ideal-gas partial pressure. Equilibrium requires equal component fugacities\nbetween phases, not equal fugacity coefficients. Logarithms make products\nadditive and help numerical solvers handle large fugacity ratios. For an ideal\ngas, ; positive and negative values mean coefficients\nabove and below one, respectively. Natural logarithms of fugacity coefficients specifying and are\ncalculated as follows: Remember that the compressibility factor is calculated as: The derivative outputs are useful for Newton solvers, stability calculations,\nand property sensitivities. Despite the vt input specification , dlnPhidT , dlnPhidP , and dlnPhidn are derivatives at the constraints shown\nbelow: temperature at fixed , pressure at fixed , and amounts at fixed . Pressure derivatives returned\nby the same routine retain the constraints in the pressure section. lnphi_vt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: lnPhi ( 2 ) real ( pr ) :: dlnPhidP ( 2 ) real ( pr ) :: dlnPhidT ( 2 ) real ( pr ) :: dlnPhidn ( 2 , 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) call model % lnphi_vt (& n , V , T , lnPhi = lnPhi , & dlnPhidP = dlnPhidP , dlnPhidT = dlnPhidT , dlnPhidn = dlnPhidn & ) end block lnphi_vt The subroutine lnphi_vt also allows to obtain the value of pressure and its\nderivatives at the specified volume and temperature. Since those values are\nneeded to calculate the fugacity coefficients, you can take advantage of this\nfeature to avoid calculating them twice. lnphi_vt_p : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: lnPhi ( 2 ) real ( pr ) :: P real ( pr ) :: dPdV real ( pr ) :: dPdT real ( pr ) :: dPdn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) call model % lnphi_vt (& n , V , T , lnPhi = lnPhi , P = P , dPdV = dPdV , dPdT = dPdT , dPdn = dPdn & ) end block lnphi_vt_p Fugacity (V,T): lnfug_vt returns , using fugacity numerically\nin bar, rather than its coefficient. For positive component amounts, Unlike lnphi_vt , its derivatives are at fixed or : dlnfdT holds fixed, dlnfdV holds fixed, and dlnfdn holds and the other component amounts fixed. In particular, Use positive amounts in this example. At zero amount, has a\nsingular limit: the current routine sets the corresponding lnf entry to\nzero as an implementation convention, not the physical log fugacity,\nand composition derivatives can divide by zero. fugacity_vt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: lnf ( 2 ) real ( pr ) :: dlnfdV ( 2 ) real ( pr ) :: dlnfdT ( 2 ) real ( pr ) :: dlnfdn ( 2 , 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) call model % lnfug_vt (& n , V , T , lnf = lnf , & dlnfdV = dlnfdV , dlnfdT = dlnfdT , dlnfdn = dlnfdn & ) end block fugacity_vt Residual entropy (V,T): MM - Chapter 2 - Equation 17 We start explaining the residual entropy because it is the easiest property to\ncalculate. Also, helps us to understand how to calculate the next properties. Entropy describes the thermal and mixing contribution to the free energy. Sr is the total entropy correction relative to an ideal gas at the same\namounts, volume, and temperature (bar L/K). It is not total entropy, and its\nsign is not a stability test. The residual entropy is calculated as follows: And its derivatives: residual_entropy : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: Sr real ( pr ) :: SrV real ( pr ) :: SrT real ( pr ) :: Srn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) ! Calculate residual entropy and its derivatives call model % entropy_residual_vt ( n , V , T , Sr = Sr , SrT = SrT , SrV = SrV , Srn = Srn ) print * , \"Residual entropy: \" , Sr print * , \"SrV: \" , SrV print * , \"SrT: \" , SrT print * , \"Srn: \" , Srn end block residual_entropy Residual enthalpy (V,T): MM - Chapter 1 - Table 6 (Equation XII) MM - Chapter 2 - Equation 20 Enthalpy combines internal energy and the pressure–volume term,\nmaking it useful in constant-pressure energy balances. Hr is only its\nnonideal correction, in bar L. To obtain total enthalpy, add a compatible\nideal-gas value, ; for a mixture, , with a specified reference for each species.\nBecause ideal-gas enthalpy depends only on temperature and amounts, the\nsame- residual and same- departure enthalpies coincide at the\nsame real-fluid state. Their derivatives have different constraints. The residual enthalpy is calculated as follows: We know that pressure can be calculated as: Then, we can obtain: And we also know how to calculate residual entropy as: Then, we can obtain the residual enthalpy as: And its derivatives: residual_enthalpy : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: Hr real ( pr ) :: HrV real ( pr ) :: HrT real ( pr ) :: Hrn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) ! Calculate residual enthalpy and its derivatives call model % enthalpy_residual_vt ( n , V , T , Hr = Hr , HrV = HrV , HrT = HrT , Hrn = Hrn ) print * , \"Residual enthalpy: \" , Hr print * , \"HrV: \" , HrV print * , \"HrT: \" , HrT print * , \"Hrn: \" , Hrn end block residual_enthalpy Residual Gibbs free energy (V,T): MM - Chapter 1 - Table 6 (Equation VI) Gibbs energy is the potential used for equilibrium at fixed\npressure and temperature. The routine here returns a same-volume residual,\nnot the same-pressure departure used in root comparisons. In particular, is the same-pressure departure Gibbs energy;\nsubtract from the result below to obtain it. The residual Gibbs free energy is calculated as follows: As with residual enthalpy we can easily deduce: For that: And its derivatives: residual_gibbs : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: Gr real ( pr ) :: GrV real ( pr ) :: GrT real ( pr ) :: Grn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) ! Calculate residual Gibbs free energy and its derivatives call model % gibbs_residual_vt ( n , V , T , Gr = Gr , GrV = GrV , GrT = GrT , Grn = Grn ) print * , \"Residual Gibbs free energy: \" , Gr print * , \"GrV: \" , GrV print * , \"GrT: \" , GrT print * , \"Grn: \" , Grn end block residual_gibbs Little check of algebraic transformations: From MM - Chapter 2 - Equation 22 we know that: From MM - Chapter 1 - Table 6 (Equations IX, XII, and XIII) we know that: Replacing on the first equation we have: Which of course lead us to: And we have established that: Replacing all the properties in the equation lead us to: With a very little algebra the equality is satisfied: Residual internal energy (V,T): MM - Chapter 1 - Table 6 (Equation IV) Internal energy excludes the term in enthalpy. Ur is its\ntotal nonideal correction (bar L), to be added to ideal-gas internal energy.\nThe residual internal energy is calculated as follows: Therefore: And its derivatives: residual_internal_energy : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: Ur real ( pr ) :: UrV real ( pr ) :: UrT real ( pr ) :: Urn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) ! Calculate residual internal energy and its derivatives call model % internal_energy_residual_vt ( n , V , T , Ur = Ur , UrV = UrV , UrT = UrT , Urn = Urn ) print * , \"Residual internal energy: \" , Ur print * , \"UrV: \" , UrV print * , \"UrT: \" , UrT print * , \"Urn: \" , Urn end block residual_internal_energy Residual constant volume heat capacity (V,T): MM - Chapter 1 - Table 6 (Equation III) Heat capacity measures the energy change per kelvin on a specified path. ; the Cv output here is , not total , in bar L/K.\nThe residual constant volume heat capacity is calculated as follows: residual_cv : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: Cv n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) ! Calculate residual constant volume heat capacity call model % Cv_residual_vt ( n , V , T , Cv = Cv ) print * , \"Residual constant volume heat capacity: \" , Cv end block residual_cv Residual constant pressure heat capacity (V,T): MM - Chapter 1 - Table 6 (Equation VII) , even when its state is\nspecified by . The Cp output is , not total . Add in the same units for the total;\na negative residual heat capacity alone does not mean a negative total heat\ncapacity. In particular, HrT from enthalpy_residual_vt is not , since it holds volume rather than pressure fixed. The residual constant pressure heat capacity is calculated as follows: From MM - Chapter 1 - Equation A37 we know that: With a direct replacement: We can replace all the terms to obtain an expression completely expressed in\nterms of residual Helmholtz . residual_cp : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: Cp n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K V = 2 5.0_pr ! Set total volume to 25 L (molar volume 25 L/mol) ! Calculate residual constant pressure heat capacity call model % Cp_residual_vt ( n , V , T , Cp = Cp ) print * , \"Residual constant pressure heat capacity: \" , Cp end block residual_cp The constant-pressure formulas divide by .\nNear a spinodal or critical point this derivative approaches zero, so heat\ncapacities and transformed derivatives may become very large or numerically\nill-conditioned. They describe a homogeneous branch, not the heat capacity of\na two-phase sample whose phase amounts change with temperature. Residual properties at (n, P, T) As explained in the “Residual properties at ” section, a residual\nproperty is the difference between the actual property and the ideal gas\nproperty. At , the difference is made against an ideal gas at\nthe same pressure of the real fluid, for that, the real fluid and the ideal\ngas are at different volumes: For the same real-fluid state, , , , and are unchanged because their ideal-gas counterparts depend only on temperature\nand amounts. , , and require the corrections\ngiven below. For these three, a _pt routine is therefore not simply the _vt residual evaluated at the solved volume. To obtain the\nexpression of these properties in term of the properties we will need\nthe derivatives of : If desired, all the volume derivatives can be expressed in terms of as: From MM - Chapter 1 - Equation A39 From MM - Chapter 1 - Equation A36 Finally, we have to understand the chain rule… Fugacity coefficients (P,T): There is no need for a direct way of calculating natural logarithm the fugacity\ncoefficients specifying and since we can solve volume from those\nspecifications and then calculate the fugacity coefficients using the method. For that reason you can choose the root of the volume\nthat you want to use to calculate the fugacity coefficients in the same way as\nthe volume method. lnphi_pt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: lnPhi ( 2 ) real ( pr ) :: dlnPhidP ( 2 ) real ( pr ) :: dlnPhidT ( 2 ) real ( pr ) :: dlnPhidn ( 2 , 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % lnphi_pt (& n , P , T , root_type = \"liquid\" , lnPhi = lnPhi , & dlnPhidP = dlnPhidP , dlnPhidT = dlnPhidT , dlnPhidn = dlnPhidn & ) call model % lnphi_pt (& n , P , T , root_type = \"vapor\" , lnPhi = lnPhi , & dlnPhidP = dlnPhidP , dlnPhidT = dlnPhidT , dlnPhidn = dlnPhidn & ) call model % lnphi_pt (& n , P , T , root_type = \"stable\" , lnPhi = lnPhi , & dlnPhidP = dlnPhidP , dlnPhidT = dlnPhidT , dlnPhidn = dlnPhidn & ) end block lnphi_pt As in the method you can take advantage and the retrieve\nthe value of the calculated volume and the pressure derivatives. lnphi_pt_v : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: V real ( pr ) :: lnPhi ( 2 ) real ( pr ) :: dPdV real ( pr ) :: dPdT real ( pr ) :: dPdn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % lnphi_pt (& n , P , T , V = V , root_type = \"stable\" , lnPhi = lnPhi , & dPdV = dPdV , dPdT = dPdT , dPdn = dPdn & ) end block lnphi_pt_v Residual Helmholtz free energy (P, T): MM - Chapter 1 - Table 6 (Equation VIII) The can be calculated as follows: And its derivatives: ar_pt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Ar real ( pr ) :: ArP real ( pr ) :: ArT real ( pr ) :: Arn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % helmholtz_residual_pt (& n , P , T , root_type = \"stable\" , Ar = Ar , ArP = ArP , ArT = ArT , Arn = Arn & ) end block ar_pt Residual entropy (P, T): MM - Chapter 1 - Table 6 (Equation IX) The residual entropy at can be calculated as follows: And its derivatives: Residual Enthalpy (P, T): MM - Chapter 1 - Table 6 (Equation XII) In this case we have a property that doesn’t change its value with the\nspecification. For that, its derivatives can be obtained as: hr_pt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Hr real ( pr ) :: HrP real ( pr ) :: HrT real ( pr ) :: Hrn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % enthalpy_residual_pt (& n , P , T , root_type = \"stable\" , Hr = Hr , HrP = HrP , HrT = HrT , Hrn = Hrn & ) end block hr_pt Residual Gibbs free energy (P, T): MM - Chapter 1 - Table 6 (Equation XIII) Residual Gibbs free energy can be obtained as follows: Therefore, the derivatives follow the same chain-rule pattern as residual\nHelmholtz free energy , with replacing : gr_pt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Gr real ( pr ) :: GrP real ( pr ) :: GrT real ( pr ) :: Grn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % gibbs_residual_pt (& n , P , T , root_type = \"stable\" , Gr = Gr , GrP = GrP , GrT = GrT , Grn = Grn & ) end block gr_pt Residual internal energy (P, T): MM - Chapter 1 - Table 6 (Equation XI) Residual internal energy can be obtained as follows: Therefore, its derivatives follow the same chain-rule pattern as enthalpy , with replacing : ur_pt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Ur real ( pr ) :: UrP real ( pr ) :: UrT real ( pr ) :: Urn ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % internal_energy_residual_pt (& n , P , T , root_type = \"stable\" , Ur = Ur , UrP = UrP , UrT = UrT , Urn = Urn & ) end block ur_pt Residual constant volume heat capacity (P,T): MM - Chapter 1 - Table 6 (Equation X) Residual constant volume heat capacity can be obtained\nas follows: cv_pt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Cv n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % Cv_residual_pt ( n , P , T , root_type = \"stable\" , Cv = Cv ) end block cv_pt Residual constant pressure heat capacity (P,T): MM - Chapter 1 - Table 6 (Equation XIV) Residual constant pressure heat capacity can be obtained\nas follows: cp_pt : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Cp n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % Cp_residual_pt ( n , P , T , root_type = \"stable\" , Cp = Cp ) end block cp_pt Excess properties (n, P, T) Excess properties measure departure from an ideal solution , not from an\nideal gas. They are not generally equal to the full change on mixing: an ideal\nsolution already has entropy and Gibbs energy of mixing. At the same and composition, For , the ideal-solution property is the sum of pure-component\nproperties: Where is the molar property of the pure component at the\nsame pressure and temperature as the mixture. For Gibbs and Helmholtz energies, add to this pure\nsum; for entropy, add . Those ideal-mixing terms\nmust be included before interpreting , , or .\nFor example, positive means expansion relative to the pure-volume sum,\nand negative means an enthalpy below the pure-enthalpy sum. The current routines use root_type for the mixture but always use \"stable\" roots for the pure-component references. This matters if you want\na liquid-standard-state activity coefficient while a pure component’s stable\nstate at the specified is vapor. These routines do not automatically\nconstruct hypothetical pure-liquid reference states. Derivatives assume a\nsmooth branch and are not derivatives across a reference-root switch. Activity coefficients (P, T): MM - Chapter 1 - Table 9 (Equation 1) The natural logarithm of the activity coefficient is given by: Where: is the fugacity coefficient of component in the mixture is the fugacity coefficient of component in the pure\n  state at the same pressure and temperature of the mixture. And its derivatives: MM - Chapter 1 - Table 9 (Equations V and VI) Where: and is the molar volume of pure component at the same\npressure and temperature as the mixture. ln_gamma : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: lngamma ( 2 ) real ( pr ) :: dlngammadT ( 2 ) real ( pr ) :: dlngammadP ( 2 ) real ( pr ) :: dlngammadn ( 2 , 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % ln_activity_coefficient (& n , P , T , root_type = \"stable\" , & lngamma = lngamma , dlngammadT = dlngammadT , dlngammadP = dlngammadP , & dlngammadn = dlngammadn & ) end block ln_gamma Excess Gibbs free energy (P, T): MM - Chapter 1 - Table 9 (Equation II) The excess Gibbs free energy can be calculated in terms of the activity\ncoefficients as follows: and its derivatives: Ge , GeP , and GeT are scalars; Gen has one entry per component.\nIn particular, Gen(i) is a first amount derivative (bar L/mol), not a\nmatrix of second derivatives. GeP has units L and GeT bar L/K. gibbs_excess : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Ge real ( pr ) :: GeP real ( pr ) :: GeT real ( pr ) :: Gen ( 2 ) n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % gibbs_excess (& n , P , T , root_type = \"stable\" , Ge = Ge , GeP = GeP , GeT = GeT , Gen = Gen & ) end block gibbs_excess Excess Enthalpy (P, T): MM - Chapter 1 - Table 9 (Equation III) The excess enthalpy can be calculated in terms of the activity coefficients as\nfollows: enthalpy_excess : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: He n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % enthalpy_excess ( n , P , T , root_type = \"stable\" , He = He ) end block enthalpy_excess Excess volume (P, T): MM - Chapter 1 - Table 9 (Equation IV) The excess volume can be calculated in terms of the activity coefficients as\nfollows: volume_excess : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Ve n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % volume_excess (& n , P , T , root_type = \"stable\" , Ve = Ve & ) end block volume_excess Excess entropy (P, T): The excess entropy can be calculated in terms of the activity coefficients as\nfollows: replacing and entropy_excess : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Se n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % entropy_excess ( n , P , T , root_type = \"stable\" , Se = Se ) end block entropy_excess Excess Helmholtz free energy (P, T): MM - Chapter 5 - Equation 1 The excess Helmholtz free energy can be calculated in terms of the activity\ncoefficients as follows: helmholtz_excess : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Ae n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % helmholtz_excess ( n , P , T , root_type = \"stable\" , Ae = Ae ) end block helmholtz_excess Excess Internal Energy (P, T): MM - Chapter 5 - Equation 4 The excess internal energy can be calculated in terms of the activity\ncoefficients as follows: Replacing: And with very little algebra: internal_energy_excess : block real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: Ue n = [ 0.3_pr , 0.7_pr ] ! Component amounts [mol]; total 1 mol, z = [0.3, 0.7] T = 30 0.0_pr ! Set temperature to 300 K P = 1.0_pr ! Set pressure to 1 bar call model % internal_energy_excess ( n , P , T , root_type = \"stable\" , Ue = Ue ) end block internal_energy_excess References [1] Michelsen, M. L., & Mollerup, J. M. (2007). Thermodynamic models:\nFundamentals & computational aspects (2. ed). Tie-Line Publications.","tags":"","url":"page/usage/eos/index.html"},{"title":"Cubics – yaeos","text":"Cubics What a cubic model does Required data and a first calculation Model variants and their parameters SoaveRedlichKwong PengRobinson76 PengRobinson78 RKPR PSRK Interpreting results and avoiding false confidence Next reading References Cubics What a cubic model does A cubic equation of state is a compact way to estimate fluid pressure, density\nand phase behavior from a small set of pure-component data. PR and SRK are\nuseful starting points for hydrocarbon mixtures; choosing one does not guarantee\naccurate liquid densities or strongly polar-mixture behavior. Compare with\nmeasurements in your temperature, pressure and composition range. Think of the model as a balance between molecules taking up space and molecules\nattracting one another. The first term below accounts for excluded volume; the\nsecond reduces pressure because of attraction. Here is pressure, is absolute temperature, is the gas constant, and is molar volume.\nThe covolume has units L/mol, the critical attraction parameter has units bar L²/mol², and , and the temperature\ncorrection are dimensionless. Reduced temperature is , where is the pure-component critical temperature.\nThe generic pure-fluid equation [1] is For a mixture, the mixing rule combines pure-component parameters.\nThe alpha function first adjusts each pure component’s attraction\nwith temperature: these are different jobs. PR, SRK and RKPR default to quadratic\nmixing with zero binary corrections unless supplied; PSRK uses an excess-Gibbs\nmixing rule instead. Required data and a first calculation For PR and SRK, supply arrays tc (K), pc (bar), and w (dimensionless\nacentric factor). The acentric factor summarizes pure-fluid vapor-pressure\nbehavior; it is not a composition. Every array must use the same component\norder. Optional kij and lij are dimensionless square matrices in that order,\nnormally symmetric with zero diagonals. They require a suitable parameter source\nor fitting; zero is a baseline, not a universal fit. This complete program uses methane then n-butane. It evaluates a specified\nhomogeneous state without asking an equilibrium solver to find a state.\nThe API takes mole amounts n (mol) and total V (L), not molar volume.\nHere the one-mole basis makes their numerical values coincide. program cubic_pressure use yaeos , only : pr , R , CubicEoS , PengRobinson76 implicit none type ( CubicEoS ) :: model real ( pr ) :: tc ( 2 ) real ( pr ) :: pc ( 2 ) real ( pr ) :: w ( 2 ) real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: P real ( pr ) :: Pideal tc = [ 19 0.564_pr , 42 5.12_pr ] pc = [ 4 5.99_pr , 3 7.96_pr ] w = [ 0.0115478_pr , 0.200164_pr ] model = PengRobinson76 ( tc , pc , w ) n = [ 0.3_pr , 0.7_pr ] T = 30 0.0_pr V = 1 0.0_pr call model % pressure ( n , V , T , P ) Pideal = sum ( n ) * R * T / V print * , \"Pressure [bar]: \" , P print * , \"Ideal-gas pressure [bar]: \" , Pideal print * , \"Compressibility Z [-]: \" , P / Pideal end program cubic_pressure Link this program with yaeos and its dependencies in your configured Fortran/fpm\nenvironment. pr is the library’s real kind; _pr literals avoid rounding inputs\nto default real precision. The dimensionless compressibility factor should approach one at small density. Scaling both n and V by the same positive factor should leave pressure unchanged. Model variants and their parameters Below, is critical pressure and is acentric factor.\nThe dimensionless alpha coefficient is a pure-component quantity, not a binary interaction . The b listed for each model is the\npure-component covolume; for PR and SRK it is also what the quadratic mixing\nrule combines. SoaveRedlichKwong Fortran definition: SoaveRedlichKwong . The SoaveRedlichKwong EoS uses the\nfollowing function and its respective correlation for . PengRobinson76 Fortran definition: PengRobinson76 . The Peng-Robinson EoS uses\nthe following function and correlation for k. PengRobinson78 Fortran definition: PengRobinson78 . The Peng-Robinson (1978) EoS is an\nvariant of the original Peng-Robinson (1976) equation with a different\nhigh-acentric-factor correlation. It uses the following function and\ncorrelation for k. RKPR RKPR The RKPR EoS [2] extends the classical formulation of Cubic Equations of State by\nfreeing the parameter and setting [1]. This extra degree provides extra ways of\nimplementing the equation in comparison of other Cubic EoS (like PR and SRK)\nwhich are limited to definition of their critical constants. Besides that extra parameter, the RKPR includes another function: Its constructor is RKPR(tc, pc, w, zc, kij, lij, delta_1, k) ; arguments after zc are optional. Here zc is the experimental critical compressibility , with the critical molar volume. RKPR needs\nthis additional pure-component information. Optional delta_1 and k arrays\neach have one entry per component. The implementation uses an effective critical compressibility 1.168*zc in\nits default shape correlation and numerically readjusts unspecified k values\nto match the acentric-factor definition at . This numerical fit is\nnot an unconditional convergence guarantee. The implemented correlations are\ndocumented with RKPR ; do not substitute experimental zc directly into an\nunrelated published correlation. Check that correlated parameters are finite,\nparticularly near the fractional-power correlation’s domain boundary. Because the refit solves a saturation condition per component, building\nan RKPR model is noticeably more expensive than building PR or SRK, and it can\nbe sensitive to the input zc values. PSRK PSRK The PSRK EoS [3,4] (Predictive Soave-Redlich-Kwong) is a Soave-Redlich-Kwong\ncubic equation of state that uses the MHV mixrule and a PSRK-UNIFAC model.\nThe alpha function is Soave by default, or AlphaMathiasCopeman when the\noptional c1 , c2 , and c3 parameters are provided. PSRK additionally needs one group decomposition per component, using the\nPSRK-UNIFAC group definitions and available interaction parameters. It does not\ninfer molecular structure from critical constants. Supply all three alpha\ncoefficient arrays together if overriding its default. See the group-contribution guide . Interpreting results and avoiding false confidence Use positive temperatures and volumes, nonnegative amounts and a positive\n  total amount. Volume must exceed the mixture covolume; approaching that\n  boundary makes pressure diverge. pressure evaluates a mathematical homogeneous state. It does not decide\n  whether that state will separate into liquid and vapor. At fixed pressure and temperature there can be several volume roots.\n  Requesting a liquid or vapor root is a branch choice, not proof that this\n  phase is globally stable. Negative pressures on stretched branches are not\n  a predicted operating pressure for an equilibrium vessel. A converged flash cannot repair unsuitable parameters. Conversely, a failed\n  flash is not proof the EOS is invalid. Check units, root selection, initial\n  guesses and material balances separately. Next reading Continue with mixing rules , alpha functions , and phase equilibrium . The EOS property guide explains the shared API, and thermodynamic fundamentals covers amounts,\ncompositions, units and the difference between a model and a solver. References [1] Michelsen, M. L., & Mollerup, J. M. (2007). Thermodynamic models:\nFundamentals & computational aspects (2. ed). Tie-Line Publications. [2] M. Cismondi, J. Mollerup, Development and application of a three-parameter \nRK–PR equation of state, Fluid Phase Equilibria 232 (2005) 74–89.\nhttps://doi.org/10.1016/j.fluid.2005.03.020. [3] Holderbaum, T., & Gmehling, J. (1991). PSRK: A Group Contribution Equation\nof State Based on UNIFAC. Fluid Phase Equilibria, 70(2-3), 251-265.\nhttps://doi.org/10.1016/0378-3812(91)85038-V [4] Horstmann, S., Jabłoniec, A., Krafczyk, J., Fischer, K., & Gmehling, J.\n(2005). PSRK group contribution equation of state: Comprehensive revision and\nextension IV, including critical constants and α-function parameters for 1000\ncomponents. Fluid Phase Equilibria, 227(2), 157-164.\nhttps://doi.org/10.1016/j.fluid.2004.11.002","tags":"","url":"page/usage/eos/cubics/index.html"},{"title":"Alpha functions – yaeos","text":"Why a cubic EOS needs an alpha function Implemented choices Soave RKPR Mathias-Copeman Complete example: install and inspect an alpha Custom functions and derivative checks Next reading Why a cubic EOS needs an alpha function Molecular attractions do not have the same effect at every temperature. A cubic\nEOS represents that change by multiplying a reference attraction parameter by\na dimensionless temperature correction. This is the pure-component part of\nthe model: a mixing rule subsequently combines components. Changing\nalpha is not a substitute for fitting binary interactions. For component , let be absolute temperature in K, its\ncritical temperature in K, and reduced temperature.\nThe critical attraction parameter and the temperature-dependent\nparameter both have units bar L²/mol². Then Built-in cubic constructors already provide an alpha function. Keep that default\nunless you have pure-fluid vapor-pressure data or a compatible published fit\nthat justifies a change. A more flexible alpha can improve a fit over its\ncalibration interval without ensuring good extrapolation or mixture predictions. Implemented choices Below, , , and are dimensionless pure-component coefficients. They are not the binary interaction , nor the NRTL\nnon-randomness parameter also often called alpha. Each coefficient array has\none entry per component in exactly the constructor’s component order. Soave AlphaSoave uses With the dimensionless acentric factor, the constructors use: Model Peng-Robinson 1976 Peng-Robinson 1978, Peng-Robinson 1978, Soave-Redlich-Kwong Its reduced-temperature derivatives are RKPR AlphaRKPR uses its component-specific exponent : The RKPR constructor estimates and numerically refits unspecified exponents\nusing the acentric factor and critical-compressibility information. See the cubic overview for its additional inputs and initialization caveats. Mathias-Copeman AlphaMathiasCopeman adds flexibility below the critical temperature.\nDefine . Then Thus c2 and c3 affect only the subcritical branch. PSRK uses this\nfunction when all three optional coefficient arrays are supplied; otherwise\nit uses Soave. The implementation supplies analytical derivatives in src/models/residual_helmholtz/cubic/alphas/alphas.f90 . Complete example: install and inspect an alpha This program installs the built-in Mathias-Copeman type rather than reimplementing\nit. The methane/n-butane critical data have the same order as the coefficient\narrays. The coefficients are illustrative: setting c2=c3=0 and using PR76’s k as c1 reproduces the Soave form, providing a useful consistency check,\nnot a new fitted parameter set. program alpha_comparison use yaeos , only : pr , CubicEoS , PengRobinson76 , AlphaMathiasCopeman implicit none type ( CubicEoS ) :: model type ( AlphaMathiasCopeman ) :: correction real ( pr ) :: tc ( 2 ) real ( pr ) :: pc ( 2 ) real ( pr ) :: w ( 2 ) real ( pr ) :: n ( 2 ) real ( pr ) :: Tr ( 2 ) real ( pr ) :: value ( 2 ) real ( pr ) :: first ( 2 ) real ( pr ) :: second ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: Pbefore real ( pr ) :: Pafter tc = [ 19 0.564_pr , 42 5.12_pr ] pc = [ 4 5.99_pr , 3 7.96_pr ] w = [ 0.0115478_pr , 0.200164_pr ] model = PengRobinson76 ( tc , pc , w ) n = [ 0.3_pr , 0.7_pr ] ! mol T = 30 0.0_pr ! K V = 1 0.0_pr ! total L call model % pressure ( n , V , T , Pbefore ) correction % c1 = 0.37464_pr + 1.54226_pr * w - 0.26993_pr * w ** 2 correction % c2 = [ 0.0_pr , 0.0_pr ] correction % c3 = [ 0.0_pr , 0.0_pr ] call model % set_alpha ( correction ) call model % pressure ( n , V , T , Pafter ) Tr = T / tc call correction % alpha ( Tr , value , first , second ) print * , \"Alpha values [-]: \" , value print * , \"d(alpha)/d(Tr): \" , first print * , \"d2(alpha)/d(Tr)2: \" , second print * , \"Pressure difference [bar]: \" , Pafter - Pbefore end program alpha_comparison The pressure difference should be zero to floating-point roundoff. Check each\ncomponent’s alpha at Tr=1 : these built-in forms give one there. At 300 K the\ntwo components in this example are on different sides of their critical\ntemperatures, so both Mathias-Copeman branches are exercised. set_alpha deallocates the previous polymorphic component before assigning the\nnew one. It is the preferred replacement method. To investigate a real fit,\nreplace the illustrative coefficients with documented values fitted to this\nEOS, then compare calculated pure-fluid saturation pressures with data. Custom functions and derivative checks AlphaFunction is the abstract parent. A new type extends it and overrides alpha . This interface sketch , not a standalone program, shows the\nrequired arguments: subroutine alpha ( self , Tr , a , dadt , dadt2 ) class ( MyAlpha ), intent ( in ) :: self real ( pr ), intent ( in ) :: Tr (:) real ( pr ), intent ( out ) :: a (:) real ( pr ), intent ( out ) :: dadt (:) real ( pr ), intent ( out ) :: dadt2 (:) ! Supply alpha and its first two derivatives with respect to Tr. end subroutine alpha All arrays have one entry per component. Despite the argument name a , this\nprocedure returns dimensionless alpha, not the attraction parameter.\nDespite the names dadt and dadt2 , these are derivatives with respect to reduced temperature. The cubic model performs the chain-rule conversion: Returning absolute-temperature derivatives here would apply the conversion\ntwice. Pressure alone may not reveal the error; residual energy properties and\nsolver derivatives can be wrong. Compare analytical derivatives with finite\ndifferences away from branch boundaries, and inspect continuity at boundaries\nseparately. Use positive Tr ; square roots and inverse powers are undefined\nor singular at nonpositive values. Squared expressions ensure nonnegative alpha, but do not guarantee physically\nreasonable high-temperature trends. Check the fitted range, critical-point\nnormalization and derivative behavior before extrapolating. Numerical\nconvergence of a saturation calculation is distinct from accuracy of the fit. Next reading example/advanced/new_alpha_function.f90 contains a complete custom-type\nimplementation. Continue with mixing rules , the EOS property guide , thermodynamic fundamentals , and saturation calculations .\nModel references are collected on the cubic overview .","tags":"","url":"page/usage/eos/cubics/alpha.html"},{"title":"Mixing Rules – yaeos","text":"Turning pure-fluid parameters into a mixture Which rules are available? Quadratic mixing (QMR) Complete example: comparing a binary correction Temperature-dependent quadratic mixing (QMRTD) Cubic composition mixing (CMR and CMRTD) Complete example: constant and temperature-dependent tensors Mixing with an excess-Gibbs model Huron-Vidal Modified Huron-Vidal (MHV) Specialized NRTL-HV coupling Complete example: installing each excess-Gibbs rule Density-dependent local compositions (s-DDLC) Complete example: install a density-dependent rule Extending and checking a rule Next reading Turning pure-fluid parameters into a mixture A cubic EOS first calculates each pure component’s attraction and covolume.\nA mixing rule answers the next question: how do unlike molecules interact?\nIt combines those parameters into a single-fluid representation of the mixture.\nChanging it can change phase behavior even if every pure-fluid curve stays\nunchanged. It is not the same as an alpha function , which sets the\ntemperature dependence of each pure component’s attraction. Every CubicEoS contains a CubicMixRule . Start with quadratic mixing\nfor a simple baseline. Consider excess-Gibbs mixing when liquid non-ideality\nand an appropriate activity-coefficient parameterization matter. Neither choice\nreplaces checking against experimental mixture data. Which rules are available? Rule Unlike-interaction data What changes relative to QMR? QMR Two dimensionless (nc,nc) matrices k , l The usual pairwise baseline QMRTD k , l , k0 , Tref , all (nc,nc) Attraction corrections vary with temperature CMR Two dimensionless (nc,nc,nc) tensors k , l Composition enters through component triplets CMRTD k , l , k0 , Tref , all (nc,nc,nc) Temperature-dependent triplet corrections HV A GeModel plus the cubic’s b and del1 Matches an infinite-pressure excess-energy relation MHV A GeModel , the cubic’s b , a nonzero q , and optional lij Uses an approximate zero-pressure relation HV_NRTL Specialized NRTL-HV parameters plus a pair-selection mask and kij Allows selected pairs to use QMR-style corrections sDDLC QMR-temperature-law matrices plus positive segment sizes q(:) The attractive mixture parameter also depends on density Here nc is the number of components. Temperature scales Tref are in K;\nNRTL-HV energy parameters have their own units, explained below. These are\nalternative formulations, not an accuracy ranking. A fitted parameter belongs\nto its EOS, alpha function, mixing rule, and temperature convention together.\nIn particular, a QMR pair matrix is not a CMR triplet tensor. Quadratic mixing (QMR) Let be the amount of component in mol, the total\namount, and its mole fraction. The pure attraction parameter has units bar L²/mol² and covolume has units L/mol.\nThe dimensionless binary corrections and modify attraction\nand covolume, respectively. Define the unlike-pair parameters and , and the mixture molar parameters and , by Internally the library uses total-volume parameters and : Thus B is in L, not L/mol. With zero lij , this reduces to . Positive kij weakens unlike attraction at fixed pure\nparameters; it does not mean an equilibrium pressure must change in the same\ndirection in every calculation. Complete example: comparing a binary correction This methane/n-butane example compares pressure before and after replacing\nthe default mixing rule. The correction 0.05_pr is illustrative , not a\nrecommended fitted value. All vectors and both matrix axes use methane first,\nn-butane second. Matrices are dimensionless, symmetric and zero on the diagonal. program mixing_comparison use yaeos , only : pr , CubicEoS , PengRobinson76 , QMR implicit none type ( CubicEoS ) :: model type ( QMR ) :: rule real ( pr ) :: tc ( 2 ) real ( pr ) :: pc ( 2 ) real ( pr ) :: w ( 2 ) real ( pr ) :: kij ( 2 , 2 ) real ( pr ) :: lij ( 2 , 2 ) real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: V real ( pr ) :: Pbase real ( pr ) :: Pmodified tc = [ 19 0.564_pr , 42 5.12_pr ] pc = [ 4 5.99_pr , 3 7.96_pr ] w = [ 0.0115478_pr , 0.200164_pr ] model = PengRobinson76 ( tc , pc , w ) n = [ 0.3_pr , 0.7_pr ] ! mol T = 30 0.0_pr ! K V = 1 0.0_pr ! total L call model % pressure ( n , V , T , Pbase ) kij = 0.0_pr lij = 0.0_pr kij ( 1 , 2 ) = 0.05_pr kij ( 2 , 1 ) = kij ( 1 , 2 ) rule = QMR ( k = kij , l = lij ) call model % set_mixrule ( rule ) call model % pressure ( n , V , T , Pmodified ) print * , \"Default pressure [bar]: \" , Pbase print * , \"Modified pressure [bar]: \" , Pmodified end program mixing_comparison Passing kij=kij, lij=lij directly to PR/SRK/RKPR constructors is the simpler\nroute when no later replacement is needed. For a separately constructed QMR ,\ninitialize both matrices; do not leave allocatable fields unset. As checks, setting the correction to zero should recover the baseline, and\nusing only one component should recover its pure-fluid prediction. Agreement\nat one state does not validate bubble pressures or phase compositions elsewhere. Temperature-dependent quadratic mixing (QMRTD) QMRTD uses the same covolume rule, but its binary attraction correction\ndepends on absolute temperature (K). Here is the\nhigh-temperature limiting value, is an exponential amplitude\n(both dimensionless), and is a positive reference temperature in K: In particular, the field k0 is an amplitude , not the value at zero\ntemperature. k stores the high-temperature limit. Use the convention in\nthis equation when transferring fitted parameters from another package. The following is a replacement snippet for the example above: add these\ndeclarations to its specification section, add QMRTD to its use list,\nthen replace the construction and assignment of rule with these statements.\nThe numbers are illustrative, not fitted methane/n-butane parameters. ! Additional declarations (before executable statements): type ( QMRTD ) :: td_rule real ( pr ) :: k0 ( 2 , 2 ) real ( pr ) :: Tref ( 2 , 2 ) ! Executable replacement: k0 = 0.0_pr k0 ( 1 , 2 ) = 0.02_pr k0 ( 2 , 1 ) = k0 ( 1 , 2 ) Tref = 19 0.0_pr td_rule = QMRTD ( k = kij , l = lij , k0 = k0 , Tref = Tref ) call model % set_mixrule ( td_rule ) Keep all Tref entries positive, including diagonals: the implementation\nevaluates an entire matrix expression before selecting pair entries. Symmetry\nand component ordering must hold for k , k0 , l and Tref alike. Avoid\nextrapolating temperature fits beyond their data range. Cubic composition mixing (CMR and CMRTD) “Cubic” here describes the composition mixing polynomial , not a new\npressure equation. CMR still plugs into CubicEoS . Unlike QMR’s double sum,\nit combines three component indices, including repeated indices: The extensive parameters remain D = n**2 * a_m and B = n * b_m : The denominators are essential when amounts do not sum to one. Triplet tensors\nare useful even for a binary mixture: entries such as (1,1,2) and (1,2,2) weight its two unlike composition terms differently. With three\ncomponents there are also all-distinct triplets. Initialize every entry and use the same value for every permutation of a\ntriplet: for example, (1,1,2) , (1,2,1) , and (2,1,1) must agree. Set the\npure-component entries (i,i,i) to zero to preserve the pure-fluid parameters.\nWith l=0 , the covolume reduces to linear mixing. With both tensors zero,\nthe CMR attraction is generally not QMR: it gives , rather than . CMRTD uses the same exponential convention as QMRTD, but for each triplet: k0 is again an amplitude, not the correction at zero temperature. Keep Tref positive and respect permutation symmetry in every tensor. Complete example: constant and temperature-dependent tensors The following program constructs both rules. The off-pure entries are\ndeliberately simple illustrative parameters , not a fit to this mixture. program triplet_mixing use yaeos , only : pr , CubicEoS , PengRobinson76 , CMR , CMRTD implicit none type ( CubicEoS ) :: model type ( CMR ) :: constant_rule type ( CMRTD ) :: temperature_rule real ( pr ) :: k3 ( 2 , 2 , 2 ) real ( pr ) :: l3 ( 2 , 2 , 2 ) real ( pr ) :: amplitude ( 2 , 2 , 2 ) real ( pr ) :: reference_temperature ( 2 , 2 , 2 ) real ( pr ) :: n ( 2 ) real ( pr ) :: pressure integer :: i integer :: j integer :: k model = PengRobinson76 ([ 19 0.564_pr , 42 5.12_pr ], & [ 4 5.99_pr , 3 7.96_pr ], [ 0.0115478_pr , 0.200164_pr ]) n = [ 0.3_pr , 0.7_pr ] k3 = 0.0_pr l3 = 0.0_pr amplitude = 0.0_pr reference_temperature = 20 0.0_pr do i = 1 , 2 do j = 1 , 2 do k = 1 , 2 if ( i /= j . or . j /= k ) then k3 ( i , j , k ) = 0.02_pr amplitude ( i , j , k ) = 0.01_pr end if end do end do end do constant_rule = CMR ( k = k3 , l = l3 ) call model % set_mixrule ( constant_rule ) call model % pressure ( n , 1 0.0_pr , 30 0.0_pr , pressure ) print * , \"CMR pressure [bar]: \" , pressure temperature_rule = CMRTD ( k = k3 , l = l3 , k0 = amplitude , & Tref = reference_temperature ) call model % set_mixrule ( temperature_rule ) call model % pressure ( n , 1 0.0_pr , 30 0.0_pr , pressure ) print * , \"CMRTD pressure [bar]: \" , pressure end program triplet_mixing Setting amplitude=0 must make CMRTD reproduce the CMR result with the\nsame tensors. It is not a test against QMR. Also check pure limits and joint\namount/volume scaling before using fitted tensors in equilibrium calculations. Mixing with an excess-Gibbs model An excess-Gibbs model describes how liquid mixing differs from ideal mixing.\nCoupling it to a cubic EOS can introduce liquid-mixture information while the\nEOS still supplies volumetric properties. A successful coupling needs a\ncompatible model, parameter convention and component order; arbitrary NRTL\nparameters are not automatically transferable between mixing-rule variants. For the equations below, is total excess Gibbs energy in bar L, is in bar L/(mol K), and is in K. The previously defined , , , , and retain their meanings. Huron-Vidal HV uses an infinite-pressure limiting relation. For a common cubic shape,\nlet and be its dimensionless denominator parameters,\nand define the positive shape factor . The sign convention used by\nthe implementation is Do not insert a factor RT on only one side: every term here has units bar L.\nFor PR and SRK, all components share the same cubic shape, so this factor is\ncomposition independent. A formulation with composition-dependent shape, such\nas RKPR, must also account for its derivatives; the displayed relation alone\nis not a complete derivative implementation. Modified Huron-Vidal (MHV) MHV uses an approximate zero-pressure relation. Its dimensionless constant belongs to the chosen cubic/mixing formulation, not to a freely fitted\nbinary interaction. With the library’s convention, The constructor is MHV(ge=ge_model, b=model%b, q=q) with optional lij .\nBuild ge_model with parameters appropriate to the intended formulation, then\nuse call model%set_mixrule(mixrule) . See the complete repository example example/basics/7_huron_vidal.f90 for setup. PSRK configures MHV with q=-0.64663_pr and PSRK-UNIFAC itself. MHV supports a repulsive lij matrix in the implementation, but the\nstandard MHV derivation uses linear covolume mixing. Keep lij=0 unless you\nhave a justified, consistently parameterized extension. q must be nonzero;\nits appropriate value depends on the cubic and the chosen matching convention. Specialized NRTL-HV coupling HV_NRTL is a mixing rule; NRTLHV is the excess-Gibbs model it contains.\nThey are not interchangeable objects. Its constructor requires all of b , del1 , alpha , gji0 , gjiT , use_kij , and kij . For a pair with use_kij(j,i)=.false. , the rule uses the supplied NRTL-HV\nenergy differences and non-randomness parameter. For a selected pair it\nconstructs the QMR-style interaction internally from the cubic attraction,\ncovolumes, and kij , and sets the corresponding non-randomness parameter to\nzero. Supply both matrix directions consistently for each selected pair.\nInitialize kij even if no pair selects it. The NRTL-HV law uses referenced differences , with gji0 in bar L/mol and gjiT in bar L/(mol K). These are not the ordinary NRTL constructor’s\ndimensionless a and kelvin-valued b matrices. The NRTL-HV guide explains the conventions. Complete example: installing each excess-Gibbs rule This example uses SRK and illustrative liquid-interaction parameters to show\nthe three setup paths. It does not imply that HV, MHV, and NRTL-HV with these\ndifferent parameter choices should predict the same pressure or phase diagram. program excess_gibbs_mixing use yaeos , only : pr , CubicEoS , SoaveRedlichKwong , NRTL , HV , MHV , HV_NRTL implicit none type ( CubicEoS ) :: model type ( NRTL ) :: ge type ( HV ) :: hv_rule type ( MHV ) :: mhv_rule type ( HV_NRTL ) :: specialized_rule real ( pr ) :: a ( 2 , 2 ) real ( pr ) :: b_temperature ( 2 , 2 ) real ( pr ) :: alpha ( 2 , 2 ) real ( pr ) :: g0 ( 2 , 2 ) real ( pr ) :: gT ( 2 , 2 ) real ( pr ) :: kij ( 2 , 2 ) real ( pr ) :: lij ( 2 , 2 ) logical :: use_kij ( 2 , 2 ) real ( pr ) :: n ( 2 ) real ( pr ) :: pressure model = SoaveRedlichKwong ([ 19 0.564_pr , 42 5.12_pr ], & [ 4 5.99_pr , 3 7.96_pr ], [ 0.0115478_pr , 0.200164_pr ]) n = [ 0.3_pr , 0.7_pr ] a = 0.0_pr a ( 1 , 2 ) = 0.2_pr a ( 2 , 1 ) = 0.4_pr b_temperature = 0.0_pr alpha = 0.3_pr alpha ( 1 , 1 ) = 0.0_pr alpha ( 2 , 2 ) = 0.0_pr ge = NRTL ( a , b_temperature , alpha ) ! HV uses the public components of its derived-type constructor. hv_rule = HV ( ge = ge , bi = model % b , del1 = model % del1 ) call model % set_mixrule ( hv_rule ) call model % pressure ( n , 1 0.0_pr , 30 0.0_pr , pressure ) print * , \"HV pressure [bar]: \" , pressure lij = 0.0_pr mhv_rule = MHV ( ge = ge , b = model % b , q =- 0.593_pr , lij = lij ) call model % set_mixrule ( mhv_rule ) call model % pressure ( n , 1 0.0_pr , 30 0.0_pr , pressure ) print * , \"MHV pressure [bar]: \" , pressure g0 = 0.0_pr g0 ( 1 , 2 ) = 1 0.0_pr g0 ( 2 , 1 ) = 2 0.0_pr gT = 0.0_pr use_kij = . false . kij = 0.0_pr specialized_rule = HV_NRTL ( b = model % b , del1 = model % del1 , & alpha = alpha , gji0 = g0 , gjiT = gT , use_kij = use_kij , kij = kij ) call model % set_mixrule ( specialized_rule ) call model % pressure ( n , 1 0.0_pr , 30 0.0_pr , pressure ) print * , \"NRTL-HV pressure [bar]: \" , pressure end program excess_gibbs_mixing The cubic supplies model%b in L/mol and model%del1 in its component order.\nThe separate name b_temperature avoids confusing ordinary NRTL’s temperature\nmatrix with those cubic covolumes. The installed rule owns a copy of the data;\nmodifying a local rule or activity model afterwards does not update the EOS\nuntil you install the changed rule again. Density-dependent local compositions (s-DDLC) sDDLC lets the attractive mixture parameter depend on volume as well as\ntemperature and composition. Its picture is that molecular neighbors need not\nhave the same proportions as the bulk mixture, and that this local weighting\nchanges with density. It inherits QMRTD’s pairwise temperature law and covolume\nrule, then adds a positive dimensionless segment-size vector q(:) . The following equations describe the implemented attractive weighting. Define\nthe total segment amount and segment fractions . With the same pair attraction as QMRTD, V is total volume in L. The segment sizes are model parameters, not the\ninstantaneous number of moles; changing their common scale also changes the\nexponential weighting. Use the convention associated with a fitted data set.\nAt large volume, E tends to one and the attraction approaches the corresponding\nQMRTD result. In a pure-component limit the weighting cancels from D . Because D now depends on volume, its volume and mixed derivatives matter for\npressure and other properties. Use the sDDLC constructor , which sets the is_D_ddlc flag used by CubicEoS ; do not merely copy matrices into a different\nrule type. Keep q and Tref positive, and avoid overflows in the exponential\nat very high density or outside the fitted range. Complete example: install a density-dependent rule program density_dependent_mixing use yaeos , only : pr , CubicEoS , PengRobinson76 , sDDLC implicit none type ( CubicEoS ) :: model type ( sDDLC ) :: rule real ( pr ) :: kij ( 2 , 2 ) real ( pr ) :: amplitude ( 2 , 2 ) real ( pr ) :: reference_temperature ( 2 , 2 ) real ( pr ) :: lij ( 2 , 2 ) real ( pr ) :: q ( 2 ) real ( pr ) :: n ( 2 ) real ( pr ) :: pressure model = PengRobinson76 ([ 19 0.564_pr , 42 5.12_pr ], & [ 4 5.99_pr , 3 7.96_pr ], [ 0.0115478_pr , 0.200164_pr ]) kij = 0.0_pr amplitude = 0.0_pr reference_temperature = 20 0.0_pr lij = 0.0_pr q = [ 1.0_pr , 3.0_pr ] ! Illustrative segment sizes, not fitted data. n = [ 0.3_pr , 0.7_pr ] rule = sDDLC ( k = kij , k0 = amplitude , Tref = reference_temperature , l = lij , q = q ) call model % set_mixrule ( rule ) call model % pressure ( n , 1.0_pr , 30 0.0_pr , pressure ) print * , \"s-DDLC pressure [bar]: \" , pressure end program density_dependent_mixing This is a homogeneous-state property example, not evidence of a stable phase\nsplit. Compare with the base rule at large volume, then check volume and\ncomposition derivatives before moving to a saturation or envelope calculation. Extending and checking a rule To change the attractive combining rule, extend QMR and override its\ntype-bound aij procedure. get_aij is an interface name, not an assignable\nprocedure-pointer component. The override must supply pair parameters and their\nfirst and second absolute-temperature derivatives; see QMR and the source\ninterface. Incorrect derivatives can leave pressure plausible while breaking\nheat capacities or equilibrium Jacobians. For QMR-family corrections, use symmetric matrices with zero self-interactions\neven where the implementation only reads one triangle; CMR-family tensors\nneed permutation symmetry. This does not require the directed interaction\nmatrices of an activity model to be symmetric. Verify the corresponding\npure-fluid and zero-correction limits,\nand check pressure and derivative consistency before attempting a difficult\nflash. A solver’s convergence says nothing about whether fitted interactions\nremain physically adequate outside their calibration range. For a CMR extension, override aijk and return rank-three parameter and\ntemperature-derivative tensors; do not use QMR’s rank-two interface. For an\nentirely different mixing expression, extend CubicMixRule and implement Dmix , Bmix , and D1mix . Density dependence also requires the density-aware\nenergy path. The Fortran developer guide describes these contracts. Next reading Read alpha functions for the pure-component part, excess-Gibbs models for liquid non-ideality, phase equilibrium for using the model\nin saturation and flash calculations, and thermodynamic fundamentals for the shared\nconventions. The cubic theory reference is Michelsen and Mollerup (2007),\nlisted on the cubic overview .","tags":"","url":"page/usage/eos/cubics/mixing.html"},{"title":"GERG2008 – yaeos","text":"GERG2008 Theory Why a Helmholtz energy The mixture residual energy Composition-dependent reducing functions Which pairs have a departure function Data requirements Complete example: build, evaluate, saturate A second example: temperature scan at fixed density Implementation details Interpretation, checks and pitfalls Limits of the model versus limits of the solver Next reading References GERG2008 The GERG2008 equation of state is a multifluid model for natural-gas\nmixtures. It is based on the reduced Helmholtz energy and is the reference model\nof the GERG2008 monograph by Kunz and Wagner. Use it when your mixture is built from the 21 components the model supports and\nyou want a well-documented reference calculation without assembling critical\nconstants, binary interaction parameters or a mixing rule yourself. Compared\nwith a cubic EOS, the model is more expensive to evaluate and it comes with a\nfixed parameterization: you cannot supply your own pure-component or binary\ndata. This page explains what the model computes, what data it needs (very little),\nhow to build it, and how to read its results. Theory Why a Helmholtz energy An equation of state relates pressure, volume and temperature. A Helmholtz\nenergy model stores the same information in a thermodynamic potential whose\nderivatives give the other properties. yaeos uses the residual Helmholtz\nenergy : the difference between the real fluid and an ideal gas at the\nsame amount, volume and temperature. Let be the amount of component in mol, the total\namount, the mole fraction, the absolute temperature in K,\nand the total volume in L. The residual Helmholtz energy is where is the dimensionless reduced residual Helmholtz energy and is the gas constant in bar L/(mol K). The reduced density and\nreduced inverse temperature are with the molar density in mol/L, the reducing\ndensity in mol/L, and the reducing temperature in K (not the reduced\ntemperature used on the cubic pages). Each pure fluid keeps its own\naccurate Helmholtz equation, and the composition-dependent and combine them into a mixture: this is the “multifluid” idea. The mixture residual energy The implementation splits the reduced residual energy into a pure-fluid part\nand a binary departure part: where is the number of components. The are the\ntabulated pure-component residual Helmholtz energies of component , and is the departure function of the pair . The\ndimensionless factor scales a pair’s departure function; it is zero\nfor pairs that have no departure function, in which case the pair contributes\nnothing to this sum. Composition-dependent reducing functions The reducing volume (L/mol) and reducing temperature (K) are\nbuilt from the pure-component critical data and the binary reducing parameters : Here is the critical volume of component in L/mol, its critical temperature in K, and its\ncritical density in mol/L. Every binary pair has reducing parameters, so the\nmixture critical behavior changes with composition even when no departure\nfunction is present. Which pairs have a departure function Only some pairs carry a binary departure function. In the tabulated data the\nfollowing pairs have one (the numbers are the internal GERG2008 table indices,\nlisted in the component table further down; the coefficients of each function\nare on the GERG2008 parameters page): Pair Components 1-2 methane + nitrogen 1 1-3 methane + carbon dioxide 1 1-4 methane + ethane 1 1-5 methane + propane 1 1-6 methane + n-butane 1 1-7 methane + isobutane 0.771035405688 1-15 methane + hydrogen 1 2-3 nitrogen + carbon dioxide 1 2-4 nitrogen + ethane 1 4-5 ethane + propane 0.130424765150 4-6 ethane + n-butane 0.281570073085 4-7 ethane + isobutane 0.260632376098 5-6 propane + n-butane 0.0312572600489 5-7 propane + isobutane -0.0551609771024 6-7 n-butane + isobutane -0.0551240293009 For every other pair (for example methane + water, methane + n-pentane,\ncarbon dioxide + water, or anything involving helium or argon) the mixture\ninteraction is described only by the composition-dependent reducing\nfunctions. This is a property of the parameterization, not a numerical\nfailure, and it is worth knowing before using the model for a mixture that\nrelies on a strong unlike attraction, such as a water-bearing gas. Data requirements The only input the model needs is the list of components . Pure-component\ncoefficients, binary departure functions, binary reducing parameters and the\ncritical constants all come from the built-in GERG2008 tables, listed in full\non the GERG2008 parameters page. The model type\nis Gerg2008 and it is built with gerg_2008 . The identifiers are fields of the public object G2008Components : Identifier Component Identifier Component methane Methane nonane n-Nonane nitrogen Nitrogen decane n-Decane carbon_dioxide Carbon dioxide hydrogen Hydrogen ethane Ethane oxygen Oxygen propane Propane carbon_monoxide Carbon monoxide nbutane n-Butane water Water isobutane Isobutane hydrogen_sulfide Hydrogen sulfide npentane n-Pentane helium Helium isopentane Isopentane argon Argon nhexane n-Hexane nheptane n-Heptane noctane n-Octane Note The component names are fields of G2008Components , not integer constants.\nUse G2008Components%methane , for example, not methane . The order of the identifiers is the order of the model. Every composition\nvector, amount vector and property result follows that order. Listing the same\ncomponents in a different order gives a different model object, so build the\nidentifier list once and reuse it; do not reorder it between calls. The public API uses mol, total L, K and bar , exactly like the other models.\nThe critical data of the selected components are available afterwards through model%components%tc (K), %pc (bar), %w (acentric factor) and %vc (L/mol), which is useful when you want to see what the model believes about a\ncomponent. Complete example: build, evaluate, saturate This program builds a methane + nitrogen model, evaluates a homogeneous state,\nand then asks a separate solver for the bubble point at the same temperature.\nAt a bubble point the input amounts describe the liquid phase, and sat%y is the incipient vapor composition. program gerg_example use yaeos , only : pr , R , Gerg2008 , gerg_2008 , G2008Components use yaeos , only : EquilibriumState , saturation_pressure use , intrinsic :: ieee_arithmetic , only : ieee_is_finite implicit none type ( Gerg2008 ) :: model type ( EquilibriumState ) :: sat real ( pr ) :: n ( 2 ) real ( pr ) :: T real ( pr ) :: P real ( pr ) :: V real ( pr ) :: Pideal real ( pr ) :: Z ! Methane first, nitrogen second: this fixes the component order. model = gerg_2008 ([ & G2008Components % methane , & G2008Components % nitrogen & ]) n = [ 0.9_pr , 0.1_pr ] ! mol; total 1 mol, so x = [0.9, 0.1] T = 15 0.0_pr ! K V = 1.0_pr ! total L call model % pressure ( n , V , T , P ) if (. not . ieee_is_finite ( P )) error stop \"Nonfinite pressure\" Pideal = sum ( n ) * R * T / V Z = P / Pideal print * , \"Pressure [bar]: \" , P print * , \"Compressibility Z [-]: \" , Z sat = saturation_pressure ( model , n , T , kind = \"bubble\" ) if (. not . ieee_is_finite ( sat % P )) error stop \"Nonfinite bubble pressure\" if ( sat % P <= 0.0_pr ) error stop \"Invalid bubble pressure\" if (. not . all ( ieee_is_finite ( sat % y ))) error stop \"Nonfinite vapor composition\" print * , \"Saturation pressure [bar]: \" , sat % P print * , \"Vapor composition: \" , sat % y end program gerg_example How to read this output: The compressibility factor compares the model with an ideal\n  gas at the same state. Here because attractive interactions reduce\n  the pressure; at very low density it should approach one. The bubble pressure is not the pressure of the state evaluated above. pressure evaluates the equation of state at a volume you choose; the\n  saturation routine searches for the state where liquid and vapor coexist. The vapor composition is enriched in the more volatile component, as\n  expected at a bubble point. A second example: temperature scan at fixed density This complete program evaluates pressure at a fixed volume over a range of\ntemperatures. It is a model evaluation only: it does not look for phases. program gerg_density_scan use yaeos , only : pr , Gerg2008 , gerg_2008 , G2008Components implicit none type ( Gerg2008 ) :: model real ( pr ) :: n ( 2 ) real ( pr ) :: V real ( pr ) :: T real ( pr ) :: P integer :: i model = gerg_2008 ([ & G2008Components % methane , & G2008Components % nitrogen & ]) n = [ 0.9_pr , 0.1_pr ] V = 1.0_pr do i = 0 , 5 T = 15 0.0_pr + 2 0.0_pr * real ( i , pr ) call model % pressure ( n , V , T , P ) print * , \"T =\" , T , \"K, P =\" , P , \"bar\" end do end program gerg_density_scan This figure is a scan of the model at one volume. It is an illustration of the\nAPI, not a validation dataset: compare the curve with experimental data for\nthe mixture before drawing conclusions from it. Implementation details Gerg2008 extends ArModelAdiff , so all the standard ArModel methods are\navailable, including pressure , volume , lnphi_pt , the residual property\nroutines and the phase-equilibrium routines. The model is evaluated with automatic differentiation using hyperdual numbers,\nso first and second derivatives with respect to amount, volume and temperature\ncome from the same code path. The volume method is specialized: it uses a Newton solver in log-volume,\ninitialized with the Soave-Redlich-Kwong volume. This is necessary because the\nGERG2008 Helmholtz function does not provide a simple analytical covolume. The\nroot selection \"liquid\" , \"vapor\" and \"stable\" behaves as in the other\nmodels: \"stable\" compares the Gibbs energy of the two roots. The model overrides ln_activity_coefficient : each pure-fluid reference is\nevaluated with a separate one-component GERG2008 model. Interpretation, checks and pitfalls Useful checks on a first run: Ideal-gas limit. Increase the volume at fixed temperature and\n  composition; the pressure must approach sum(n)*R*T/V and . Order independence of the result. Building the model with the\n  components in the opposite order and swapping the amounts accordingly gives\n  the same pressure to machine precision. A different answer means the\n  composition vector no longer matches the model order. Component sanity. model%components%tc and %pc come from the tables,\n  not from your input, and are a quick way to confirm that the right\n  components were selected. Root verification. After volume , call pressure with the returned\n  volume and compare with the requested pressure. Pitfalls specific to this model: A failed volume solve returns a negative volume. The solver returns instead of a physical volume when Newton iteration does not\n  converge. Always check that the volume is positive before using it; a\n  negative volume propagated into a pressure call gives a meaningless number\n  rather than an error. No user parameters. There is no way to supply your own pure-component\n  coefficients or binary interactions to gerg_2008 . If you need them, use a\n  model that accepts them, such as a cubic EOS with mixing rules or PC-SAFT. Departure functions are limited. As listed above, many pairs have no\n  departure function. Mixtures such as methane + water or carbon dioxide +\n  water are therefore described only through the reducing functions. The model is a fixed parameterization. It was developed for natural-gas\n  mixtures. Using it far outside that range is possible but the original\n  parameterization no longer guarantees accuracy. A converged calculation is not a validated one. Solver convergence says\n  nothing about whether the model describes your system; that requires\n  comparison with experimental data. Limits of the model versus limits of the solver These are different failures and deserve different responses: Symptom Likely cause What to do Volume solve returns Newton iteration did not converge Check that the state is inside the model’s range; try a different root_type Bubble or flash routine fails to converge Phase-equilibrium solver, not the model Supply better initial guesses ( p0 , y0 , t0 ) or a better starting state Converged but implausible result Model or parameters unsuitable for the system Compare with data; check the component set and the pair coverage listed above Next reading Thermodynamic fundamentals for amounts,\n  compositions, units and the difference between a model and a solver. Saturation points for bubble\n  and dew points and the checks that apply to them. GERG2008 parameters for the complete tables of\n  pure-fluid constants and coefficients, binary reducing parameters and\n  departure functions. Cubic EOS when you need to supply your own critical\n  data and binary interactions, or when cost matters. References Kunz, O., & Wagner, W. (2012). The GERG-2008 wide-range equation of state for\n  natural gases and other mixtures: an expansion of GERG-2004. Journal of\n  Chemical & Engineering Data , 57(11), 3032-3091. app/gerg_properties.f90 contains a runnable property calculation.","tags":"","url":"page/usage/eos/gerg2008.html"},{"title":"GERG2008 parameters – yaeos","text":"GERG2008 parameters Pure-fluid constants Pure-fluid residual coefficients 1. Methane 2. Nitrogen 3. Carbon dioxide 4. Ethane 5. Propane 6. n-Butane 7. Isobutane 8. n-Pentane 9. Isopentane 10. n-Hexane 11. n-Heptane 12. n-Octane 13. n-Nonane 14. n-Decane 15. Hydrogen 16. Oxygen 17. Carbon monoxide 18. Water 19. Hydrogen sulfide 20. Helium 21. Argon Binary reducing parameters Binary departure functions Methane + nitrogen (1-2) Methane + carbon dioxide (1-3) Methane + ethane (1-4) Methane + propane (1-5) Methane + hydrogen (1-15) Nitrogen + carbon dioxide (2-3) Nitrogen + ethane (2-4) Generalized departure function Next reading References GERG2008 parameters This page lists every parameter that yaeos uses to evaluate the GERG2008 residual Helmholtz energy: the pure-fluid\nconstants, the pure-fluid residual coefficients, the binary reducing\nparameters and the binary departure functions. Use it to check what the model\nassumes about a component or a pair, or to compare yaeos with another\nimplementation. The tables were generated from the values that the compiled module yaeos__models_ar_multifluid_parameters_gerg2008 ( src/models/residual_helmholtz/multifluid/parameters_gerg2008.f90 ) holds\nafter it loads its tables, and were checked against the literals in that file.\nThey describe the code, so if the source changes, the source wins. How to read the tables: Indices. and are the internal GERG2008 table indices, equal\n  to the values of the G2008Components fields ( G2008Components%methane is\n  1, G2008Components%argon is 21). They are not the component order of\n  a model built with gerg_2008 : the constructor picks the rows and pairs\n  that belong to the identifiers you pass. Pair order. Binary parameters are listed once per pair, with . The reverse order is derived, as explained in Binary reducing parameters . Residual part only. yaeos implements only the residual contribution.\n  The module also stores the ideal-gas coefficients ( n0i , th0i ) of the\n  original formulation, but no yaeos routine uses them, so they are not\n  listed here. Pure-fluid constants Id Identifier Component [g/mol] [K] [mol/L] [L/mol] [bar] 1 methane Methane 16.04246 190.564 10.139342719 0.098626 46 0.011 2 nitrogen Nitrogen 28.0134 126.192 11.1839 0.089414 33.9 0.039 3 carbon_dioxide Carbon dioxide 44.0095 304.1282 10.624978698 0.094118 73.8 0.239 4 ethane Ethane 30.06904 305.322 6.87085454 0.145542 48.8 0.099 5 propane Propane 44.09562 369.825 5.000043088 0.199998 42.5 0.153 6 nbutane n-Butane 58.1222 425.125 3.920016792 0.255101 38 0.199 7 isobutane Isobutane 58.1222 407.817 3.86014294 0.259058 36.5 0.183 8 npentane n-Pentane 72.14878 469.7 3.215577588 0.310986 33.7 0.251 9 isopentane Isopentane 72.14878 460.35 3.271 0.305717 33.9 0.227 10 nhexane n-Hexane 86.17536 507.82 2.705877875 0.369566 30.1 0.299 11 nheptane n-Heptane 100.20194 540.13 2.315324434 0.431905 27.4 0.349 12 noctane n-Octane 114.22852 569.32 2.056404127 0.486286 24.9 0.398 13 nonane n-Nonane 128.2551 594.55 1.81 0.552486 22.81 0.4433 14 decane n-Decane 142.28168 617.7 1.64 0.609756 21.03 0.4884 15 hydrogen Hydrogen 2.01588 33.19 14.94 0.066934 12.964 -0.219 16 oxygen Oxygen 31.9988 154.595 13.63 0.073368 50.43 0.0222 17 carbon_monoxide Carbon monoxide 28.0101 132.86 10.85 0.092166 34.94 0.0497 18 water Water 18.01528 647.096 17.87371609 0.055948 220.64 0.3442920843 19 hydrogen_sulfide Hydrogen sulfide 34.08088 373.1 10.19 0.098135 90 0.1005 20 helium Helium 4.002602 5.1953 17.399 0.057475 2.276 -0.3836 21 argon Argon 39.948 150.687 13.407429659 0.074586 48.63 -0.00219 and are the critical temperature and critical density of each pure-fluid equation. They reduce the pure-fluid equations and build the mixture reducing functions and described on the GERG2008 page . is computed by yaeos (shown here rounded to six decimals) and is what model%components%vc returns. The other columns are not used by the GERG2008 Helmholtz energy: is stored in the module but not used by any yaeos routine. and only build the Soave-Redlich-Kwong model that\n  provides initial volumes for the volume solver, and they are what model%components%pc and %w return. The source gives in Pa\n  and yaeos converts it to bar. Pure-fluid residual coefficients The reduced residual Helmholtz energy of pure fluid is where are dimensionless coefficients, and are\ninteger density exponents and are temperature exponents. In the mixture,\nevery pure-fluid term is evaluated at the mixture reduced density and reduced inverse temperature , not at the\npure-fluid critical values. applies only to the exponential terms, so it is shown as “–” for the\npolynomial terms ( ). Many fluids share the same term counts and exponents , , and differ only in : methane, nitrogen and ethane (1, 2, 4)\nshare one set, and fluids 5 to 14, 16, 17, 19 and 21 share another. Carbon\ndioxide, hydrogen, water and helium each have their own. Every fluid still\nhas its complete table below. 1. Methane , . 1 0.57335704239162 1 0.125 – 2 -1.676068752373 1 1.125 – 3 0.23405291834916 2 0.375 – 4 -0.21947376343441 2 1.125 – 5 0.016369201404128 4 0.625 – 6 0.01500440638928 4 1.5 – 7 0.098990489492918 1 0.625 1 8 0.58382770929055 1 2.625 1 9 -0.7478686756039 1 2.75 1 10 0.30033302857974 2 2.125 1 11 0.20985543806568 3 2 1 12 -0.018590151133061 6 1.75 1 13 -0.15782558339049 2 4.5 2 14 0.12716735220791 3 4.75 2 15 -0.032019743894346 3 5 2 16 -0.068049729364536 4 4 2 17 0.024291412853736 4 4.5 2 18 0.0051440451639444 2 7.5 3 19 -0.019084949733532 3 14 3 20 0.0055229677241291 4 11.5 3 21 -0.0044197392976085 5 26 6 22 0.040061416708429 6 28 6 23 -0.033752085907575 6 