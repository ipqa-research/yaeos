efile~huron_vidal.f90->sourcefile~generic_cubic.f90 sourcefile~huron_vidal.f90->sourcefile~quadratic_mixing.f90 sourcefile~huron_vidal.f90->sourcefile~nrtl_hv.f90 sourcefile~quadratic_mixing.f90->sourcefile~generic_cubic.f90 sourcefile~nrtl_hv.f90->sourcefile~autodiff.f90 sourcefile~sddlc.f90->sourcefile~quadratic_mixing.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module yaeos__math_continuation !! # Numerical continuation !! Predictor-corrector continuation of nonlinear solution curves. !! !! # Description !! The module defines callback interfaces and a continuation driver for !! tracing solutions of F(X,S)=0 as a scalar specification S !! changes. At each accepted point the routine solves for the local tangent !! dX/dS, predicts the next state, and corrects it with a nonlinear !! solver. The caller may customize the specification update, post-processing, !! point solver, and stopping condition. !! !! # Examples !! ```fortran !! curve = continuation(fun, X0, ns0, S0, dS0, & !!    max_points=100, solver_tol=1.0e-8_pr) !! ``` use yaeos__constants , only : pr use yaeos__math_linalg , only : solve_system implicit none type :: ContinuationVariable !! # ContinuationVariable !! State of the unknown vector and specification at one curve point. !! !! # Description !! Records which component is specified, that component's value and the !! proposed step for the next point. !! !! # Examples !! ```fortran !! point%X = [P, T, V] !! point%ns = 1 !! point%S = P !! point%dS = 0.1_pr !! ``` real ( pr ), allocatable :: X (:) !! Unknown vector at the point. integer :: ns !! Index of the component of X used as the specification. real ( pr ) :: S !! Value of the specified variable. real ( pr ) :: dS !! Signed step proposed for the next continuation point. end type ContinuationVariable abstract interface subroutine continuation_function ( X , ns , S , F , dF , dFdS ) !! # continuation_function !! Evaluate the nonlinear residual and its local derivatives. !! !! # Description !! The equations are F(X,S)=0. Return the Jacobian with respect !! to X and the derivative with respect to the scalar S. import pr real ( pr ), intent ( in ) :: X (:) !! Current unknown vector. integer , intent ( in ) :: ns !! Index of the specified entry in X. real ( pr ), intent ( in ) :: S !! Current specification value. real ( pr ), intent ( out ) :: F (:) !! Residual vector, zero at a solution. real ( pr ), intent ( out ) :: dF (:, :) !! Jacobian \\partial F/\\partial X. real ( pr ), intent ( out ) :: dFdS (:) !! Derivative \\partial F/\\partial S. end subroutine continuation_function end interface abstract interface subroutine process ( X , ns , S , dS , dXdS , iterations ) !! Subroutine to make variation in the method after a point converged import pr real ( pr ), intent ( in out ) :: X (:) !! Vector of variables X integer , intent ( in out ) :: ns !! Position of specified variable real ( pr ), intent ( in out ) :: S !! Specification variable value real ( pr ), intent ( in out ) :: dS !! Step of specification in the method real ( pr ), intent ( in out ) :: dXdS (:) !! \\frac{dX}{dS} integer , intent ( in ) :: iterations !! Iterations needed to converge point end subroutine process logical function continuation_stopper ( X , ns , S , dS , dXdS , iterations ) !! # continuation_stopper !! !! # Description !! Function that returns true if the method should stop import pr real ( pr ), intent ( in out ) :: X (:) !! Vector of variables X integer , intent ( in out ) :: ns !! Position of specified variable real ( pr ), intent ( in out ) :: S !! Specification variable value real ( pr ), intent ( in out ) :: dS !! Step of specification in the method real ( pr ), intent ( in out ) :: dXdS (:) !! \\frac{dX}{dS} integer , intent ( in ) :: iterations !! Iterations needed to converge point end function continuation_stopper end interface abstract interface subroutine continuation_solver (& fun , iters , X , ns , S , dS , dXdS , point , max_iters , F , dF , dFdS , tol & ) !! # continuation_solver !! !! # Description !! Solver to solve a point during numerical continuation. import pr , continuation_function procedure ( continuation_function ) :: fun !! Function to solve integer , intent ( out ) :: iters !! Number of iterations needed real ( pr ), intent ( in out ) :: X (:) !! Variables vector integer , intent ( in ) :: ns !! Specification number real ( pr ), intent ( in ) :: S !! Specification value real ( pr ), intent ( in ) :: dS !! Delta spec real ( pr ), intent ( in ) :: dXdS (:) !! Tangent dX/dS used for the predictor integer , intent ( in ) :: point !! Point number integer , intent ( in ) :: max_iters !! Maximum iterations real ( pr ), intent ( out ) :: F (:) !! Function values at solved point real ( pr ), intent ( out ) :: df (:, :) !! Jacobian values real ( pr ), intent ( out ) :: dfds (:) !! dFdS real ( pr ), intent ( in ) :: tol !! Solver tolerance end subroutine continuation_solver end interface contains function continuation (& f , X0 , ns0 , S0 , dS0 , max_points , solver_tol , & update_specification , postprocess , solver , stop & ) result ( XS ) !! # continuation !! Trace a one-dimensional solution manifold of a nonlinear system. !! !! # Description !! At each point the tangent is obtained from !! !!  \\frac{dX}{dS} = -\\left(\\frac{\\partial F}{\\partial X}\\right)&#94;{-1} !!       \\frac{\\partial F}{\\partial S}.  !! !! The tangent predicts the next point; `solver` (or the default Newton !! corrector) then solves the residual equations there. The default !! specification update selects the component of the tangent with the !! largest magnitude, rescales the tangent to it and converts the step to !! that variable (no step-size limit is applied). Tracing stops when the !! corrector reaches its iteration limit (500), the residual is NaN, !! `dS` becomes zero, or `stop` returns true. The returned array has `max_points` rows; rows not reached !! before termination remain zero. !! !! # Examples !! ```fortran !! curve = continuation(fun, X0, ns0, S0, dS0, & !!    max_points=100, solver_tol=1.0e-8_pr) !! ``` procedure ( continuation_function ) :: f !! Residual and derivative callback for F(X,S)=0. real ( pr ), intent ( in ) :: X0 (:) !! Initial converged unknown vector. integer , intent ( in ) :: ns0 !! Index of the initially specified variable in `X0`. real ( pr ), intent ( in ) :: S0 !! Initial value of the specified variable. real ( pr ), intent ( in ) :: dS0 !! Signed first step in the specification. integer , intent ( in ) :: max_points !! Maximum number of continuation points to store. real ( pr ), intent ( in ) :: solver_tol !! Residual tolerance for the point corrector. procedure ( process ), optional :: update_specification !! Optional callback to select the next specification and step. If absent, !! the tangent component of largest magnitude is selected and the step is !! scaled using that component: !! !! ```fortran !! ns = maxloc(abs(dXdS), dim=1) !! dS = dXdS(ns)*dS !! dXdS = dXdS/dXdS(ns) !! ``` procedure ( process ), optional :: postprocess !! Optional callback to modify the state or step after specification !! selection, for example to enforce bounds or change step direction. procedure ( continuation_solver ), optional :: solver !! Optional point corrector. The built-in Newton solver is used by default. procedure ( continuation_stopper ), optional :: stop !! Optional callback evaluated after each accepted point; true terminates !! continuation. real ( pr ) :: XS ( max_points , size ( X0 )) !! Stored solution vectors, one per row. real ( pr ) :: X ( size ( X0 )) real ( pr ) :: S real ( pr ) :: fval ( size ( X0 )) real ( pr ) :: dF ( size ( X0 ), size ( X0 )) real ( pr ) :: dFdS ( size ( X0 )) real ( pr ) :: dXdS ( size ( X0 )) integer :: ns real ( pr ) :: dS integer :: i !! Loop/index variable. integer :: newton_its integer :: max_iters = 500 X = X0 ns = ns0 dS = dS0 S = S0 XS = 0 do i = 1 , max_points if ( present ( solver )) then call solver (& f , newton_its , X , ns , S , dS , dXdS , i , max_iters , & fval , dF , dFdS , solver_tol & ) else call full_newton (& f , newton_its , X , ns , S , dS , dXdS , i , max_iters , & fval , dF , dFdS , solver_tol & ) end if if ( newton_its >= max_iters . or . dS == 0._pr . or . any ( isnan ( Fval ))) exit XS ( i , :) = X dXdS = solve_system ( dF , - dFdS ) if ( present ( update_specification )) then call update_specification ( X , ns , S , dS , dXdS , newton_its ) else ns = maxloc ( abs ( dXdS ), dim = 1 ) dS = dXdS ( ns ) * dS dXdS = dXdS / dXdS ( ns ) end if if ( present ( postprocess )) then call postprocess ( X , ns , S , dS , dXdS , newton_its ) end if if ( present ( stop )) then if ( stop ( X , ns , S , dS , dXdS , newton_its )) exit end if if ( dS == 0 ) exit X = X + dXdS * dS S = X ( ns ) end do end function continuation subroutine full_newton (& fun , iters , X , ns , S , dS , dXdS , point , max_iters , F , dF , dFdS , tol & ) !! # full_newton !! !! # Description !! Correct one predicted continuation point with Newton's method. !! The correction solves F(X,S)=0 at fixed specification value, !! halving the Newton step until \\max|\\Delta X_i| \\le 0.1. It stops !! when \\max|\\Delta X_i/X_i| < 10&#94;{-5} or \\max|F_i| < `tol`. !! If iteration 10 is reached (for points after the first), X is reset !! to the previous point plus 10% of the predictor step. On failure !! `iters` ends at `max_iters + 1`. use yaeos__auxiliar , only : optval use yaeos__math_linalg , only : solve_system procedure ( continuation_function ) :: fun !! Residual/Jacobian callback. integer , intent ( out ) :: iters !! Newton iterations used for this point. real ( pr ), intent ( in out ) :: X (:) !! Predicted vector; corrected solution on return. integer , intent ( in ) :: ns !! Index of the specified variable. real ( pr ), intent ( in ) :: S !! Fixed specification value for this correction. real ( pr ), intent ( in ) :: dS !! Step used to form the predictor. real ( pr ), intent ( in ) :: dXdS (:) !! Tangent used by the predictor and recovery logic. integer , intent ( in ) :: point !! One-based continuation point number. integer , intent ( in ) :: max_iters !! Maximum Newton iterations for correction. real ( pr ), intent ( out ) :: F (:) !! Residual at the corrected point. real ( pr ), intent ( out ) :: df (:, :) !! Jacobian \\partial F/\\partial X. real ( pr ), intent ( out ) :: dfds (:) !! Derivative \\partial F/\\partial S. real ( pr ), intent ( in ) :: tol !! Residual (max-norm) convergence tolerance. real ( pr ) :: X0 ( size ( X )) real ( pr ) :: dX ( size ( X )) real ( pr ) :: solve_tol solve_tol = tol dX = 20 F = 500 X0 = X newton : do iters = 1 , max_iters call fun ( X , ns , S , F , dF , dFdS ) dX = solve_system ( dF , - F ) ! Converged point if ( maxval ( abs ( dx / x )) < 1e-5_pr . or . maxval ( abs ( F )) < tol ) exit newton ! Fix the step do while ( maxval ( abs ( dx )) > 0.1 ) dX = dX / 2 end do if ( iters == 10 . and . point > 1 ) then dX = X0 - 0.9 * dXdS * dS - X end if X = X + dX end do newton end subroutine full_newton ! subroutine levenberg_marquardt(& !    fun, iters, X, ns, S, dS, dXdS, point, max_iters, F, dF, dFdS, tol & !    ) !    use minpack_module, only: lmdif1 !    use yaeos__auxiliar, only: optval !    use yaeos__math_linalg, only: solve_system !    procedure(continuation_function) :: fun !! Function to solve !    integer,  intent(out) :: iters !! Number of iterations needed !    real(pr), intent(in out) :: X(:)  !! Variables vector !    integer, intent(in) :: ns !    real(pr), intent(in) :: S !    real(pr), intent(in) :: dS !    real(pr), intent(in) :: dXdS(:) !    integer, intent(in) :: point !    integer, intent(in) :: max_iters !! Maximum iterations !    real(pr), intent(out) :: F(:) !! Function values at solved point !    real(pr), intent(out) :: df(:, :) !! Jacobian values !    real(pr), intent(out) :: dfds(:) !! dFdS !    real(pr), intent(in) :: tol !    integer :: m, n, info, iwa(size(x)) !    integer :: lwa !    real(pr) :: wa(size(F) * size(x) + 5*size(x) + size(f)) !    m = size(F) !    n = size(x) !    lwa = size(F) * size(x)+5*size(x)+size(f) !    call lmdif1(fcn, m, n, x, F, tol, Info, Iwa, Wa, Lwa) !    contains !    subroutine fcn(m, n, xx, fvec, iflag) !       integer, intent(in) :: m, n !       real(pr), intent(in) :: xx(n) !       real(pr), intent(out) :: fvec(m) !       integer, intent(in out) :: iflag !       call fun(xx, ns, S, fvec, dF, dFdS) !    end subroutine ! end subroutine end module yaeos__math_continuation","tags":"","url":"sourcefile/continuation.f90.html"},{"title":"hyperdual.f90 – yaeos","text":"This file depends on sourcefile~~hyperdual.f90~~EfferentGraph sourcefile~hyperdual.f90 hyperdual.f90 sourcefile~constants.f90 constants.f90 sourcefile~hyperdual.f90->sourcefile~constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~hyperdual.f90~~AfferentGraph sourcefile~hyperdual.f90 hyperdual.f90 sourcefile~armodel_adiff_api.f90 armodel_adiff_api.f90 sourcefile~armodel_adiff_api.f90->sourcefile~hyperdual.f90 sourcefile~autodiff.f90 autodiff.f90 sourcefile~autodiff.f90->sourcefile~hyperdual.f90 sourcefile~autodiff.f90->sourcefile~armodel_adiff_api.f90 sourcefile~gemodel_adiff_api.f90 gemodel_adiff_api.f90 sourcefile~gemodel_adiff_api.f90->sourcefile~hyperdual.f90 sourcefile~gerg2008.f90 gerg2008.f90 sourcefile~gerg2008.f90->sourcefile~hyperdual.f90 sourcefile~gerg2008.f90->sourcefile~armodel_adiff_api.f90 sourcefile~implementations.f90~2 implementations.f90 sourcefile~gerg2008.f90->sourcefile~implementations.f90~2 sourcefile~huron_vidal.f90 huron_vidal.f90 sourcefile~huron_vidal.f90->sourcefile~hyperdual.f90 sourcefile~quadratic_mixing.f90 quadratic_mixing.f90 sourcefile~huron_vidal.f90->sourcefile~quadratic_mixing.f90 sourcefile~nrtl_hv.f90 nrtl_hv.f90 sourcefile~huron_vidal.f90->sourcefile~nrtl_hv.f90 sourcefile~quadratic_mixing.f90->sourcefile~hyperdual.f90 sourcefile~implementations.f90~2->sourcefile~huron_vidal.f90 sourcefile~implementations.f90~2->sourcefile~quadratic_mixing.f90 sourcefile~implementations.f90 implementations.f90 sourcefile~implementations.f90~2->sourcefile~implementations.f90 sourcefile~models.f90 models.f90 sourcefile~models.f90->sourcefile~gerg2008.f90 sourcefile~models.f90->sourcefile~huron_vidal.f90 sourcefile~models.f90->sourcefile~quadratic_mixing.f90 sourcefile~models.f90->sourcefile~implementations.f90~2 sourcefile~sddlc.f90 sddlc.f90 sourcefile~models.f90->sourcefile~sddlc.f90 sourcefile~models.f90->sourcefile~implementations.f90 sourcefile~nrtl_hv.f90->sourcefile~autodiff.f90 sourcefile~sddlc.f90->sourcefile~quadratic_mixing.f90 sourcefile~fluids.f90 fluids.f90 sourcefile~fluids.f90->sourcefile~models.f90 sourcefile~implementations.f90->sourcefile~nrtl_hv.f90 sourcefile~yaeos.f90 yaeos.f90 sourcefile~yaeos.f90->sourcefile~models.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module hyperdual_mod !! # Hyperdual arithmetic !! Type and overloaded operations for exact first- and second-order directional derivatives. !! !! # Description !! A hyperdual value stores a primal value and two independent tangent seeds: !! x=x_0+x_1\\varepsilon_1+x_2\\varepsilon_2+x_{12}\\varepsilon_1\\varepsilon_2. !! The nilpotent rules \\varepsilon_1&#94;2=\\varepsilon_2&#94;2=0 make the !! Taylor expansion exact through the mixed second derivative. Overloaded !! arithmetic and elementary functions propagate these coefficients, so !! derivatives are obtained without a finite-difference step-size error. !! For a scalar function the propagation rule is !! f(x)=f(x_0)+x_1f'(x_0)\\varepsilon_1+x_2f'(x_0)\\varepsilon_2 !!   +\\left(x_{12}f'(x_0)+x_1x_2f''(x_0)\\right)\\varepsilon_1\\varepsilon_2. !! Seeding x_1=x_2=1, x_{12}=0 gives f' in `f1`/`f2` and !! f'' in `f12`; seeding different variables in \\varepsilon_1 and !! \\varepsilon_2 gives mixed second derivatives. !! !! # Examples !! ```fortran !! type(hyperdual) :: x, y !! x = hyperdual(f0=2.0_pr, f1=1.0_pr, f2=1.0_pr) !! y = exp(x) !! print *, y%f0, y%f1, y%f2, y%f12 !! ``` !! !! # References !! Fike, J. A., and A. C. Alonso (2011). The Development of Hyper-Dual !! Numbers for Exact Second-Derivative Calculations. AIAA 49th Aerospace !! Sciences Meeting. DOI: 10.2514/6.2011-886. !! Rehner, P., and G. Bauer (2021). Application of Generalized (Hyper-) Dual !! Numbers in Equation of State Modeling. Frontiers in Chemical Engineering. !! DOI: 10.3389/fceng.2021.758090. ! ! Original code provided by Philipp Rehner and Gernot Bauer, ! Institute of Thermodynamics and Thermal Process Engineering (ITT), ! University of Stuttgart, Stuttgart, Germany use yaeos__constants , only : pr implicit none type , bind ( c ) :: hyperdual !! # hyperdual !! Scalar number carrying a primal value and two derivative seeds. !! !! # Description !! The fields store coefficients of 1, epsilon1, epsilon2, and their !! product. When `f1` and `f2` are seeded with unit directions, `f12` !! stores the corresponding mixed second derivative. !! !! # Examples !! ```fortran !! x = hyperdual(f0=x0, f1=1.0_pr, f2=1.0_pr) !! y = exp(x) !! print *, y%f12 !! ``` real ( pr ) :: f0 = 0 !! Primal value. real ( pr ) :: f1 = 0 !! Coefficient of the first tangent direction. real ( pr ) :: f2 = 0 !! Coefficient of the second tangent direction. real ( pr ) :: f12 = 0 !! Coefficient of the mixed second derivative. end type hyperdual !--------------------------------------------------------------------- !--- Operator interfaces --------------------------------------------- !--------------------------------------------------------------------- ! Equal assignment !> # assignment (=) !> Assigns a scalar or hyperdual value while preserving the four-component representation. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = x !> ``` interface assignment ( = ) procedure EqualHyperDualHyperDual procedure EqualHyperDualReal end interface ! Unary operator + !> # operator (+) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x + y !> ``` interface operator ( + ) procedure PlusHyperDualHyperDual end interface ! Addition operator !> # operator (+) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x + y !> ``` interface operator ( + ) procedure AddHyperDualHyperDual procedure AddHyperDualReal procedure AddRealHyperDual end interface ! Unary operator - !> # operator (-) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x - y !> ``` interface operator ( - ) procedure MinusHyperDualHyperDual end interface ! Subtraction operator !> # operator (-) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x - y !> ``` interface operator ( - ) procedure SubtractHyperDualHyperDual procedure SubtractHyperDualReal procedure SubtractRealHyperDual end interface ! Multiplication operator !> # operator (*) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x * y !> ``` interface operator ( * ) procedure MultiplyHyperDualHyperDual procedure MultiplyHyperDualReal procedure MultiplyRealHyperDual procedure MultiplyHyperDualInt procedure MultiplyIntHyperDual end interface ! Division operator !> # operator (/) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x / y !> ``` interface operator ( / ) procedure DivideHyperDualHyperDual procedure DivideHyperDualReal procedure DivideRealHyperDual end interface ! Power operator !> # operator (**) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x ** y !> ``` interface operator ( ** ) procedure PowerHyperDualInt procedure PowerHyperDualHyperDual procedure PowerHyperDualReal end interface !--------------------------------------------------------------------- !--- Summation interface --------------------------------------------- !--------------------------------------------------------------------- !> # sum !> Overloads the Fortran `sum` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = sum(x) !> ``` interface sum module procedure SumHyperDual module procedure SumHyperDual2 end interface sum !--------------------------------------------------------------------- !--- Logical operator interfaces ------------------------------------- !--------------------------------------------------------------------- ! Equal operator. !> # operator (.eq.) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x .eq. y !> ``` interface operator (. eq .) ! or (==) procedure eq_dd procedure eq_dr procedure eq_rd procedure eq_di procedure eq_id end interface ! Not equal operator. !> # operator (.ne.) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x .ne. y !> ``` interface operator (. ne .) ! or (/=) procedure ne_dd procedure ne_dr procedure ne_rd procedure ne_di procedure ne_id end interface ! Less than operator. !> # operator (.lt.) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x .lt. y !> ``` interface operator (. lt .) ! or (<) procedure lt_dd procedure lt_dr procedure lt_rd procedure lt_di procedure lt_id end interface ! Less than or equal operator. !> # operator (.le.) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x .le. y !> ``` interface operator (. le .) ! or (<=) procedure le_dd procedure le_dr procedure le_rd procedure le_di procedure le_id end interface ! Greater than operator. !> # operator (.gt.) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x .gt. y !> ``` interface operator (. gt .) ! or (>) procedure gt_dd procedure gt_dr procedure gt_rd procedure gt_di procedure gt_id end interface ! Greater than or equal operator. !> # operator (.ge.) !> Applies this arithmetic operation to hyperdual values and supported real/integer operands, propagating derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = x .ge. y !> ``` interface operator (. ge .) ! or (>=) procedure ge_dd procedure ge_dr procedure ge_rd procedure ge_di procedure ge_id end interface !--------------------------------------------------------------------- !--- Math function interfaces ---------------------------------------- !--------------------------------------------------------------------- ! Absolute value function !> # abs !> Overloads the Fortran `abs` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = abs(x) !> ``` interface abs module procedure absHyperDual end interface ! Integer function !> # int !> Overloads the Fortran `int` intrinsic; returns the conversion of the primal value `f0` and discards derivative information. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = int(x) !> ``` interface int module procedure intHyperDual end interface ! Nearest integer function !> # nint !> Overloads the Fortran `nint` intrinsic; returns the conversion of the primal value `f0` and discards derivative information. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = nint(x) !> ``` interface nint module procedure nintHyperDual end interface ! Real function !> # real !> Overloads the Fortran `real` intrinsic; returns the conversion of the primal value `f0` and discards derivative information. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = real(x) !> ``` interface real module procedure realHyperDual end interface ! Sign function !> # sign !> Overloads the Fortran `sign` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = sign(x, s) !> ``` interface sign module procedure sign_dd module procedure sign_dr module procedure sign_rd end interface ! Sine function !> # sin !> Overloads the Fortran `sin` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = sin(x) !> ``` interface sin module procedure sinHyperDual end interface ! Cosine function !> # cos !> Overloads the Fortran `cos` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = cos(x) !> ``` interface cos module procedure cosHyperDual end interface ! Tangent function !> # tan !> Overloads the Fortran `tan` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = tan(x) !> ``` interface tan module procedure tanHyperDual end interface ! Sqrt function !> # sqrt !> Overloads the Fortran `sqrt` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = sqrt(x) !> ``` interface sqrt module procedure sqrtHyperDual end interface ! Log function !> # log !> Overloads the Fortran `log` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = log(x) !> ``` interface log module procedure logHyperDual end interface ! Log10 function !> # log10 !> Overloads the Fortran `log10` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = log10(x) !> ``` interface log10 module procedure log10HyperDual end interface ! Exp function !> # exp !> Overloads the Fortran `exp` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = exp(x) !> ``` interface exp module procedure expHyperDual end interface ! Sinh function !> # sinh !> Overloads the Fortran `sinh` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = sinh(x) !> ``` interface sinh module procedure sinhHyperDual end interface ! Cosh function !> # cosh !> Overloads the Fortran `cosh` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = cosh(x) !> ``` interface cosh module procedure coshHyperDual end interface ! Tanh function !> # tanh !> Overloads the Fortran `tanh` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = tanh(x) !> ``` interface tanh module procedure tanhHyperDual end interface ! Acos function !> # acos !> Overloads the Fortran `acos` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = acos(x) !> ``` interface acos module procedure acosHyperDual end interface ! Asin function !> # asin !> Overloads the Fortran `asin` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = asin(x) !> ``` interface asin module procedure asinHyperDual end interface ! Atan function !> # atan !> Overloads the Fortran `atan` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> y = atan(x) !> ``` interface atan module procedure atanHyperDual end interface ! Atan2 function !> # atan2 !> Overloads the Fortran `atan2` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = atan2(y, x) !> ``` interface atan2 module procedure atan2HyperDual end interface ! Max function (limited to combinations below, but that ! can be extended) !> # max !> Overloads the Fortran `max` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = max(x, y) !> ``` interface max module procedure max_dd module procedure max_ddd module procedure max_dr module procedure max_rd end interface ! Min function (limited for now to 2 arguments, but that ! can be extended) !> # min !> Overloads the Fortran `min` intrinsic for hyperdual arguments, propagating supported derivative coefficients. !> !> # Description !> The generic interface selects a type-specific implementation based on the argument types. !> !> # Examples !> ```fortran !> z = min(x, y) !> ``` interface min module procedure min_dd module procedure min_dr module procedure min_rd end interface !===================================================================== contains !------------------------------------------------------------------- !--- Functions for the equal assignment. --------------------------- !------------------------------------------------------------------- !> # EqualHyperDualHyperDual !> Assign a real or hyperdual value. !> !> # Description !> Copies the source scalar or all four hyperdual coefficients into the destination. !> !> # Examples !> ```fortran !> result = value !> ``` elemental subroutine EqualHyperDualHyperDual ( res , inp ) implicit none type ( hyperdual ), intent ( out ) :: res !! Output operation result. type ( hyperdual ), intent ( in ) :: inp !! First input operand. res % f0 = inp % f0 res % f1 = inp % f1 res % f2 = inp % f2 res % f12 = inp % f12 end subroutine EqualHyperDualHyperDual !> # EqualHyperDualReal !> Assign a real or hyperdual value. !> !> # Description !> Copies the source scalar or all four hyperdual coefficients into the destination. !> !> # Examples !> ```fortran !> result = value !> ``` elemental subroutine EqualHyperDualReal ( res , inp ) implicit none type ( hyperdual ), intent ( out ) :: res !! Output operation result. real ( pr ), intent ( in ) :: inp !! First input operand. res % f0 = inp res % f1 = 0.0_pr res % f2 = 0.0_pr res % f12 = 0.0_pr end subroutine EqualHyperDualReal !------------------------------------------------------------------- !--- Function for the unary operator +. ---------------------------- !------------------------------------------------------------------- !> # PlusHyperDualHyperDual !> Apply unary plus to a hyperdual value. !> !> # Description !> Returns the input with derivative coefficients unchanged. !> !> # Examples !> ```fortran !> y = +x !> ``` elemental function PlusHyperDualHyperDual ( v1 ) result ( v2 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ) :: v2 v2 % f0 = v1 % f0 v2 % f1 = v1 % f1 v2 % f2 = v1 % f2 v2 % f12 = v1 % f12 end function PlusHyperDualHyperDual !------------------------------------------------------------------- !--- Functions for the addition operator. -------------------------- !------------------------------------------------------------------- !> # AddHyperDualHyperDual !> Add operands. !> !> # Description !> Adds the primal and corresponding derivative coefficients. !> !> # Examples !> ```fortran !> z = x + y !> ``` elemental function AddHyperDualHyperDual ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 % f0 + v2 % f0 v3 % f1 = v1 % f1 + v2 % f1 v3 % f2 = v1 % f2 + v2 % f2 v3 % f12 = v1 % f12 + v2 % f12 end function AddHyperDualHyperDual !> # AddHyperDualReal !> Add operands. !> !> # Description !> Adds the primal and corresponding derivative coefficients. !> !> # Examples !> ```fortran !> z = x + y !> ``` elemental function AddHyperDualReal ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. real ( pr ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 % f0 + v2 v3 % f1 = v1 % f1 v3 % f2 = v1 % f2 v3 % f12 = v1 % f12 end function AddHyperDualReal !> # AddRealHyperDual !> Add operands. !> !> # Description !> Adds the primal and corresponding derivative coefficients. !> !> # Examples !> ```fortran !> z = x + y !> ``` elemental function AddRealHyperDual ( v1 , v2 ) result ( v3 ) real ( pr ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 + v2 % f0 v3 % f1 = v2 % f1 v3 % f2 = v2 % f2 v3 % f12 = v2 % f12 end function AddRealHyperDual !------------------------------------------------------------------- !--- Function for the unary operator -. ---------------------------- !------------------------------------------------------------------- !> # MinusHyperDualHyperDual !> Apply unary minus to a hyperdual value. !> !> # Description !> Negates the primal, tangent, and mixed-derivative coefficients. !> !> # Examples !> ```fortran !> y = -x !> ``` elemental function MinusHyperDualHyperDual ( v1 ) result ( v2 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ) :: v2 v2 % f0 = - v1 % f0 v2 % f1 = - v1 % f1 v2 % f2 = - v1 % f2 v2 % f12 = - v1 % f12 end function MinusHyperDualHyperDual !------------------------------------------------------------------- !--- Functions for the subtraction operator. ----------------------- !------------------------------------------------------------------- !> # SubtractHyperDualHyperDual !> Subtract operands. !> !> # Description !> Subtracts the primal and corresponding derivative coefficients. !> !> # Examples !> ```fortran !> z = x - y !> ``` elemental function SubtractHyperDualHyperDual ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 % f0 - v2 % f0 v3 % f1 = v1 % f1 - v2 % f1 v3 % f2 = v1 % f2 - v2 % f2 v3 % f12 = v1 % f12 - v2 % f12 end function SubtractHyperDualHyperDual !> # SubtractHyperDualReal !> Subtract operands. !> !> # Description !> Subtracts the primal and corresponding derivative coefficients. !> !> # Examples !> ```fortran !> z = x - y !> ``` elemental function SubtractHyperDualReal ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. real ( pr ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 % f0 - v2 v3 % f1 = v1 % f1 v3 % f2 = v1 % f2 v3 % f12 = v1 % f12 end function SubtractHyperDualReal !> # SubtractRealHyperDual !> Subtract operands. !> !> # Description !> Subtracts the primal and corresponding derivative coefficients. !> !> # Examples !> ```fortran !> z = x - y !> ``` elemental function SubtractRealHyperDual ( v1 , v2 ) result ( v3 ) real ( pr ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 - v2 % f0 v3 % f1 = - v2 % f1 v3 % f2 = - v2 % f2 v3 % f12 = - v2 % f12 end function SubtractRealHyperDual !------------------------------------------------------------------- !--- Functions for the multiplication operator. -------------------- !------------------------------------------------------------------- !> # MultiplyHyperDualHyperDual !> Multiply operands. !> !> # Description !> Applies the product rule to propagate first derivatives and the mixed second derivative. !> !> # Examples !> ```fortran !> z = x * y !> ``` elemental function MultiplyHyperDualHyperDual ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 % f0 * v2 % f0 v3 % f1 = v1 % f0 * v2 % f1 + v1 % f1 * v2 % f0 v3 % f2 = v1 % f0 * v2 % f2 + v1 % f2 * v2 % f0 v3 % f12 = v1 % f0 * v2 % f12 + v1 % f1 * v2 % f2 + v1 % f2 * v2 % f1 + v1 % f12 * v2 % f0 end function MultiplyHyperDualHyperDual !> # MultiplyHyperDualReal !> Multiply operands. !> !> # Description !> Applies the product rule to propagate first derivatives and the mixed second derivative. !> !> # Examples !> ```fortran !> z = x * y !> ``` elemental function MultiplyHyperDualReal ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. real ( pr ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 % f0 * v2 v3 % f1 = v1 % f1 * v2 v3 % f2 = v1 % f2 * v2 v3 % f12 = v1 % f12 * v2 end function MultiplyHyperDualReal !> # MultiplyRealHyperDual !> Multiply operands. !> !> # Description !> Applies the product rule to propagate first derivatives and the mixed second derivative. !> !> # Examples !> ```fortran !> z = x * y !> ``` elemental function MultiplyRealHyperDual ( v1 , v2 ) result ( v3 ) real ( pr ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 * v2 % f0 v3 % f1 = v1 * v2 % f1 v3 % f2 = v1 * v2 % f2 v3 % f12 = v1 * v2 % f12 end function MultiplyRealHyperDual !> # MultiplyHyperDualInt !> Multiply operands. !> !> # Description !> Applies the product rule to propagate first derivatives and the mixed second derivative. !> !> # Examples !> ```fortran !> z = x * y !> ``` elemental function MultiplyHyperDualInt ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. integer , intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 % f0 * v2 v3 % f1 = v1 % f1 * v2 v3 % f2 = v1 % f2 * v2 v3 % f12 = v1 % f12 * v2 end function MultiplyHyperDualInt !> # MultiplyIntHyperDual !> Multiply operands. !> !> # Description !> Applies the product rule to propagate first derivatives and the mixed second derivative. !> !> # Examples !> ```fortran !> z = x * y !> ``` elemental function MultiplyIntHyperDual ( v1 , v2 ) result ( v3 ) integer , intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 % f0 = v1 * v2 % f0 v3 % f1 = v1 * v2 % f1 v3 % f2 = v1 * v2 % f2 v3 % f12 = v1 * v2 % f12 end function MultiplyIntHyperDual !------------------------------------------------------------------- !--- Functions for the division operator. -------------------------- !------------------------------------------------------------------- !> # DivideHyperDualHyperDual !> Divide operands. !> !> # Description !> Applies the quotient rule to propagate primal and derivative coefficients. !> !> # Examples !> ```fortran !> z = x / y !> ``` elemental function DivideHyperDualHyperDual ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 v3 = v1 * v2 ** ( - 1 ) end function DivideHyperDualHyperDual !> # DivideHyperDualReal !> Divide operands. !> !> # Description !> Applies the quotient rule to propagate primal and derivative coefficients. !> !> # Examples !> ```fortran !> z = x / y !> ``` elemental function DivideHyperDualReal ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. real ( pr ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 real ( pr ) :: invV2 invV2 = 1.0_pr / v2 v3 = v1 * invV2 end function DivideHyperDualReal !> # DivideRealHyperDual !> Divide operands. !> !> # Description !> Applies the quotient rule to propagate primal and derivative coefficients. !> !> # Examples !> ```fortran !> z = x / y !> ``` elemental function DivideRealHyperDual ( v1 , v2 ) result ( v3 ) real ( pr ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: invV2 type ( hyperdual ) :: v3 invV2 = 1.0_pr * v2 ** ( - 1.0_pr ) v3 = v1 * invV2 end function DivideRealHyperDual !------------------------------------------------------------------- !--- Functions for the power operator. ----------------------------- !------------------------------------------------------------------- !> # PowerHyperDualInt !> Raise a hyperdual value to a power. !> !> # Description !> Applies the power rule to the primal and derivative coefficients. !> !> # Examples !> ```fortran !> z = x ** 2 !> ``` elemental function PowerHyperDualInt ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. integer , intent ( in ) :: v2 !! Second input operand. integer :: i !! Loop/index variable. integer :: vv2 type ( hyperdual ) :: v3 v3 = 1.0_pr vv2 = abs ( v2 ) do i = 1 , vv2 v3 = v3 * v1 enddo if ( v2 < 0 ) v3 = 1.0_pr / v3 end function PowerHyperDualInt !> # PowerHyperDualHyperDual !> Raise a hyperdual value to a power. !> !> # Description !> Applies the power rule to the primal and derivative coefficients. !> !> # Examples !> ```fortran !> z = x ** y !> ``` elemental function PowerHyperDualHyperDual ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. type ( hyperdual ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 type ( hyperdual ) :: v4 v4 = logHyperDual ( v1 ) v3 = expHyperDual ( v2 * v4 ) end function PowerHyperDualHyperDual !> # PowerHyperDualReal !> Raise a hyperdual value to a power. !> !> # Description !> Applies the power rule to the primal and derivative coefficients. !> !> # Examples !> ```fortran !> z = x ** 2.5_pr !> ``` elemental function PowerHyperDualReal ( v1 , v2 ) result ( v3 ) type ( hyperdual ), intent ( in ) :: v1 !! First input operand. real ( pr ), intent ( in ) :: v2 !! Second input operand. type ( hyperdual ) :: v3 real ( pr ), parameter :: tol = 1.0e-15_pr !! Numerical convergence tolerance. real ( pr ) :: xval real ( pr ) :: deriv xval = v1 % f0 if ( abs ( xval ) < tol ) then if ( xval >= 0.0_pr ) then xval = tol else xval = - tol endif endif deriv = v2 * ( xval ** ( v2 - 1.0_pr )) v3 % f0 = ( v1 % f0 ) ** v2 v3 % f1 = v1 % f1 * deriv v3 % f2 = v1 % f2 * deriv v3 % f12 = v1 % f12 * deriv & & + v2 * ( v2 - 1.0_pr ) * v1 % f1 * v1 % f2 * xval ** ( v2 - 2.0_pr ) end function PowerHyperDualReal !------------------------------------------------------------------- !--- Sum ----------------------------------------------------------- !------------------------------------------------------------------- !> # SumHyperDual !> Sum hyperdual array elements. !> !> # Description !> Reduces the hyperdual coefficients using the requested mask or dimension. !> !> # Examples !> ```fortran !> total = sum(values) !> ``` pure type ( hyperdual ) function SumHyperDual ( v1 , mask ) type ( hyperdual ), intent ( in ) :: v1 (:) !! First input operand. logical , intent ( in ), optional :: mask (:) !! Optional logical mask for the reduction. integer :: i !! Loop/index variable. SumHyperDual = hyperdual ( 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ) if ( present ( mask )) then do i = 1 , size ( v1 ) if ( mask ( i )) SumHyperDual = SumHyperDual + v1 ( i ) end do else do i = 1 , size ( v1 ) SumHyperDual = SumHyperDual + v1 ( i ) end do end if end function SumHyperDual !> # SumHyperDual2 !> Sum hyperdual array elements. !> !> # Description !> Reduces the hyperdual coefficients using the requested mask or dimension. !> !> # Examples !> ```fortran !> total = sum(values) !> ``` pure function SumHyperDual2 ( v1 , dim ) type ( hyperdual ), intent ( in ) :: v1 (:,:) !! First input operand. integer , intent ( in ) :: dim !! Array dimension along which to reduce. type ( hyperdual ), allocatable :: SumHyperDual2 (:) integer :: i !! Loop/index variable. allocate ( SumHyperDual2 ( size ( v1 ) / size ( v1 , dim ))) SumHyperDual2 = hyperdual ( 0.0_pr , 0.0_pr , 0.0_pr , 0.0_pr ) do i = 1 , size ( v1 , dim ) if ( dim == 1 ) then SumHyperDual2 = SumHyperDual2 + v1 ( i ,:) else SumHyperDual2 = SumHyperDual2 + v1 (:, i ) end if end do end function SumHyperDual2 !------------------------------------------------------------------- !--- Functions for the equal operator. ----------------------------- !------------------------------------------------------------------- !> # eq_dd !> Compare operands using equality. !> !> # Description !> Returns a logical result based on primal values; derivative slots do not affect comparisons. !> !> # Examples !> ```fortran !> logical_value = x < y !> ``` logical function eq_dd ( lhs , rhs ) type ( hyperdual ), intent ( in ) :: lhs !! Left-hand operand. type ( hyperdual ), intent ( in ) :: rhs !! Right-hand operand. eq_dd = lhs % f0 == rhs % f0 end function eq_dd !> # eq_dr !> Compare operands using equality. !> !> # Description !> Returns a logical result based on primal values; derivative slots do not affect comparisons. !> !> # Examples !> ```fortran !> logical_value = x < y !> ``` elemental logical function eq_dr ( lhs , rhs ) type ( hyperdual ), intent ( in ) :: lhs !! First input operand. real ( pr ), intent ( in ) :: rhs !! Second input operand. eq_dr = lhs % f0 == rhs end function eq_dr !> # e