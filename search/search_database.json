This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module yaeos__models_ar_cubic_quadratic_mixing !! # Quadratic cubic-EOS mixing rules !! Binary quadratic mixing rules for the attractive and repulsive parameters. !! !! # Description !! Exports `QMR` with constant binary interactions and `QMRTD` with !! temperature-dependent attractive interactions. `QMR` uses the classic !! pair combining rules and can be configured with component-pair matrices. !! !! # Examples !! ```fortran !! rule = QMR(k=kij, l=lij) !! call model%set_mixrule(rule) !! ``` use yaeos__constants , only : pr , solving_volume use yaeos__substance , only : substances use yaeos__models_ar_genericcubic , only : CubicMixRule use yaeos__models_ar_cubic_mixing_base , only : bmix_qmr implicit none type , extends ( CubicMixRule ) :: QMR !! # QMR !! Classic quadratic (van der Waals one-fluid) mixing rule. !! !! # Description !! QMR depends on binary interaction parameters, on a Cubic EoS !! the mixture is obtained by the combination of an attractive and !! repulsive parameter matrices. !! !! By default the attractive parameter matrix is calculated with: !! a_{ij} = \\sqrt{a_i a_j}(1 - k_{ij}) !! generating the a_{ij} matrix, but this procedure can be overridden !! in an extended type by rebinding the `aij` type-bound procedure. !! !! # Examples !! ```fortran !! rule = QMR(k=kij, l=lij) !! call model%set_mixrule(rule) !! ``` real ( pr ), allocatable :: k (:, :) !! Attractive Binary Interaction parameter matrix real ( pr ), allocatable :: l (:, :) !! Repulsive Binary Interaction parameter matrix contains procedure :: aij => kij_constant !! Default attractive parameter combining rule procedure :: Dmix !! Attractive parameter mixing rule procedure :: Bmix !! Repulsive parameter mixing rule procedure :: D1mix => RKPR_D1mix end type QMR type , extends ( QMR ) :: QMRTD !! # QMRTD !! Quadratic mixing rule with temperature-dependent binary interactions. !! !! # Description !! Extends QMR by evaluating its attractive binary interaction parameter !! as k_{ij}(T) = k_{ij} + k&#94;0_{ij}\\exp(-T/T&#94;{ref}_{ij}), where the !! inherited `k` is the high-temperature limit. !! !! # Examples !! ```fortran !! rule = QMRTD(k=k_inf, k0=k0, Tref=Tref, l=l) !! ``` real ( pr ), allocatable :: k0 (:, :) !! Temperature-dependent interaction amplitudes. real ( pr ), allocatable :: Tref (:, :) !! Pair-specific reference temperatures [K]. contains procedure :: aij => kij_exp_tdep end type QMRTD abstract interface subroutine get_aij ( self , T , ai , daidt , daidt2 , aij , daijdt , daijdt2 ) !! Combining rule for the attractive parameter. !! !! From previously calculated attractive parameters calculate the !! a_{ij} matrix and its corresponding derivatives. import pr , QMR class ( QMR ), intent ( in ) :: self !! Mixing rule object. real ( pr ), intent ( in ) :: T !! Temperature [K] real ( pr ), intent ( in ) :: ai (:) !! Pure-component attractive parameters a_i real ( pr ), intent ( in ) :: daidt (:) !! da_i/dT real ( pr ), intent ( in ) :: daidt2 (:) !! d&#94;2a_i/dT&#94;2 real ( pr ), intent ( out ) :: aij (:, :) !! a_{ij} matrix real ( pr ), intent ( out ) :: daijdt (:, :) !! da_{ij}/dT real ( pr ), intent ( out ) :: daijdt2 (:, :) !! d&#94;2a_{ij}/dT&#94;2 end subroutine get_aij end interface contains subroutine Dmix ( self , n , V , T , & ai , daidt , daidt2 , & D , & dDdV , dDdT , dDdV2 , dDdT2 , dDi , dDdTV , dDidV , dDidT , dDij & ) !! # Dmix !! !! # Description !! Attractive parameter mixing rule with quadratic mix. !! !! Takes the all the pure components attractive parameters and their !! derivatives with respect to temperature and mix them with the !! Van der Waals quadratic mixing rule: !! !!  !!   D = \\sum_i \\sum_j n_i n_j a_{ij} = n&#94;2 a_{mix} !!  !! !! Inside the routine the a_{ij} matrix is calculated using the !! procedure contained in the `QMR` object, this procedures defaults !! to the common combining rule: a_{ij} = \\sqrt{a_i a_j} (1 - k_{ij})  !! !! The combining rule can be replaced by extending `QMR` and rebinding !! `aij` to a procedure that respects the interface [[get_aij(interface)]]: !! !! ```fortran !! type, extends(QMR) :: MyQMR !! contains !!    procedure :: aij => my_aij !! end type MyQMR !! ``` !! !! This rule is volume independent; the volume-derivative outputs are not !! assigned here (`GenericCubic_Ar` zeroes them beforehand). class ( QMR ), intent ( in ) :: self !! Mixing rule object. real ( pr ), intent ( in ) :: V !! Volume [L] (unused) real ( pr ), intent ( in ) :: T !! Temperature [K] real ( pr ), intent ( in ) :: n (:) !! Moles vector [mol] real ( pr ), intent ( in ) :: ai (:) !! Pure components attractive parameters a_i real ( pr ), intent ( in ) :: daidt (:) !! \\frac{da_i}{dT} real ( pr ), intent ( in ) :: daidt2 (:) !! \\frac{d&#94;2a_i}{dT&#94;2} real ( pr ), intent ( out ) :: D !! Mixture attractive parameter n&#94;2a_{mix} real ( pr ), intent ( out ) :: dDdV !! \\frac{dD}{dV} (not assigned) real ( pr ), intent ( out ) :: dDdT !! \\frac{dD}{dT} real ( pr ), intent ( out ) :: dDdT2 !! \\frac{d&#94;2D}{dT&#94;2} real ( pr ), intent ( out ) :: dDdV2 !! \\frac{d&#94;2D}{dV&#94;2} real ( pr ), intent ( out ) :: dDdTV !! \\frac{d&#94;2D}{dTV} real ( pr ), intent ( out ) :: dDi (:) !! \\frac{dD}{dn_i} real ( pr ), intent ( out ) :: dDidV (:) !! \\frac{d&#94;2D}{dVn_i} real ( pr ), intent ( out ) :: dDidT (:) !! \\frac{d&#94;2D}{dTn_i} real ( pr ), intent ( out ) :: dDij (:, :) !! \\frac{d&#94;2D}{dn_{ij}} integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. integer :: nc !! Number of components. real ( pr ) :: aux !! Intermediate accumulator. real ( pr ) :: aux2 !! Second intermediate accumulator. real ( pr ) :: aij ( size ( ai ), size ( ai )) real ( pr ) :: daijdt ( size ( ai ), size ( ai )) real ( pr ) :: daijdt2 ( size ( ai ), size ( ai )) nc = size ( ai ) call self % aij ( T , ai , daidt , daidt2 , aij , daijdt , daijdt2 ) D = 0 dDdT = 0 dDdT2 = 0 if ( solving_volume ) then D = dot_product ( n , matmul ( n , aij )) else do i = 1 , nc aux = 0 aux2 = 0 dDi ( i ) = 0 dDidT ( i ) = 0 do j = 1 , nc dDi ( i ) = dDi ( i ) + 2 * n ( j ) * aij ( i , j ) dDidT ( i ) = dDidT ( i ) + 2 * n ( j ) * daijdT ( i , j ) aux2 = aux2 + n ( j ) * daijdT2 ( i , j ) dDij ( i , j ) = 2 * aij ( i , j ) aux = aux + n ( j ) * aij ( i , j ) end do D = D + n ( i ) * aux dDdT = dDdT + n ( i ) * dDidT ( i ) * 0.5_pr dDdT2 = dDdT2 + n ( i ) * aux2 end do end if end subroutine Dmix subroutine Bmix ( self , n , bi , B , dBi , dBij ) !! # Bmix !! !! # Description !! Mixture repulsive parameter. !! !! Calculate the mixture's repulsive parameter and it's derivatives !! with respect to composition: !! !!  !!    n_T B = \\sum_i \\sum_j n_i n_j \\frac{b_i + b_j}{2} (1 - l_{ij}) !!  !! class ( QMR ), intent ( in ) :: self !! Mixing rule object. real ( pr ), intent ( in ) :: n (:) !! Moles vector. real ( pr ), intent ( in ) :: bi (:) !! Pure-component covolumes [L/mol] real ( pr ), intent ( out ) :: B !! Mixture covolume B [L] real ( pr ), intent ( out ) :: dBi (:) !! \\frac{dB}{dn_i} real ( pr ), intent ( out ) :: dBij (:, :) !! \\frac{d&#94;2B}{dn_{ij}} call bmix_qmr ( n , bi , self % l , b , dbi , dbij ) end subroutine Bmix subroutine RKPR_D1mix ( self , n , d1i , D1 , dD1i , dD1ij ) !! # RKPR_D1mix !! !! # Description !! RKPR \\delta_1 parameter mixing rule. !! !! The RKPR EoS doesn't have a constant \\delta_1 value for each !! component, so a proper mixing rule should be provided. A linear !! combination is used. !! !!  !!     \\Delta_1 = \\frac{\\sum_i&#94;N n_i \\delta_{1i}}{\\sum_i&#94;N n_i} !!  !! use yaeos__models_ar_cubic_mixing_base , only : d1mix_rkpr class ( QMR ), intent ( in ) :: self !! Mixing rule object. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol] real ( pr ), intent ( in ) :: d1i (:) !! Pure-component \\delta_{1i} values real ( pr ), intent ( out ) :: D1 !! Mixture \\Delta_1 real ( pr ), intent ( out ) :: dD1i (:) !! \\partial \\Delta_1/\\partial n_i real ( pr ), intent ( out ) :: dD1ij (:, :) !! \\partial&#94;2 \\Delta_1/\\partial n_i \\partial n_j call d1mix_rkpr ( n , d1i , d1 , dd1i , dd1ij ) end subroutine RKPR_D1mix subroutine kij_constant (& self , T , a , dadt , dadt2 , & aij , daijdt , daijdt2 & ) !! # kij_constant !! !! # Description !! Combining rule that uses constant k_{ij} values. !! !!  !!  a_{ij} = \\sqrt{a_i a_j} (1 - k_{ij}) !!  class ( QMR ), intent ( in ) :: self !! Mixing rule object. real ( pr ), intent ( in ) :: T !! Temperature [K] real ( pr ), intent ( in ) :: a (:) !! Pure components attractive parameters a_i real ( pr ), intent ( in ) :: dadt (:) !! \\frac{da_i}{dT} real ( pr ), intent ( in ) :: dadt2 (:) !! \\frac{d&#94;2a_i}{dT&#94;2} real ( pr ), intent ( out ) :: aij (:, :) !! a_{ij} Matrix real ( pr ), intent ( out ) :: daijdt (:, :) !! \\frac{da_{ij}}{dT} real ( pr ), intent ( out ) :: daijdt2 (:, :) !! \\frac{d&#94;2a_{ij}}{dT&#94;2} integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. real ( pr ) :: sqrt_aii_ajj real ( pr ) :: inner_sum do i = 1 , size ( a ) aij ( i , i ) = a ( i ) daijdt ( i , i ) = dadt ( i ) daijdt2 ( i , i ) = dadt2 ( i ) do j = i + 1 , size ( a ) sqrt_aii_ajj = sqrt ( a ( i ) * a ( j )) aij ( i , j ) = sqrt_aii_ajj * ( 1 - self % k ( i , j )) inner_sum = a ( i ) * dadt ( j ) + a ( j ) * dadt ( i ) daijdt ( i , j ) = 0.5_pr * aij ( i , j ) * ( inner_sum ) / ( a ( i ) * a ( j )) daijdt2 ( i , j ) = & ( 1 - self % k ( i , j )) * ( dadT ( j ) * dadT ( i ) / sqrt ( a ( i ) * a ( j )) & + sqrt ( a ( i ) / a ( j )) * ( dadT2 ( j ) - dadT ( j ) ** 2 / ( 2 * a ( j ))) & + sqrt ( a ( j ) / a ( i )) * ( dadT2 ( i ) - dadT ( i ) ** 2 / ( 2 * a ( i )))) / 2 aij ( j , i ) = aij ( i , j ) daijdt ( j , i ) = daijdt ( i , j ) daijdt2 ( j , i ) = daijdt2 ( i , j ) end do end do end subroutine kij_constant subroutine kij_exp_tdep (& self , T , a , dadt , dadt2 , & aij , daijdt , daijdt2 & ) !! # kij_exp_tdep !! !! Combining rule that uses temperature dependent k_{ij} values. !! With the following expression: !!  !! k_{ij}(T) = k_{ij}&#94;\\infty + k_{ij}&#94;0 \\exp\\left(\\frac{-T}{T&#94;*}\\right) !!   !! !!  !!  a_{ij} = \\sqrt{a_i a_j} (1 - k_{ij}) !!  use hyperdual_mod class ( QMRTD ), intent ( in ) :: self !! Mixing rule object. real ( pr ), intent ( in ) :: T !! Temperature [K] real ( pr ), intent ( in ) :: a (:) !! Pure components attractive parameters a_i real ( pr ), intent ( in ) :: dadt (:) !! \\frac{da_i}{dT} real ( pr ), intent ( in ) :: dadt2 (:) !! \\frac{d&#94;2a_i}{dT&#94;2} real ( pr ), intent ( out ) :: aij (:, :) !! a_{ij} Matrix real ( pr ), intent ( out ) :: daijdt (:, :) !! \\frac{da_{ij}}{dT} real ( pr ), intent ( out ) :: daijdt2 (:, :) !! \\frac{d&#94;2a_{ij}}{dT&#94;2} real ( pr ) :: k0 ( size ( a ), size ( a )) real ( pr ) :: kinf ( size ( a ), size ( a )) real ( pr ) :: Tstar ( size ( a ), size ( a )) type ( hyperdual ) :: aij_hd ( size ( a ), size ( a )) type ( hyperdual ) :: kij_hd ( size ( a ), size ( a )) type ( hyperdual ) :: T_hd type ( hyperdual ) :: a_hd ( size ( a )) integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. integer :: nc !! Number of components. T_hd = T T_hd % f1 = 1 T_hd % f2 = 1 k0 = self % k0 kinf = self % k Tstar = self % Tref kij_hd = kinf + k0 * exp ( - T_hd / Tstar ) a_hd = a ! Inject the already calculated derivatives a_hd % f1 = dadt a_hd % f2 = dadt a_hd % f12 = dadt2 nc = size ( a ) do i = 1 , size ( a ) aij_hd ( i , i ) = sqrt ( a_hd ( i ) * a_hd ( i )) do j = i + 1 , size ( a ) aij_hd ( i , j ) = sqrt ( a_hd ( i ) * a_hd ( j )) * ( 1._pr - kij_hd ( i , j )) aij_hd ( j , i ) = aij_hd ( i , j ) end do end do aij = aij_hd % f0 daijdt = aij_hd % f1 daijdt2 = aij_hd % f12 end subroutine kij_exp_tdep end module yaeos__models_ar_cubic_quadratic_mixing","tags":"","url":"sourcefile/quadratic_mixing.f90.html"},{"title":"tapenade_ar_api.f90 – yaeos","text":"This file depends on sourcefile~~tapenade_ar_api.f90~~EfferentGraph sourcefile~tapenade_ar_api.f90 tapenade_ar_api.f90 sourcefile~ar_models.f90 ar_models.f90 sourcefile~tapenade_ar_api.f90->sourcefile~ar_models.f90 sourcefile~constants.f90 constants.f90 sourcefile~tapenade_ar_api.f90->sourcefile~constants.f90 sourcefile~ar_models.f90->sourcefile~constants.f90 sourcefile~base.f90 base.f90 sourcefile~ar_models.f90->sourcefile~base.f90 sourcefile~math.f90 math.f90 sourcefile~ar_models.f90->sourcefile~math.f90 sourcefile~substance.f90 substance.f90 sourcefile~base.f90->sourcefile~substance.f90 sourcefile~math.f90->sourcefile~constants.f90 sourcefile~auxiliar.f90~2 auxiliar.f90 sourcefile~math.f90->sourcefile~auxiliar.f90~2 sourcefile~continuation.f90 continuation.f90 sourcefile~math.f90->sourcefile~continuation.f90 sourcefile~linalg.f90 linalg.f90 sourcefile~math.f90->sourcefile~linalg.f90 sourcefile~auxiliar.f90~2->sourcefile~constants.f90 sourcefile~continuation.f90->sourcefile~constants.f90 sourcefile~continuation.f90->sourcefile~auxiliar.f90~2 sourcefile~continuation.f90->sourcefile~linalg.f90 sourcefile~linalg.f90->sourcefile~constants.f90 sourcefile~linalg.f90->sourcefile~auxiliar.f90~2 sourcefile~substance.f90->sourcefile~constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~tapenade_ar_api.f90~~AfferentGraph sourcefile~tapenade_ar_api.f90 tapenade_ar_api.f90 sourcefile~pc_saft.f90 pc_saft.f90 sourcefile~pc_saft.f90->sourcefile~tapenade_ar_api.f90 sourcefile~models.f90 models.f90 sourcefile~models.f90->sourcefile~pc_saft.f90 sourcefile~fluids.f90 fluids.f90 sourcefile~fluids.f90->sourcefile~models.f90 sourcefile~yaeos.f90 yaeos.f90 sourcefile~yaeos.f90->sourcefile~models.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module yaeos__tapenade_ar_api !! # Tapenade residual Helmholtz API !! Abstract interface and adapter for source-to-source differentiated EOS models. !! !! # Description !! `ArModelTapenade` requires primal, forward, reverse, mixed, and second !! directional derivative routines. Its implementation of !! `residual_helmholtz` dispatches to those routines to populate requested !! derivative outputs. !! !! # Examples !! See `PCSAFT` in `src/models/residual_helmholtz/saft/pc_saft.f90` for a !! production implementation and `tools/tapenade_diff/` for the generator. !! !! # References !! Tapenade documentation: https://tapenade.gitlabpages.inria.fr/ use yaeos__constants , only : pr use yaeos__models_ar , only : ArModel implicit none private public :: ArModelTapenade type , abstract , extends ( ArModel ) :: ArModelTapenade !! # ArModelTapenade !! Base class for EOS models with Tapenade-generated derivatives. !! !! # Description !! Concrete extensions provide the primal `ar` routine and its !! forward/reverse derivative variants. The inherited adapter evaluates !! requested `ArModel` derivatives by dispatching to those routines. !! !! # Examples !! See the `PCSAFT` model for an integrated implementation. contains procedure ( tapenade_ar ), deferred :: ar procedure ( tapenade_ar_d ), deferred :: ar_d procedure ( tapenade_ar_b ), deferred :: ar_b procedure ( tapenade_ar_d_b ), deferred :: ar_d_b procedure ( tapenade_ar_d_d ), deferred :: ar_d_d procedure :: residual_helmholtz => residual_helmholtz end type ArModelTapenade abstract interface subroutine tapenade_ar ( model , n , v , t , arval ) !! # tapenade_ar !! Primal residual Helmholtz callback required by `ArModelTapenade`. import pr , ArModelTapenade class ( ArModelTapenade ), intent ( in ) :: model !! Model parameters. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol]. real ( pr ), intent ( in ) :: v !! Total volume [L]. real ( pr ), intent ( in ) :: t !! Temperature [K]. real ( pr ), intent ( out ) :: arval !! Residual Helmholtz energy. end subroutine tapenade_ar subroutine tapenade_ar_d ( model , n , nd , v , vd , t , td , arval , arvald ) !! # tapenade_ar_d !! Forward directional derivative callback for the residual Helmholtz energy. import pr , ArModelTapenade class ( ArModelTapenade ), intent ( in ) :: model !! Model parameters. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol]. real ( pr ), intent ( in ) :: v !! Total volume [L]. real ( pr ), intent ( in ) :: t !! Temperature [K]. real ( pr ), intent ( in ) :: nd (:) !! Tangent seed for component mole amounts (nd). real ( pr ), intent ( in ) :: vd !! Tangent seed for volume (vd). real ( pr ), intent ( in ) :: td !! Tangent seed for temperature (td). real ( pr ), intent ( out ) :: arval !! Primal residual Helmholtz energy. real ( pr ), intent ( out ) :: arvald !! Forward directional derivative of residual Helmholtz energy. end subroutine tapenade_ar_d subroutine tapenade_ar_b ( model , n , nb , v , vb , t , tb , arval , arvalb ) !! # tapenade_ar_b !! Reverse-mode adjoint callback for the residual Helmholtz energy. import pr , ArModelTapenade class ( ArModelTapenade ), intent ( in ) :: model !! Model parameters. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol]. real ( pr ), intent ( in ) :: v !! Total volume [L]. real ( pr ), intent ( in ) :: t !! Temperature [K]. real ( pr ) :: arvalb !! Incoming adjoint seed on the energy. real ( pr ) :: nb (:) !! Adjoint value for component mole amounts. real ( pr ) :: vb !! Adjoint value for volume. real ( pr ) :: tb !! Adjoint value for temperature. real ( pr ) :: arval !! Primal energy value. end subroutine tapenade_ar_b subroutine tapenade_ar_d_b ( model , & n , nb , nd , ndb , v , vb , vd , vdb , t , tb , td , tdb , & arval , arvalb , arvald , arvaldb ) !! # tapenade_ar_d_b !! Mixed forward/reverse callback used for Hessian and mixed derivatives. import pr , ArModelTapenade class ( ArModelTapenade ), intent ( in ) :: model !! Model parameters. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol]. real ( pr ), intent ( in ) :: v !! Total volume [L]. real ( pr ), intent ( in ) :: t !! Temperature [K]. real ( pr ) :: arval !! Primal energy value. real ( pr ), intent ( in ) :: nd (:) !! Forward tangent seed for the mole amounts. real ( pr ), intent ( in ) :: vd !! Forward tangent seed for the volume. real ( pr ), intent ( in ) :: td !! Forward tangent seed for the temperature. real ( pr ) :: arvald !! Forward directional energy derivative. real ( pr ) :: nb (:) !! Adjoint value for component mole amounts. real ( pr ) :: vb !! Adjoint value for volume. real ( pr ) :: tb !! Adjoint value for temperature. real ( pr ) :: arvalb !! Adjoint seed for the primal energy output. real ( pr ) :: ndb (:) !! Mixed tangent-adjoint value for component mole amounts. real ( pr ) :: vdb !! Mixed tangent-adjoint value for volume. real ( pr ) :: tdb !! Mixed tangent-adjoint value for temperature. real ( pr ) :: arvaldb !! Mixed tangent-adjoint energy output. end subroutine tapenade_ar_d_b subroutine tapenade_ar_d_d ( model , n , nd , v , vd0 , vd , t , td0 , td , & arval , arvald0 , arvald , arvaldd ) !! # tapenade_ar_d_d !! Nested forward-mode callback for second directional derivatives. import pr , ArModelTapenade class ( ArModelTapenade ), intent ( in ) :: model !! Model parameters. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol]. real ( pr ), intent ( in ) :: v !! Total volume [L]. real ( pr ), intent ( in ) :: t !! Temperature [K]. real ( pr ), intent ( in ) :: vd0 !! Tangent seed for volume (vd0). real ( pr ), intent ( in ) :: td0 !! Tangent seed for temperature (td0). real ( pr ), intent ( in ) :: nd (:) !! Tangent seed for component mole amounts (nd). real ( pr ), intent ( in ) :: vd !! Tangent seed for volume (vd). real ( pr ), intent ( in ) :: td !! Tangent seed for temperature (td). real ( pr ), intent ( out ) :: arval !! Primal residual Helmholtz energy. real ( pr ), intent ( out ) :: arvald0 !! First nested tangent of residual Helmholtz energy. real ( pr ), intent ( out ) :: arvald !! Forward directional derivative of residual Helmholtz energy. real ( pr ), intent ( out ) :: arvaldd !! Mixed second tangent of residual Helmholtz energy. end subroutine tapenade_ar_d_d end interface contains subroutine residual_helmholtz (& self , n , v , t , Ar , ArV , ArT , ArTV , ArV2 , ArT2 , Arn , ArVn , ArTn , Arn2 & ) !! Residual Helmholtz model generic interface class ( ArModelTapenade ), intent ( in ) :: self !! Model instance. real ( pr ), intent ( in ) :: n (:) !! Component mole amounts [mol]. real ( pr ), intent ( in ) :: v !! Total volume [L]. real ( pr ), intent ( in ) :: t !! Temperature [K]. real ( pr ), optional , intent ( out ) :: Ar !! Residual Helmholtz energy [bar L]. real ( pr ), optional , intent ( out ) :: ArV !! \\partial A&#94;r/\\partial V [bar]. real ( pr ), optional , intent ( out ) :: ArT !! \\partial A&#94;r/\\partial T [bar L/K]. real ( pr ), optional , intent ( out ) :: ArT2 !! \\partial&#94;2 A&#94;r/\\partial T&#94;2 [bar L/K&#94;2]. real ( pr ), optional , intent ( out ) :: ArTV !! \\partial&#94;2 A&#94;r/\\partial T\\partial V [bar/K]. real ( pr ), optional , intent ( out ) :: ArV2 !! \\partial&#94;2 A&#94;r/\\partial V&#94;2 [bar/L]. real ( pr ), optional , dimension ( size ( n )), intent ( out ) :: Arn !! \\partial A&#94;r/\\partial n_i [bar L/mol]. real ( pr ), optional , dimension ( size ( n )), intent ( out ) :: ArVn !! \\partial&#94;2 A&#94;r/\\partial V\\partial n_i [bar/mol]. real ( pr ), optional , dimension ( size ( n )), intent ( out ) :: ArTn !! \\partial&#94;2 A&#94;r/\\partial T\\partial n_i [bar L/(K mol)]. real ( pr ), optional , intent ( out ) :: Arn2 ( size ( n ), size ( n )) !! \\partial&#94;2 A&#94;r/\\partial n_i\\partial n_j [bar L/mol&#94;2]. real ( pr ) :: nb ( size ( n )) real ( pr ) :: nd ( size ( n )) real ( pr ) :: ndb ( size ( n )) real ( pr ) :: vb real ( pr ) :: vd real ( pr ) :: vdb real ( pr ) :: vd0 real ( pr ) :: tb real ( pr ) :: td real ( pr ) :: tdb real ( pr ) :: td0 real ( pr ) :: arval real ( pr ) :: arvalb real ( pr ) :: arvald real ( pr ) :: arvaldb real ( pr ) :: arvald0 real ( pr ) :: arvaldd integer :: i !! Loop/index variable. integer :: nc !! Number of components. logical :: need_Arn2 logical :: need_ArVn logical :: need_ArTn logical :: need_ArV2 logical :: need_ArT2 logical :: need_ArTV logical :: need_grad logical :: need_val nc = size ( n ) ! Initialize tracking flags based on requested arguments need_Arn2 = present ( Arn2 ) need_ArVn = present ( ArVn ) need_ArTn = present ( ArTn ) need_ArV2 = present ( ArV2 ) need_ArT2 = present ( ArT2 ) need_ArTV = present ( ArTV ) need_grad = present ( Arn ) . or . present ( ArV ) . or . present ( ArT ) need_val = present ( Ar ) ! 1. Hessian matrix w.r.t composition (Uses backward pass: does NOT yield primal Ar) if ( need_Arn2 ) then do i = 1 , nc call reset_vars arvaldb = 1 nd ( i ) = 1 call self % ar_d_b ( & n , nb , nd , ndb , & v , vb , vd , vdb , & t , tb , td , tdb , & arval , arvalb , arvald , arvaldb ) Arn2 ( i , :) = nb ! Extract free cross-derivatives if ( need_ArVn ) ArVn ( i ) = vb if ( need_ArTn ) ArTn ( i ) = tb ! Gradients are identical across all iterations of this loop if ( i == 1 ) then if ( present ( Arn )) Arn = ndb if ( present ( ArV )) ArV = vdb if ( present ( ArT )) ArT = tdb need_grad = . false . end if end do need_ArVn = . false . need_ArTn = . false . end if ! 2. Cross derivative w.r.t Volume and Composition (Uses backward pass) if ( need_ArVn ) then call reset_vars arvaldb = 1 vd = 1 call self % ar_d_b ( & n , nb , nd , ndb , & v , vb , vd , vdb , & t , tb , td , tdb , & arval , arvalb , arvald , arvaldb ) ArVn = nb ! Free byproducts from vd=1 sweep if ( need_ArV2 ) then ArV2 = vb need_ArV2 = . false . end if if ( need_ArTV ) then ArTV = tb need_ArTV = . false . end if if ( need_grad ) then if ( present ( Arn )) Arn = ndb if ( present ( ArV )) ArV = vdb if ( present ( ArT )) ArT = tdb need_grad = . false . end if end if ! 3. Cross derivative w.r.t Temperature and Composition (Uses backward pass) if ( need_ArTn ) then call reset_vars arvaldb = 1 td = 1 call self % ar_d_b ( & n , nb , nd , ndb , & v , vb , vd , vdb , & t , tb , td , tdb , & arval , arvalb , arvald , arvaldb ) ArTn = nb ! Free byproducts from td=1 sweep if ( need_ArT2 ) then ArT2 = tb need_ArT2 = . false . end if if ( need_ArTV ) then ArTV = vb ! vb is d2Ar/(dt*dv) need_ArTV = . false . end if if ( need_grad ) then if ( present ( Arn )) Arn = ndb if ( present ( ArV )) ArV = vdb if ( present ( ArT )) ArT = tdb need_grad = . false . end if end if ! 4. Pure Gradients (Uses backward pass: does NOT yield primal Ar) if ( need_grad ) then call reset_vars arvalb = 1 call self % ar_b ( n , nb , v , vb , t , tb , arval , arvalb ) if ( present ( Arn )) Arn = nb if ( present ( ArV )) ArV = vb if ( present ( ArT )) ArT = tb end if ! 5. Scalar 2nd derivatives (Uses forward sweep: DOES yield primal Ar) if ( need_ArV2 ) then call reset_vars vd = 1 ; vd0 = 1 call self % ar_d_d ( n , nd , v , vd0 , vd , t , td0 , td , arval , arvald0 , arvald , arvaldd ) ArV2 = arvaldd end if if ( need_ArT2 ) then call reset_vars td = 1 ; td0 = 1 call self % ar_d_d ( n , nd , v , vd0 , vd , t , td0 , td , arval , arvald0 , arvald , arvaldd ) ArT2 = arvaldd end if if ( need_ArTV ) then call reset_vars vd = 1 ; td0 = 1 call self % ar_d_d ( n , nd , v , vd0 , vd , t , td0 , td , arval , arvald0 , arvald , arvaldd ) ArTV = arvaldd end if ! 6. Pure Evaluation (Triggered if Ar is needed and NO forward sweep caught it) if ( need_val ) then call reset_vars call self % ar ( n , v , 