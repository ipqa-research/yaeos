ly: NRTL, setup_unifac, Groups !! ``` use yaeos__models_ge_NRTL , only : NRTL use yaeos__models_ge_nrtlhv , only : NRTLHV use yaeos__models_ge_group_contribution_dortmund , only : setup_dortmund use yaeos__models_ge_group_contribution_unifac , only : & Groups , setup_unifac , UNIFAC , excess_gibbs use yaeos__models_ge_uniquac , only : setup_uniquac , UNIQUAC use yaeos__models_ge_group_contribution_psrk , only : setup_psrk implicit none end module yaeos__models_ge_implementations","tags":"","url":"sourcefile/implementations.f90.html"},{"title":"parameters_gerg2008.f90 – yaeos","text":"This file depends on sourcefile~~parameters_gerg2008.f90~~EfferentGraph sourcefile~parameters_gerg2008.f90 parameters_gerg2008.f90 sourcefile~base.f90 base.f90 sourcefile~parameters_gerg2008.f90->sourcefile~base.f90 sourcefile~constants.f90 constants.f90 sourcefile~parameters_gerg2008.f90->sourcefile~constants.f90 sourcefile~substance.f90 substance.f90 sourcefile~base.f90->sourcefile~substance.f90 sourcefile~substance.f90->sourcefile~constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~parameters_gerg2008.f90~~AfferentGraph sourcefile~parameters_gerg2008.f90 parameters_gerg2008.f90 sourcefile~gerg2008.f90 gerg2008.f90 sourcefile~gerg2008.f90->sourcefile~parameters_gerg2008.f90 sourcefile~models.f90 models.f90 sourcefile~models.f90->sourcefile~gerg2008.f90 sourcefile~fluids.f90 fluids.f90 sourcefile~fluids.f90->sourcefile~models.f90 sourcefile~yaeos.f90 yaeos.f90 sourcefile~yaeos.f90->sourcefile~models.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module yaeos__models_ar_multifluid_parameters_gerg2008 !! # GERG2008 parameters !! !! # Description !! Pure-fluid and binary parameters of the GERG2008 equation of state, !! together with [[get_original_parameters]], which loads them for a list !! of component identifiers. !! The loader returns pure-fluid coefficient arrays, pairwise departure !! parameters, and component critical constants in the requested ordering. !! !! # Examples !! ```fortran !! call get_original_parameters(ids, pures, binaries, components) !! ``` use yaeos__constants , only : pr use yaeos__models_base , only : Substances implicit none integer :: max_residual_terms = 24 !! Maximum number of pure-fluid residual terms. integer :: generalized_departure ( 8 , 2 ) !! Index map for generalized binary departure terms. integer , parameter :: N = 21 !! Number of fluids in the GERG2008 component set. real ( 8 ), dimension ( 21 , 21 , 4 ) :: red_params !! Pair reducing parameters (\\beta_v, \\gamma_v, \\beta_T, \\gamma_T), set for i \\lt j. real ( 8 ), dimension ( 21 , 21 ) :: Bv = 0 !! Volume reducing parameters \\beta_{v,ij} (\\beta_{v,ji}=1/\\beta_{v,ij}). real ( 8 ), dimension ( 21 , 21 ) :: Gv = 0 !! Volume reducing parameters \\gamma_{v,ij} (symmetric). real ( 8 ), dimension ( 21 , 21 ) :: Bt = 0 !! Temperature reducing parameters \\beta_{T,ij} (\\beta_{T,ji}=1/\\beta_{T,ij}). real ( 8 ), dimension ( 21 , 21 ) :: Gt = 0 !! Temperature reducing parameters \\gamma_{T,ij} (symmetric). real ( 8 ), dimension ( 21 , 24 ) :: noik = 0 !! Pure-fluid residual Helmholtz coefficients. real ( 8 ), dimension ( 21 , 24 ) :: toik = 0 !! Pure-fluid inverse-temperature exponents. integer , dimension ( 21 , 24 ) :: doik = 0 !! Pure-fluid reduced-density exponents. integer , dimension ( 21 , 24 ) :: coik = 0 !! Pure-fluid exponential density-damping powers. integer , dimension ( 21 ) :: Kpol = 0 !! Number of polynomial pure-fluid residual terms. integer , dimension ( 21 ) :: Kexp = 0 !! Number of exponential pure-fluid residual terms. real ( 8 ), dimension ( 21 , 21 ) :: Fij = 0 !! Binary departure-function scaling factors. real ( 8 ), dimension ( 21 , 21 , 12 ) :: tij = 0 !! Inverse-temperature exponents of binary departure terms. real ( 8 ), dimension ( 21 , 21 , 12 ) :: nij = 0 !! Binary departure coefficients. real ( 8 ), dimension ( 21 , 21 , 12 ) :: ethaij = 0 !! Quadratic density-damping coefficients of binary departure terms. real ( 8 ), dimension ( 21 , 21 , 12 ) :: epsij = 0 !! Density offsets in the quadratic binary damping factors. real ( 8 ), dimension ( 21 , 21 , 12 ) :: betaij = 0 !! Linear density-damping coefficients of binary departure terms. real ( 8 ), dimension ( 21 , 21 , 12 ) :: gammaij = 0 !! Density offsets in the linear binary damping factors. integer , dimension ( 21 , 21 , 12 ) :: dij = 0 !! Reduced-density exponents of binary departure terms. integer , dimension ( 21 , 21 ) :: Kpolij = 0 !! Number of polynomial binary departure terms. integer , dimension ( 21 , 21 ) :: Kexpij = 0 !! Number of exponential binary departure terms. real ( 8 ), dimension ( 21 ) :: T_c = 0 !! Pure-fluid critical temperatures [K]. real ( 8 ), dimension ( 21 ) :: rho_c = 0 !! Pure-fluid critical densities [mol/L]. real ( 8 ), dimension ( 21 ) :: M = 0 !! Pure-fluid molar masses [g/mol]. real ( 8 ), dimension ( 21 ) :: P_c = 0 !! Pure-fluid critical pressures [Pa]. real ( 8 ), dimension ( 21 ) :: acentric_factor = 0 !! Pure-fluid acentric factors. integer :: tmp1 ( 3 ) = 0 !! Fluid indices that share a repeated pure-fluid term set. integer :: tmp2 ( 14 ) = 0 !! Fluid indices that share a repeated pure-fluid term set. real ( 8 ), dimension ( 21 , 7 ) :: n0i = 0 !! Ideal-gas Helmholtz coefficients. real ( 8 ), dimension ( 21 , 7 ) :: th0i = 0 !! Ideal-gas Helmholtz temperature parameters. real ( 8 ) :: R = 0 !! Gas constant of the original GERG2008 tables [J/(mol K)]. real ( 8 ) :: eps = 1 d - 10 !! Numerical tolerance. type :: Gerg2008Pure !! # Gerg2008Pure !! Coefficient arrays for one GERG2008 pure-fluid Helmholtz function. !! !! # Description !! Stores the polynomial and exponential term counts and coefficients !! needed to evaluate the pure-fluid residual contribution. !! !! # Examples !! Filled by `get_original_parameters`; normally accessed through `Gerg2008`. integer :: Kpol !! Number of polynomial terms integer :: Kexp !! Number of exponential terms real ( 8 ), allocatable :: n (:) !! Term coefficients (polynomial terms first, then exponential terms) real ( 8 ), allocatable :: d (:) !! Density exponents real ( 8 ), allocatable :: t (:) !! Temperature exponents real ( 8 ), allocatable :: c (:) !! Density exponents c of the exponential damping factor \\exp(-\\delta&#94;{c}) end type Gerg2008Pure type :: Gerg2008Binary !! # Gerg2008Binary !! Reducing and departure parameters for one GERG2008 component pair. !! !! # Description !! Stores binary reducing factors and polynomial/exponential departure !! coefficients for the ordered component pair `(i,j)`. !! !! # Examples !! Filled by `get_original_parameters` and consumed by `Gerg2008`. integer :: i !! Component i integer :: j !! Component j real ( 8 ) :: Bv !! Volume reducing parameter \\beta_{v,ij}. real ( 8 ) :: Gv !! Volume reducing parameter \\gamma_{v,ij}. real ( 8 ) :: Bt !! Temperature reducing parameter \\beta_{T,ij}. real ( 8 ) :: Gt !! Temperature reducing parameter \\gamma_{T,ij}. integer :: Kpolij !! Number of polynomial terms in the binary departure function. integer :: Kexpij !! Number of exponential terms in the binary departure function. real ( 8 ), allocatable :: nij (:) !! Departure-term coefficients (polynomial terms first, then exponential terms). real ( 8 ), allocatable :: dij (:) !! Density exponents for binary departure terms. real ( 8 ), allocatable :: tij (:) !! Temperature exponents for binary departure terms. real ( 8 ), allocatable :: ethaij (:) !! Coefficients \\eta of the quadratic damping term -\\eta(\\delta-\\varepsilon)&#94;2. real ( 8 ), allocatable :: epsij (:) !! Density offsets \\varepsilon of the quadratic damping term. real ( 8 ), allocatable :: betaij (:) !! Coefficients \\beta of the linear damping term -\\beta(\\delta-\\gamma). real ( 8 ), allocatable :: gammaij (:) !! Density offsets \\gamma of the linear damping term. real ( 8 ) :: Fij !! Weighting factor F_{ij} of the binary departure function (zero when the pair has none). end type Gerg2008Binary contains subroutine get_original_parameters ( ids , pures , binaries , components ) !! # get_original_parameters !! !! # Description !! Load the original GERG2008 parameters for the selected components. !! !! Returns the pure-fluid parameters, the binary interaction !! parameters, and a [[Substances]] object with the critical constants !! of the selected components (T_c [K], P_c [bar], V_c [L/mol], !! acentric factor). integer , intent ( in ) :: ids (:) !! GERG2008 component identifiers type ( Gerg2008Pure ), intent ( out ) :: pures (:) !! Pure-fluid parameters type ( Gerg2008Binary ), intent ( out ) :: binaries (:, :) !! Binary parameters type ( Substances ), intent ( out ) :: components !! Component properties integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. integer :: nc !! Number of components. integer :: ikpol integer :: ikexp real ( pr ) :: Tc ( size ( ids )) real ( pr ) :: Pc ( size ( ids )) real ( pr ) :: w ( size ( ids )) !! Acentric factors. real ( pr ) :: Vc ( size ( ids )) nc = size ( ids ) call original_parameters () Tc = [( T_c ( ids ( i )), i = 1 , nc )] Pc = [( P_c ( ids ( i )), i = 1 , nc )] / 1e5 w = [( acentric_factor ( ids ( i )), i = 1 , nc )] Vc = [( 1 / rho_c ( ids ( i )), i = 1 , nc )] components = Substances ( Tc = Tc , Pc = Pc , w = w , Vc = Vc ) do i = 1 , nc pures ( i )% kpol = kpol ( ids ( i )) pures ( i )% kexp = kexp ( ids ( i )) pures ( i )% n = noik ( ids ( i ), :) pures ( i )% d = doik ( ids ( i ), :) pures ( i )% t = toik ( ids ( i ), :) pures ( i )% c = coik ( ids ( i ), kpol ( ids ( i )) + 1 : kexp ( ids ( i )) + kpol ( ids ( i ))) end do do i = 1 , nc do j = 1 , nc binaries ( i , j )% Bt = Bt ( ids ( i ), ids ( j )) binaries ( i , j )% Gt = Gt ( ids ( i ), ids ( j )) binaries ( i , j )% Bv = Bv ( ids ( i ), ids ( j )) binaries ( i , j )% Gv = Gv ( ids ( i ), ids ( j )) ikpol = Kpolij ( ids ( i ), ids ( j )) ikexp = Kexpij ( ids ( i ), ids ( j )) binaries ( i , j )% Kpolij = Kpolij ( ids ( i ), ids ( j )) binaries ( i , j )% Kexpij = Kexpij ( ids ( i ), ids ( j )) binaries ( i , j )% nij = nij ( ids ( i ), ids ( j ), : ikexp + ikpol ) binaries ( i , j )% dij = dij ( ids ( i ), ids ( j ), : ikexp + ikpol ) binaries ( i , j )% tij = tij ( ids ( i ), ids ( j ), : ikexp + ikpol ) binaries ( i , j )% ethaij = ethaij ( ids ( i ), ids ( j ), ikpol + 1 : ikexp + ikpol ) binaries ( i , j )% epsij = epsij ( ids ( i ), ids ( j ), ikpol + 1 : ikexp + ikpol ) binaries ( i , j )% betaij = betaij ( ids ( i ), ids ( j ), ikpol + 1 : ikexp + ikpol ) binaries ( i , j )% gammaij = gammaij ( ids ( i ), ids ( j ), ikpol + 1 : ikexp + ikpol ) binaries ( i , j )% Fij = Fij ( ids ( i ), ids ( j )) end do end do end subroutine get_original_parameters subroutine original_parameters () !! # original_parameters !! !! # Description !! Parameter table of the original GERG 2008 model integer :: i !! Loop index `i`. integer :: j !! Loop index `j`. integer :: k !! Loop index `k`. R = 8.314472d0 P_c ( 1 ) = 4 6.0_pr * 1e5_pr P_c ( 2 ) = 3 3.9_pr * 1e5_pr P_c ( 3 ) = 7 3.8_pr * 1e5_pr P_c ( 4 ) = 4 8.8_pr * 1e5_pr P_c ( 5 ) = 4 2.5_pr * 1e5_pr P_c ( 6 ) = 3 8.0_pr * 1e5_pr P_c ( 7 ) = 3 6.5_pr * 1e5_pr P_c ( 8 ) = 3 3.7_pr * 1e5_pr P_c ( 9 ) = 3 3.9_pr * 1e5_pr P_c ( 10 ) = 3 0.1_pr * 1e5_pr P_c ( 11 ) = 2 7.4_pr * 1e5_pr P_c ( 12 ) = 2 4.9_pr * 1e5_pr P_c ( 13 ) = 228100 0.0d0 P_c ( 14 ) = 210300 0.0d0 P_c ( 15 ) = 129640 0.0d0 P_c ( 16 ) = 504300 0.0d0 P_c ( 17 ) = 349400 0.0d0 P_c ( 18 ) = 220